      "solution": "<!doctype html>\n<html lang=\"ko\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<!-- tailwind -->\n</head>\n<body>\n<h1>글 목록</h1>\n<!-- 도구 사이 간격은 부모에 정해요. -->\n<div id=\"tools\" class=\"flex flex-row gap-4\"><button>추가</button><button>검색</button></div>\n</body>\n</html>\n",
