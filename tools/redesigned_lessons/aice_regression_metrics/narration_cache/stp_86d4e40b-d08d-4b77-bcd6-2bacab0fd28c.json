  "entry": [
    {
      "action": "say",
      "text": "실제 시간은 분 단위예요. report 줄을 고쳐 MSE에 제곱근을 씌워야 해요.",
      "target": "text:report 줄을 고쳐 MSE에 제곱근을 씌워 실제 시간과 같은 분 단위로 보고하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "4.0이에요. 2분 오차를 제곱한 분제곱 단위예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "report = mean_squared_error(y_true, y_pred)\n",
      "after": "report = mean_squared_error(y_true, y_pred) ** 0.5\n",
      "say": "뒤에 ** 0.5를 붙여요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "2.0이에요. 다시 분 단위인 RMSE예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. MSE 4를 4분 오차라고 보고하지 않아요. 단위가 분제곱이에요.",
      "target": "code:** 0.5"
    }
  ]
}
