  "entry": [
    {
      "action": "say",
      "text": "재고와 묶음 크기가 딱 같으면 포장할 수 있어야 해요. 같을 때를 빼는 비교 한 곳을 고치는 문제예요.",
      "target": "text:딱 세 개인데도 포장 수가 영으로 나와요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "재고와 묶음 크기가 같은데 영이 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock > group",
      "after": "stock >= group",
      "say": "같을 때도 포장하도록 이상으로 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "이제 딱 한 묶음을 포장해요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 정답을 1로 고정하면 다른 재고에서 틀려요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 3",
      "after": "stock = 6",
      "say": "여섯 개일 때도 같은 식으로 확인해요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "재고가 늘자 두 묶음으로 계산됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 6",
      "after": "stock = 3",
      "say": "처음의 경계값으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "비교만 바꿔도 경계가 규칙에 맞아요.",
      "target": "output"
    }
  ]
}
