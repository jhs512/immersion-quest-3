    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "딱 두 묶음을 완성했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "양의 정수끼리 나눠서 소수점 아래를 버린 몫 2가 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
