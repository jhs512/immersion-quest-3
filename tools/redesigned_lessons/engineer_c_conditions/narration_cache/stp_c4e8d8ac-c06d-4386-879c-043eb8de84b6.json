  "entry": [
    {
      "action": "say",
      "text": "정수끼리 나누면 소수 부분을 버린 몫만 남아요. 일곱 개를 세 개씩 묶을 때 완성되는 묶음 수를 고르는 문제예요.",
      "target": "text:세 개씩 묶은 완성품 수를 구해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "완성한 묶음은 둘이에요. 소수 부분은 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 7",
      "after": "stock = 5",
      "say": "재고를 다섯 개로 줄여 봐요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "세 개짜리 한 묶음만 완성해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 5",
      "after": "stock = 6",
      "say": "재고 하나를 더해 여섯 개로 해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "딱 두 묶음을 완성했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 여기서는 양의 정수끼리 나눠요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 6",
      "after": "stock = 7",
      "say": "문제의 재고 일곱 개로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "일곱 개도 완성한 묶음 수는 둘이에요.",
      "target": "output"
