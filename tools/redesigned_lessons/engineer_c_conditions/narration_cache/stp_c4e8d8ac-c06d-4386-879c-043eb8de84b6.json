      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "세 개짜리 한 묶음만 완성해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 5",
      "after": "stock = 6",
      "say": "재고 하나를 더해 여섯 개로 해요."
