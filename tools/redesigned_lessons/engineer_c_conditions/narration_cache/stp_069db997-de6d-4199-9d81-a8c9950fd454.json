    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "비교는 0, 재고는 2로 남아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 2",
      "after": "stock = 4",
      "say": "포장하기 충분한 넷도 볼게요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "비교는 1, 재고는 4예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 비교 결과가 재고에 대입되지는 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 4",
