{
  "by": "hand",
  "source_sha256": "968c9c05661ed3391b1401a7d168115c1216b1844b2ff9eaa372f967b47c5f63",
  "entry": [
    {
      "action": "say",
      "text": "half와 minus는 둘 다 Rate예요. minus를 람다로 완성하는 문제예요.",
      "target": "text:minus의 람다를 고쳐 받은 금액에서 1000을 빼게 하세요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "4000이 나왔어요. 반값은 됐지만 minus가 받은 값을 그대로 돌려줬어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "Rate minus = w -> w;",
      "after": "Rate minus = won -> won - 1000;",
      "say": "매개변수 이름을 won으로 써 볼게요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ],
      "expect_error": "already defined"
    },
    {
      "action": "say",
      "text": "조심하세요. main에 이미 won이 있어서 람다 매개변수로 또 쓸 수 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "Rate minus = won -> won - 1000;",
      "after": "Rate minus = w -> w - 1000;",
      "say": "다른 이름 w로 써요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "3000이에요. half가 4000을 만들고 minus가 1000을 뺐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "w -> w - 1000은 apply(int w) { return w - 1000; }을 짧게 쓴 것과 같아요.",
      "target": "code:Rate minus = w -> w - 1000;"
    }
  ]
}
