  "entry": [
    {
      "action": "say",
      "text": "Dense는 출력마다 입력 × 가중치 + 편향을 계산해요. 출력 수를 outputs로 정해야 해요.",
      "target": "text:Dense를 고쳐 배송마다 출력 outputs개를 만드세요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "[None, 1]이에요. 배송마다 출력이 하나예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "keras.layers.Dense(1)])",
      "after": "keras.layers.Dense(outputs)])",
      "say": "Dense(1)을 Dense(outputs)로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "[None, 4]예요. 배송마다 출력 네 개를 만들어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. Dense(4)의 4는 받을 배송 수가 아니라 배송마다의 출력 수예요.",
      "target": "code:Dense(outputs)"
    }
  ]
}
