      "action": "run",
      "lines": [
        2,
        2
      ],
      "expect_error": "NOT NULL"
    },
    {
      "action": "say",
      "text": "NOT NULL 오류예요. 학번은 기본 키의 일부라서 비워 둘 수 없어요.",
      "target": "output"
