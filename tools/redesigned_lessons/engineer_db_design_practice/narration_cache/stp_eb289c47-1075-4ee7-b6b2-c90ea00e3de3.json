{
  "by": "hand",
  "source_sha256": "11097225cb0e150b120ba0336558841a6f902015a0484fc5f3f35e4a621393a6",
  "entry": [
    {
      "action": "say",
      "text": "kim 교수의 연구실 하나를 바꾸는데, 그 사실이 여러 행에 흩어져 있어요.",
      "target": "text:UPDATE의 WHERE 조건을 고쳐 kim 교수의 연구실이 모든 행에서 B204가 되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "kim 교수가 A101과 B204, 두 줄로 나왔어요. 한 행만 고쳐서 같은 사람이 연구실 두 개를 가졌어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "WHERE student = 1 AND course = 'DB'",
      "after": "WHERE course = 'DB'",
      "say": "과목 DB의 행을 모두 고쳐 볼게요."
    },
    {
      "action": "run",
      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "그래도 A101이 남았어요. kim 교수는 OS 행에도 연구실이 적혀 있거든요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 과목으로 고르면 같은 교수의 다른 과목 행을 놓쳐요. 바뀐 사실은 교수의 연구실이에요.",
      "target": "code:WHERE course = 'DB'"
    },
    {
      "action": "patch_code",
      "before": "WHERE course = 'DB'",
      "after": "WHERE prof = 'kim'",
      "say": "교수 이름으로 행을 골라요."
    },
    {
      "action": "run",
      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "kim 교수는 B204 한 줄만 남았어요. 중복된 행을 하나도 빠짐없이 고쳐야 어긋나지 않아요.",
      "target": "output"
    }
  ]
}
