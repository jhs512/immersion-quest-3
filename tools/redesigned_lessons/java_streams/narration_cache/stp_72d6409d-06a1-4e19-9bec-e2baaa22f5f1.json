  "entry": [
    {
      "action": "say",
      "text": "check는 filter가 원소를 실제로 검사하는 순간에 나와요. 언제 몇 번 나오는지 볼게요.",
      "target": "text:filter 안의 check 출력은 원소를 실제로 검사하는 순간을 보여 줘요."
    },
    {
      "action": "run",
      "lines": [
        11,
        17
      ]
    },
    {
      "action": "say",
      "text": "ready가 먼저 나오고 check가 세 번 나와요. 흐름을 만들 때는 검사하지 않았고, toList가 전부 검사했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "checked.toList().get(0)",
      "after": "checked.findFirst().orElse(0)",
      "say": "findFirst로 첫 결과만 요청해요. 없으면 0을 써요."
    },
    {
      "action": "run",
      "lines": [
        11,
        17
      ]
    },
    {
      "action": "say",
      "text": "check 3000이 없어요. 2,000을 찾자마자 흐름이 멈췄어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 결과를 전부 목록으로 만든 뒤 하나만 꺼내면 필요 없는 원소까지 검사해요.",
      "target": "code:checked.findFirst().orElse(0)"
    }
  ]
}
