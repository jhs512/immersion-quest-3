{
  "by": "hand",
  "source_sha256": "a7209408f29f8d2917608e6edf4a9a394c0b9a463ca573221638baacb257d537",
  "entry": [
    {
      "action": "say",
      "text": "주소와 바인드는 맞는데 네트워크가 나뉜 문제예요.",
      "target": "text:web과 client를 서로 다른 네트워크로 나눠 두었어요."
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait web",
      "say": "web을 실행해요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "front 네트워크를 만들고 web이 Healthy가 됐어요. back은 아직 만들지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm client",
      "say": "client에서 요청해 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "web이라는 이름을 찾지 못해요. back 네트워크에는 web이 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "client는 back에만 있어요. web과 공유하는 네트워크가 없어요.",
      "target": "code:networks: [back]"
    },
    {
      "action": "patch_code",
      "before": "networks: [back]",
      "after": "networks: [front]",
      "say": "client를 web과 같은 front 네트워크에 넣어요.",
      "file": "compose.yaml"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait web",
      "say": "고친 파일로 다시 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "web은 그대로예요. 바뀐 것은 client의 네트워크예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm client",
      "say": "다시 요청해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모 서버 응답이 왔어요. 같은 front에서 web 이름을 찾았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. network_mode: host로 피하지 마세요. 사용자 PC의 네트워크와 분리된 실습 네트워크를 유지해야 해요.",
      "target": "text:네트워크를 분리하는 것은 이름만 다르게 붙이는 것이 아니라 통신 경계를 만드는 일이에요."
    }
  ]
}
