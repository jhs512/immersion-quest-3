{
  "by": "hand",
  "source_sha256": "ab2e5a91fe73056a5651ea0f2140d3b96895c804dab5ec25f3e9549e097e0f91",
  "entry": [
    {
      "action": "say",
      "text": "서버는 web에 있고 요청은 client에서 보내요. 그런데 연결이 안 돼요.",
      "target": "text:서버는 web에 있고 요청은 client에서 보내요."
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait web",
      "say": "먼저 web 서버를 실행하고 건강해질 때까지 기다려요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "Healthy가 나왔어요. 서버는 자기 안에서 응답하고 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm client",
      "say": "client에서 요청을 보내 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "연결할 수 없다는 오류예요. client가 자기 localhost에 요청했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "localhost는 명령을 실행하는 컨테이너 자신을 가리켜요. client 안에는 서버가 없어요.",
      "target": "code:http://localhost:8080"
    },
    {
      "action": "patch_code",
      "before": "http://localhost:8080",
      "after": "http://web:8080",
      "say": "요청 주소를 서비스 이름 web으로 바꿔요.",
      "file": "compose.yaml"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait web",
      "say": "고친 파일로 다시 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "web은 그대로 건강해요. 바뀐 것은 client의 설정이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm client",
      "say": "다시 요청을 보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모 서버 응답이 나왔어요. web 이름으로 서버 컨테이너를 찾았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. client에도 서버를 띄워 결과만 맞추면 서로 다른 컨테이너를 연결하는 목표를 놓쳐요.",
      "target": "text:같은 Compose 네트워크의 서비스는 서비스 이름으로 찾아요."
    }
  ]
}
