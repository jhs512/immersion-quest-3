  "entry": [
    {
      "action": "say",
      "text": "List.of가 만든 목록은 처음 원소로 고정돼요. 거기에 add하려고 해요.",
      "target": "text:List.of가 만든 목록은 처음 원소로 고정돼요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ],
      "expect_error": "UnsupportedOperationException"
    },
    {
      "action": "say",
      "text": "UnsupportedOperationException이에요. 컴파일은 됐지만 실행 중에 고정 목록이 추가를 거절했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "List<Integer> prices = List.of(start);",
      "after": "List<Integer> prices = new ArrayList<>(List.of(start));",
      "say": "같은 원소로 ArrayList를 새로 만들어요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "[1000, 2000, 3000]이에요. 복사한 ArrayList는 원소를 더할 수 있어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 변수 타입이 List라도 add가 되는지는 실제로 담긴 목록 객체가 정해요.",
      "target": "code:new ArrayList<>(List.of(start))"
    }
  ]
}
