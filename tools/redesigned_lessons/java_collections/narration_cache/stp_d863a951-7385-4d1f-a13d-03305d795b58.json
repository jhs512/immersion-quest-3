  "entry": [
    {
      "action": "say",
      "text": "첫 가격 1,000을 읽으려면 get에 어떤 위치를 넣어야 하는지 묻고 있어요.",
      "target": "text:get(숫자)는 그 위치의 원소를 읽어요."
    },
    {
      "action": "say",
      "text": "지금 코드는 get(1)을 읽어요.",
      "target": "code:prices.get(1)"
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "2,000이 나왔어요. 위치 1은 두 번째 원소예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "prices.get(1)",
      "after": "prices.get(0)",
      "say": "첫 위치 0으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "1,000이에요. 첫 원소는 위치 0이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. get(1000)처럼 가격을 넣으면 그런 위치가 없어서 오류가 나요.",
      "target": "code:prices.get(0)"
    },
    {
      "action": "patch_code",
      "before": "prices.get(0)",
      "after": "prices.get(1)",
      "say": "원래 위치 1로 돌아와 비교해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "위치 1은 2,000이에요. 첫 가격에는 0이 필요해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "zero"
    }
  ]
