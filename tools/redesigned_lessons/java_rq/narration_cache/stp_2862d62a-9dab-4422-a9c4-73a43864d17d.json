  "entry": [
    {
      "action": "say",
      "text": "입력은 조건이 없는 list예요. 생성자가 보관한 작업 이름을 getActionName이 돌려줘야 해요.",
      "target": "text:이번 입력은 조건이 없는 list 같은 작업 이름이에요."
    },
    {
      "action": "say",
      "text": "지금 getter가 빈 문자열을 돌려줘요.",
      "target": "code:return \"\";"
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "작업 이름이 출력되지 않아요. 객체에 있는 값을 꺼내지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return \"\";",
      "after": "return actionName;",
      "say": "생성자가 보관한 actionName을 반환해요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "list가 나와요. 호출자가 객체에 작업 이름을 물을 수 있어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. list를 직접 반환하면 다른 요청도 list로 바뀌어요. 객체가 보관한 값을 사용하세요.",
      "target": "code:return actionName;"
    }
  ]
}
