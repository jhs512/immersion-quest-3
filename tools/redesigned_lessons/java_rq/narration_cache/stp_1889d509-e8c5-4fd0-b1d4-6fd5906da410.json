  "entry": [
    {
      "action": "say",
      "text": "입력 update?id=2에서 작업 이름은 물음표 앞의 update예요. actionOf가 그 이름만 돌려줘야 해요.",
      "target": "text:update?id=2 같은 요청을 준비해요."
    },
    {
      "action": "say",
      "text": "actionOf가 조건까지 포함한 요청 전체를 돌려줘요.",
      "target": "code:return request;"
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "update?id=2가 나와요. 작업 이름과 조건이 아직 붙어 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return request;",
      "after": "return request.split(\"\\\\?\", 2)[0];",
      "say": "첫 물음표를 기준으로 나눠 첫 조각을 반환해요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "update예요. 조건이 있어도 작업 이름만 얻었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 물음표를 정규식 기호 그대로 쓰면 오류가 나요. 문자 자체를 뜻하게 하세요.",
      "target": "code:return request.split(\"\\\\?\", 2)[0];"
    }
  ]
}
