  "entry": [
    {
      "action": "say",
      "text": "Rq가 조건을 Map에 담아요. 조건 한 조각은 키와 값의 짝이에요.",
      "target": "text:각 조각의 = 앞이 키, 뒤가 값이에요."
    },
    {
      "action": "say",
      "text": "& 로 나눈 조각마다 = 로 다시 나눠 Map에 넣어요.",
      "target": "code:params.put(pair[0], pair[1]);"
    },
    {
      "action": "say",
      "text": "getParam은 키로 값을 찾고 없으면 기본값을 돌려줘요.",
      "target": "code:params.getOrDefault(name, fallback)"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "2가 나왔어요. 키 id에 담긴 값은 문자열 2예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "rq.getParam(\"id\", \"none\")",
      "after": "rq.getParam(\"text\", \"none\")",
      "say": "같은 Rq에 다른 키를 물어볼게요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "hello예요. 키만 바꾸면 그 키의 값을 찾아요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "answer"
    }
  ]
}
