  "entry": [
    {
      "action": "say",
      "text": "요청 update?id=12의 id 값은 문자열 12예요. 정수로 바꿔 1을 더해야 해요.",
      "target": "text:Rq가 돌려주는 id는 문자열이에요."
    },
    {
      "action": "say",
      "text": "문자열에 1을 붙이고 있어요.",
      "target": "code:return rq.getParam(\"id\", \"-1\") + 1;"
    },
    {
      "action": "run",
      "lines": [
        28,
        28
      ]
    },
    {
      "action": "say",
      "text": "121이에요. 숫자 12에 더한 게 아니라 뒤에 글자 1이 붙었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return rq.getParam(\"id\", \"-1\") + 1;",
      "after": "return Integer.toString(Integer.parseInt(rq.getParam(\"id\", \"-1\")) + 1);",
      "say": "정수로 바꾸고 1을 더한 뒤 문자열로 돌려줘요."
    },
    {
      "action": "run",
      "lines": [
        28,
        28
      ]
    },
    {
      "action": "say",
      "text": "13이에요. 이번에는 숫자 덧셈을 했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 값 이름이 id라도 getParam이 돌려주는 건 문자열이라 +는 글자를 이어 붙여요.",
      "target": "code:return Integer.toString(Integer.parseInt(rq.getParam(\"id\", \"-1\")) + 1);"
    }
  ]
}
