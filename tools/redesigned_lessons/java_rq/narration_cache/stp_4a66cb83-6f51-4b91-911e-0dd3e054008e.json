    },
    {
      "action": "say",
      "text": "문자열에 1을 붙이고 있어요.",
      "target": "code:return rq.getParam(\"id\", \"-1\") + 1;"
    },
    {
      "action": "run",
      "lines": [
        28,
        28
      ]
    },
    {
      "action": "say",
      "text": "121이에요. 숫자 12에 더한 게 아니라 뒤에 글자 1이 붙었어요.",
      "target": "output"
