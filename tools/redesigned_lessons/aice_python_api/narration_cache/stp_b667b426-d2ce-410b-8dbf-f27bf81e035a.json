  "by": "hand",
  "source_sha256": "8fbb00c96c0789567e52135738517e82dd4100bfe620591f1cc9ef8d20ba9282",
  "entry": [
    {
      "action": "say",
      "text": "같은 sorted에 reverse라는 이름의 옵션을 함께 넘겨요. 큰 값부터 보이게 False 한 곳만 바꿔요.",
      "target": "text:이번에는 오래 걸린 배송부터 보려 해요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "False일 때는 십이, 십팔, 이십사 순서예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "reverse=False",
      "after": "reverse=True",
      "say": "반대 방향을 뜻하는 True로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "이십사, 십팔, 십이 순서가 됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "호출 괄호 안의 =는 이름 붙인 옵션을 전달해요.",
      "target": "lines:4"
    },
    {
      "action": "say",
      "text": "조심하세요. ==로 값을 비교하는 자리와 달라요.",
      "target": "lines:4"
    },
    {
      "action": "say",
      "text": "변수에 저장하는 대입문도 아니에요.",
      "target": "lines:4"
    },
    {
      "action": "say",
      "text": "두 번째 줄의 원래 목록은 계속 그대로예요.",
      "target": "output"
    }
  ]
}
