  "entry": [
    {
      "action": "say",
      "text": "항목은 두 종류지만 배송은 세 건이에요. 배송 건수를 count에 담아야 해요.",
      "target": "text:count 줄을 고쳐 항목 수가 아니라 배송 건수를 count에 담으세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "2예요. len(data)는 키 minutes와 region의 개수예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = len(data)\n",
      "after": "count = len(data[\"minutes\"])\n",
      "say": "시간 목록 data[\"minutes\"]의 길이를 세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "3이에요. 시간 목록에 든 배송 건수예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 지금처럼 항목 수와 건수가 비슷하면 우연히 맞을 수 있어요. 무엇의 길이인지 확인해요.",
      "target": "code:len(data[\"minutes\"])"
    }
  ]
}
