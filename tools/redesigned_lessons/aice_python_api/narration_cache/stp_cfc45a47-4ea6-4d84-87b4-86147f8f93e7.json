      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "서쪽이에요. region 키의 값을 꺼냈어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(record[\"region\"])",
      "after": "print(record[\"minutes\"])",
      "say": "키를 \"minutes\"로 바꿔요."
