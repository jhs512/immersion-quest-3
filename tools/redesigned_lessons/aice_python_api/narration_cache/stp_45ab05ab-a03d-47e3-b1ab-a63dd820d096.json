{
  "by": "hand",
  "source_sha256": "2d98b3a4f8115afd779884fca2c3ef3c747b9592a6f10e10e0fcf8b936bebfaa",
  "entry": [
    {
      "action": "say",
      "text": "대괄호 안 키 이름이 자료의 키와 한 글자 달라 오류가 나요. 자료에 적힌 키와 비교해 고치는 문제예요.",
      "target": "text:제공한 키와 비교해 빠진 글자 하나만 고치세요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ],
      "expect_error": "KeyError"
    },
    {
      "action": "say",
      "text": "KeyError는 이 이름의 키를 찾지 못했다는 뜻이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 자료에는 minutes가 있고 minute는 없어요.",
      "target": "lines:2"
    },
    {
      "action": "patch_code",
      "before": "data[\"minute\"]",
      "after": "data[0]",
      "say": "목록의 위치 번호처럼 영으로 꺼내 볼까요?"
    },
    {
      "action": "run",
      "say": "실행해서 이번 오류도 확인해요.",
      "lines": [
        4,
        4
      ],
      "expect_error": "KeyError"
    },
    {
      "action": "say",
      "text": "영이라는 키도 없어서 KeyError가 나왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 딕셔너리는 위치가 아니라 키로 골라요.",
      "target": "lines:2"
    },
    {
      "action": "patch_code",
      "before": "data[0]",
      "after": "data[\"minutes\"]",
      "say": "자료에 있는 minutes 키로 다시 꺼내요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "시간 목록이 나왔어요. 위치가 아니라 키로 골랐죠?",
      "target": "output"
    }
  ]
}
