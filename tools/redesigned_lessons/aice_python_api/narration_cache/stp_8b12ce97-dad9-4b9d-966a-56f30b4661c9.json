{
  "by": "hand",
  "source_sha256": "3e0a0bac35b3b89206aa6e626627a296d88bdc99051c08881a02e033221b25b7",
  "entry": [
    {
      "action": "say",
      "text": "import ... as stats는 모듈에 짧은 이름을 붙여요. 붙인 이름과 아래에서 부르는 이름이 달라 오류가 나는 상황이에요.",
      "target": "text:모듈을 stats라는 이름으로 불러왔어요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ],
      "expect_error": "NameError"
    },
    {
      "action": "say",
      "text": "NameError가 났어요. 이 코드에 statistics라는 이름은 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "statistics.mean",
      "after": "stats.mean",
      "say": "가져올 때 붙인 stats라는 이름으로 호출해요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "평균 18이 나왔어요. 기능은 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. stats가 정해진 예약 이름은 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": " as stats",
      "after": " as st",
      "say": "다른 짧은 이름 st로도 불러 볼게요."
    },
    {
      "action": "patch_code",
      "before": "stats.mean",
      "after": "st.mean",
      "say": "사용하는 이름도 함께 맞춰요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "이름을 함께 바꾸면 평균은 여전히 18이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": " as st\n",
      "after": " as stats\n",
      "say": "문제의 별칭 stats로 돌아와요."
    },
    {
      "action": "patch_code",
      "before": "st.mean",
      "after": "stats.mean",
      "say": "기능을 부르는 이름도 다시 맞춰요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "import는 이름을 연결해요. 라이브러리 설치와는 달라요.",
      "target": "output"
    }
  ]
}
