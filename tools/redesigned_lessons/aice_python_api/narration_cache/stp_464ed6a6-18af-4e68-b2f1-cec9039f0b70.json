{
  "by": "hand",
  "source_sha256": "dfb43a9eabf4e416d65990ea9b07e5ef14f87f9c9efc6cb8e75fa2bd3a15f185",
  "entry": [
    {
      "action": "say",
      "text": "시간을 짧은 순서로 보고 싶어요. sorted 괄호 안에 minutes를 전달해야 해요.",
      "target": "text:ordered 줄을 고쳐 sorted에 minutes를 전달한 결과를 ordered에 담으세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        6
      ]
    },
    {
      "action": "say",
      "text": "두 줄 모두 [24, 12, 18]이에요. 아직 정렬하지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ordered = minutes\n",
      "after": "ordered = sorted(minutes)\n",
      "say": "sorted(minutes)의 결과를 ordered에 담아요."
    },
    {
      "action": "run",
      "lines": [
        5,
        6
      ]
    },
    {
      "action": "say",
      "text": "[12, 18, 24]와 [24, 12, 18]이에요. 새 목록만 정렬됐고 원래 목록은 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. minutes.sort()는 원래 목록을 바꾸고 None을 돌려줘요.",
      "target": "code:ordered = sorted(minutes)"
    }
  ]
}
