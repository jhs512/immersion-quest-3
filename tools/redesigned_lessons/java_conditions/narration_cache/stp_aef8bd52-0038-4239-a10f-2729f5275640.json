  "entry": [
    {
      "action": "say",
      "text": "25,000원 주문은 무료여야 해요. 그런데 이 금액은 두 구간 조건을 모두 만족해요.",
      "target": "text:25,000원 주문이 무료가 되려면 어떻게 할까요?"
    },
    {
      "action": "say",
      "text": "지금은 if 두 개가 따로 있어서 둘 다 검사해요.",
      "target": "lines:6:11"
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "1,000원이 나왔어요. 0원을 저장한 뒤 두 번째 if가 1,000원으로 덮어썼어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "}\n    if (amount >= 10000)",
      "after": "} else if (amount >= 10000)",
      "say": "두 번째 if를 else if로 이어요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "0원이에요. 첫 조건이 참이라 else if는 검사하지 않았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 구간을 나눌 때 if만 여러 개 쓰면 뒤의 조건이 앞의 결정을 덮어써요.",
      "target": "text:따로 쓴 if 두 개는 앞의 결과와 관계없이 둘 다 검사해요."
    },
    {
      "action": "patch_code",
      "before": "amount = 25000",
      "after": "amount = 15000",
      "say": "중간 구간 금액 15,000원으로도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "1,000원이에요. 첫 조건이 거짓일 때만 두 번째 구간을 골랐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 15000",
      "after": "amount = 25000",
      "say": "주어진 주문으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "25,000원은 높은 구간 하나만 골라 0원이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "chain"
    }
  ]
}
