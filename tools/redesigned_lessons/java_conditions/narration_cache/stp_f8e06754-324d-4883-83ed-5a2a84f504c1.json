  "entry": [
    {
      "action": "say",
      "text": "규칙은 20,000원 이상이면 무료배송이에요.",
      "target": "text:무료배송은 20,000원 이상이에요."
    },
    {
      "action": "say",
      "text": "질문은 19,999원 주문에서 이 비교가 true인지 false인지예요.",
      "target": "text:19,999원은 무료배송 조건이 true일까요?"
    },
    {
      "action": "say",
      "text": "비교식은 금액이 아니라 참이나 거짓 하나를 결과로 내요.",
      "target": "code:amount >= limit"
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "false가 나왔어요. 기준보다 1원 모자라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 19999",
      "after": "amount = 20000",
      "say": "금액만 기준과 같은 20,000원으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "true예요. 크거나 같음은 같은 값도 포함해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 20000",
      "after": "amount = 19999",
      "say": "문제의 19,999원으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "다시 false예요. 이 금액은 무료배송 조건을 만족하지 않아요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "false"
    }
  ]
}
