    },
    {
      "action": "say",
      "text": "조심하세요. 결과를 영으로 고정하면 작은 주문도 무료예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 20000",
      "after": "amount = 19999",
      "say": "기준 바로 아래 금액도 확인해요."
