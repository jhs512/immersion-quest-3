{
  "by": "hand",
  "source_sha256": "a3876b03e8009850b8c06b4630bb1f308591a22c0400b934990ed3bbb8b8ba92",
  "entry": [
    {
      "action": "say",
      "text": "AI가 만든 조건이 기준 금액에서 틀린 결과를 내요. 금액과 기준은 그대로 두고 비교만 고쳐요.",
      "target": "text:AI가 만든 무료배송 조건이 경계에서 틀려요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "3,000원이 나와요. 20,000원은 무료여야 하는데 배송비를 받았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "초과 비교라서 기준과 같은 금액이 빠졌어요.",
      "target": "code:amount > limit"
    },
    {
      "action": "patch_code",
      "before": "amount > limit",
      "after": "amount >= limit",
      "say": "크거나 같음으로 바꿔 기준 금액을 포함해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "0원이에요. 기준 금액이 무료가 됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 0을 바로 출력하게 바꾸면 이 금액만 맞고 작은 주문까지 무료가 돼요.",
      "target": "code:fee = 0;"
    },
    {
      "action": "patch_code",
      "before": "amount = 20000",
      "after": "amount = 19999",
      "say": "기준 바로 아래 금액도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "19,999원은 여전히 3,000원이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 19999",
      "after": "amount = 20000",
      "say": "처음 경계값으로 다시 확인해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "다시 0이 나와요. 기준 금액 20,000원을 무료배송에 포함하는 규칙대로 동작해요.",
      "target": "output"
    }
  ]
}
