{
  "by": "hand",
  "source_sha256": "8d1630519ef3cc04c1f201508b10bff84694122e171b041dcc83c022dce4ff5b",
  "entry": [
    {
      "action": "say",
      "text": "이번 주문 금액은 기준과 딱 같은 20,000원이에요.",
      "target": "text:주문 금액이 딱 20,000원이 됐어요."
    },
    {
      "action": "say",
      "text": "질문은 20,000원도 무료에 포함하는 비교식이 어느 쪽인지예요.",
      "target": "text:20,000원도 포함하는 비교식은 무엇일까요?"
    },
    {
      "action": "say",
      "text": "같은 금액으로 초과 비교와 이상 비교를 한 줄씩 출력해요.",
      "target": "lines:6:7"
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "초과는 false, 이상은 true예요. 금액이 같을 때 둘이 갈려요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 20000",
      "after": "amount = 20001",
      "say": "기준보다 1원 큰 금액도 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "둘 다 true예요. 기준을 넘는 금액에서는 차이가 보이지 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 기준보다 큰 금액만 시험하면 초과와 이상을 고른 실수를 놓쳐요.",
      "target": "code:amount > limit"
    },
    {
      "action": "patch_code",
      "before": "amount = 20001",
      "after": "amount = 20000",
      "say": "차이를 보여 준 경계값으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "경계 20,000원을 포함하려면 크거나 같음이 필요해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "inclusive"
    }
  ]
}
