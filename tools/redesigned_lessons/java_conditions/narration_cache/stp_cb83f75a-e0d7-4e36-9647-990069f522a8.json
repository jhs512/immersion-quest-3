{
  "by": "hand",
  "source_sha256": "4baa5f6f23a386b53ec93565d24edbbd6359f5670ec04acc8a2d0d395b6c6468",
  "entry": [
    {
      "action": "say",
      "text": "결제한 금액이 주문 금액과 같은지 확인하려는 문장인데, 괄호 안에 등호가 하나예요.",
      "target": "text:지금 출력문은 비교 결과 대신 금액을 보여 줘요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "20000이 나왔어요. 등호 하나는 paid를 amount에 넣는 대입이라 넣은 값이 출력됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = paid",
      "after": "amount == paid",
      "say": "등호를 두 개 써서 같은지 비교해요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "true가 나와요. 두 금액이 같으니 참이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int paid = 20000;",
      "after": "int paid = 15000;",
      "say": "결제 금액을 15,000원으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "false예요. 다른 금액이면 같음 비교는 거짓이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 등호 하나로 쓰면 오류 없이 실행돼도 비교가 아니라 값을 바꿔 버려요.",
      "target": "code:amount == paid"
    },
    {
      "action": "patch_code",
      "before": "int paid = 15000;",
      "after": "int paid = 20000;",
      "say": "결제 금액을 처음 값으로 되돌려요."
    }
  ]
}
