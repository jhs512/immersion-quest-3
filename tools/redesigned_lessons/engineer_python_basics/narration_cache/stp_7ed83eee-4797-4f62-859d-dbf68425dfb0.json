  "entry": [
    {
      "action": "say",
      "text": "한 줄로 들어온 두 수량을 더해야 해요. 입력은 12 30이에요.",
      "target": "text:print 줄을 고쳐 두 수량을 수로 더하게 하세요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "1230이 나왔어요. a와 b가 글자 12와 30이라 +가 이어 붙였어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(a + b)",
      "after": "print(int(a + b))",
      "say": "정수로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "여전히 1230이에요. 이미 이어 붙인 글자를 정수로 바꿨거든요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. int는 더하기 전에 각각 씌워야 해요. 붙인 뒤에 바꾸면 1230이 그대로 수가 돼요.",
      "target": "code:int(a + b)"
    },
    {
      "action": "patch_code",
      "before": "print(int(a + b))",
      "after": "print(int(a) + int(b))",
      "say": "a와 b를 각각 정수로 바꾼 뒤 더해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "42가 나왔어요. 12와 30을 수로 더했어요.",
      "target": "output"
    }
  ]
}
