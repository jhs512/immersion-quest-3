{
  "by": "hand",
  "source_sha256": "5936adcb2c6c803226760f00c2c61296d029ab11785dd0bbfd4f820553823d0e",
  "entry": [
    {
      "action": "say",
      "text": "100을 두 번 절반으로 줄인 값을 구해야 해요.",
      "target": "text:100, 50, 25 순서로 줄어야 해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "50이 나왔어요. times로 나누면 2로 한 번 나눈 셈이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(size // times)",
      "after": "print(size >> times)",
      "say": "오른쪽으로 times칸 밀어요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "25예요. 한 칸에 절반씩, 두 칸 밀어 100을 4로 나눈 몫이 됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "size = 100",
      "after": "size = 101",
      "say": "홀수 101로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "또 25예요. 밀려 나간 끝자리는 버려져서 나눈 몫만 남아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 화살표 방향을 << 로 바꾸면 반대로 두 배씩 커져요. 줄일 때는 오른쪽 >>예요.",
      "target": "code:size >> times"
    }
  ]
}
