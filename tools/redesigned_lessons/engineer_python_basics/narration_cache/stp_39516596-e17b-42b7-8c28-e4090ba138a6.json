  "entry": [
    {
      "action": "say",
      "text": "세 번호를 한 줄에 공백으로 띄워 찍는 문제예요.",
      "target": "text:상자 번호가 한 줄에 공백 하나씩 띄워 출력되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "3, 8, 5가 세 줄로 나왔어요. print마다 끝에 줄바꿈이 붙었거든요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(b)",
      "after": "print(b, end='')",
      "say": "줄바꿈 대신 빈 글자를 붙여 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "385가 나왔어요. 줄은 하나가 됐는데 번호가 붙어 버렸죠?",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. end에 빈 글자를 주면 사이 공백도 사라져요. 3, 8, 5인지 385인지 알 수 없어요.",
      "target": "code:end=''"
    },
    {
      "action": "patch_code",
      "before": "end=''",
      "after": "end=' '",
      "say": "end에 공백 한 칸을 줘요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "3 8 5가 한 줄에 나왔어요. 번호마다 공백 하나가 뒤에 붙었어요.",
      "target": "output"
    }
  ]
}
