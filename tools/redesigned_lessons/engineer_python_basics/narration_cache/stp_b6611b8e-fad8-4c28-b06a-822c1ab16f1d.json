{
  "by": "hand",
  "source_sha256": "d012fa6c8758777a5efd526a9d4b0dffd62f6645ae5e981a0cadbbbb7980a3ee",
  "entry": [
    {
      "action": "say",
      "text": "겹쳐 나온 pat까지 하나하나 세야 해요.",
      "target": "text:XOXOX처럼 겹쳐 나온 것도 각각 세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "0이 나왔어요. 두 글자 조각은 세 글자 XOX와 같을 수가 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "log[i:i + 2]",
      "after": "log[i:i + 3]",
      "say": "창을 세 글자로 늘려 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "2가 나왔어요. 0번과 2번에서 시작한 XOX가 가운데 X를 나눠 썼어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 3을 박아 두면 pat이 두 글자일 때 창이 안 맞아요. 창 길이는 pat에서 가져와요.",
      "target": "code:i + 3"
    },
    {
      "action": "patch_code",
      "before": "log[i:i + 3]",
      "after": "log[i:i + len(pat)]",
      "say": "창 길이를 len(pat)으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "2 그대로예요. 이제 pat 길이가 바뀌면 창도 함께 바뀌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "i가 끝 근처면 조각이 짧아져요. 오류 없이 그냥 다른 글자가 돼서 세지 않아요.",
      "target": "code:range(len(log))"
    }
  ]
}
