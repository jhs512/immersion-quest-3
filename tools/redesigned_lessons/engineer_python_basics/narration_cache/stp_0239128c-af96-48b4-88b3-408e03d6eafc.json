{
  "by": "hand",
  "source_sha256": "35f5fcb5c9d68a1d905cb6e6085e3c8d1fbb2c1e2b26e94b7d7b2f5eefce8846",
  "entry": [
    {
      "action": "say",
      "text": "1칸, 2칸, 3칸 민 값 셋을 다 더해야 해요.",
      "target": "text:100이면 50 + 25 + 12예요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "total=25예요. 2칸 민 마지막 값만 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "반복마다 total에 새 값을 대입해서 앞의 50을 덮어썼어요.",
      "target": "code:total = size >> i"
    },
    {
      "action": "patch_code",
      "before": "total = size >> i",
      "after": "total += size >> i",
      "say": "대입을 +=로 바꿔 값을 쌓아요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "total=75예요. 50과 25는 쌓였는데 12가 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. range(1, 3)은 i가 1과 2일 때만 돌아요. 3칸 민 값은 더해지지 않아요.",
      "target": "code:range(1, 3)"
    },
    {
      "action": "patch_code",
      "before": "range(1, 3)",
      "after": "range(1, 4)",
      "say": "끝 값을 4로 늘려 i가 3까지 오게 해요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "total=87이에요. 50, 25, 12가 차례로 쌓였어요. 100 >> 3은 12.5가 아니라 몫 12예요.",
      "target": "output"
    }
  ]
}
