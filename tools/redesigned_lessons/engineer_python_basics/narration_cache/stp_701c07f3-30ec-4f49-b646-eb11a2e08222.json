{
  "by": "hand",
  "source_sha256": "4fb907bb685c46236ab819c02135723a85ff0a2ad533cd44f7f9655b197ba87b",
  "entry": [
    {
      "action": "say",
      "text": "출력 글자의 공백 하나까지 맞추는 문제예요.",
      "target": "text:x와 수량 사이에는 공백이 없어야 해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "pen x 3이 나왔어요. print는 쉼표로 나눈 값 사이마다 공백을 넣어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(item, 'x', qty)",
      "after": "print(item, 'x' + qty)",
      "say": "Java처럼 글자에 수를 더해 붙여 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ],
      "expect_error": "TypeError"
    },
    {
      "action": "say",
      "text": "TypeError가 났어요. 파이썬은 문자열과 정수를 +로 잇지 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. Java에서는 \"x\" + 3이 x3이 되지만, 파이썬에서는 실행이 멈춰요.",
      "target": "code:'x' + qty"
    },
    {
      "action": "patch_code",
      "before": "print(item, 'x' + qty)",
      "after": "print(f'{item} x{qty}')",
      "say": "f-string으로 한 글자열 안에 값을 끼워 넣어요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "pen x3이에요. 중괄호 자리에 pen과 3이 글자로 들어갔어요.",
      "target": "output"
    }
  ]
}
