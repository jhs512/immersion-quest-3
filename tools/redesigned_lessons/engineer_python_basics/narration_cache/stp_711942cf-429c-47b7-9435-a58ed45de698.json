{
  "by": "hand",
  "source_sha256": "68c4b86bb90bf1f80bb553707918ccc73e3c2f7a2790ecffd557673277bd5c03",
  "entry": [
    {
      "action": "say",
      "text": "BOX_RED_07에서 RED 세 글자를 잘라야 해요.",
      "target": "text:슬라이스의 끝 위치 한 곳을 고쳐 색 이름 세 글자가 모두 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "RE가 나왔어요. 4번 R, 5번 E까지 왔고 6번 D는 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "B가 0번이에요. 밑줄이 3번이라 R은 4번 칸이에요.",
      "target": "code:code[4:6]"
    },
    {
      "action": "patch_code",
      "before": "code[4:6]",
      "after": "code[3:7]",
      "say": "앞도 한 칸 넓혀 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "_RED가 나왔어요. 3번 칸의 밑줄까지 들어왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 밑줄을 칸으로 세지 않으면 시작이 한 칸 어긋나요. 시작은 4번 그대로 둬요.",
      "target": "code:code[3:7]"
    },
    {
      "action": "patch_code",
      "before": "code[3:7]",
      "after": "code[4:7]",
      "say": "시작은 4, 끝은 D의 다음 칸 7로 둬요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "RED예요. 4, 5, 6번 칸을 가져오고 7번 밑줄 앞에서 멈췄어요.",
      "target": "output"
    }
  ]
}
