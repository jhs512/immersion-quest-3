{
  "by": "hand",
  "source_sha256": "7129a93602540f9eed97659251fc8e87c49b83f4512d549007e9bcbfd411aeaa",
  "entry": [
    {
      "action": "say",
      "text": "숫자 칸만 앞에서부터, 뒤에서부터 읽는 문제예요.",
      "target": "text:front를 만드는 줄의 시작 위치를 고쳐 숫자만 앞에서부터 고르게 하세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "ABCD 4321이 나왔어요. front는 글자만, back은 숫자만 골랐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "간격이 -2인 back은 시작을 비워도 끝 칸 4부터 거꾸로 두 칸씩 가요.",
      "target": "code:tag[::-2]"
    },
    {
      "action": "say",
      "text": "front는 시작을 비워서 0번 칸 A부터 두 칸씩 갔어요.",
      "target": "code:tag[::2]"
    },
    {
      "action": "patch_code",
      "before": "front = tag[::2]",
      "after": "front = tag[2::2]",
      "say": "시작을 2로 줘 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "front가 BCD예요. 2번 칸도 글자라 여전히 글자만 골랐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 숫자 칸은 홀수 번호예요. 두 칸 뒤 2번이 아니라 바로 다음 1번에서 시작해요.",
      "target": "code:tag[2::2]"
    },
    {
      "action": "patch_code",
      "before": "front = tag[2::2]",
      "after": "front = tag[1::2]",
      "say": "1번 칸부터 두 칸씩 가요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "1234 4321이에요. 1, 3, 5, 7번 칸의 숫자를 골랐어요.",
      "target": "output"
    }
  ]
}
