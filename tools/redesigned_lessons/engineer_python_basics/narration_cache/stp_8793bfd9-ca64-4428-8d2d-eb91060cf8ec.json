  "entry": [
    {
      "action": "say",
      "text": "비슷해 보이는 값 가운데 정수만 골라 세야 해요.",
      "target": "text:그중 정수만 세려 해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "1이 나왔어요. 따옴표 안의 '100' 하나만 같은 종류였어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "type('100')",
      "after": "type(100.0)",
      "say": "따옴표를 빼고 100.0과 비교해 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "또 1이에요. 이번에는 100.0 하나만 맞았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 100.0은 값이 100이어도 점이 있어 실수예요. 정수 100과 종류가 달라요.",
      "target": "code:type(100.0)"
    },
    {
      "action": "patch_code",
      "before": "type(100.0)",
      "after": "type(100)",
      "say": "점 없는 100과 비교해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "3이 나왔어요. 100, 25, 7이 정수예요. 괄호로 묶인 (100, 25)는 튜플이라 빠졌어요.",
      "target": "output"
    }
  ]
}
