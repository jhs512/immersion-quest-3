{
  "by": "hand",
  "source_sha256": "9a3a1cb7b6fd872b36761fbf303b8695643902d902532ccc9ad88a20607b697e",
  "entry": [
    {
      "action": "say",
      "text": "index는 읽을 위치예요. 두 번째 출력이 다음 가격이 되도록 위치만 옮겨야 해요.",
      "target": "text:index에는 지금 읽을 위치가 들어 있어요."
    },
    {
      "action": "run",
      "lines": [
        6,
        8
      ]
    },
    {
      "action": "say",
      "text": "1000이 두 번 나와요. 위치가 그대로 0이니까요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    // 이 주석 아래 줄에서 읽을 위치를 하나 다음으로 옮기세요.\n",
      "after": "    // 이 주석 아래 줄에서 읽을 위치를 하나 다음으로 옮기세요.\n    prices[index]++;\n",
      "say": "먼저 대괄호 뒤에 ++를 붙여 볼게요."
    },
    {
      "action": "run",
      "lines": [
        6,
        9
      ]
    },
    {
      "action": "say",
      "text": "1000 다음에 1001이 나왔어요. 위치가 아니라 0번 가격 자체가 1 늘었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    prices[index]++;\n",
      "after": "    index++;\n",
      "say": "가격 대신 위치 index를 1 늘려요."
    },
    {
      "action": "say",
      "text": "index++는 위치 값 0을 1로 바꿔요. 배열 안의 가격은 그대로예요.",
      "target": "code:index++;"
    },
    {
      "action": "run",
      "lines": [
        6,
        9
      ]
    },
    {
      "action": "say",
      "text": "1000 다음에 2000이 나와요. 같은 출력문이 옮긴 위치의 가격을 읽었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. prices[index]++는 위치가 아니라 그 자리의 가격을 바꿔요.",
      "target": "code:index++;"
    }
  ]
}
