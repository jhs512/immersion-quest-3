{
  "by": "hand",
  "source_sha256": "57ce0012557c5495bea4b2af10f884f365afae99e278c60b4f5200211752edaa",
  "entry": [
    {
      "action": "say",
      "text": "배열 prices에는 1,000, 2,000, 3,000원이 순서대로 들어 있어요.",
      "target": "code:{1000, 2000, 3000}"
    },
    {
      "action": "say",
      "text": "질문은 첫 가격 1,000원을 읽을 때 대괄호에 쓸 숫자예요.",
      "target": "text:첫 가격을 고르는 위치는 무엇일까요?"
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "1,000원이 나왔어요. 대괄호 안 0이 첫 자리를 가리켜요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "prices[0]",
      "after": "prices[1]",
      "say": "위치만 1로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "2,000원이에요. 1은 두 번째 자리예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 대괄호 안 숫자는 가격이 아니라 몇 번째인지를 0부터 센 위치예요.",
      "target": "code:prices[1]"
    },
    {
      "action": "patch_code",
      "before": "prices[1]",
      "after": "prices[0]",
      "say": "첫 위치로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "첫 원소의 위치는 0이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "zero"
    }
  ]
}
