{
  "by": "hand",
  "source_sha256": "421b54cffa441cc20a19124bf0260b32a591364dbd788de408838f0f117aec4a",
  "entry": [
    {
      "action": "say",
      "text": "가격 개수는 주문마다 달라요. 위치 2를 직접 적으면 세 개일 때만 맞아요.",
      "target": "text:지금 출력문은 위치 2를 직접 적어서 가격이 세 개일 때만 맞아요."
    },
    {
      "action": "patch_code",
      "before": "{1000, 2000, 3000}",
      "after": "{1000, 2000, 3000, 4000}",
      "say": "먼저 가격을 네 개로 늘려 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "3000이 나왔어요. 마지막 가격은 4000인데 위치 2를 고정해서 셋째 가격을 읽었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "prices[2]",
      "after": "prices[prices.length - 1]",
      "say": "개수에서 1을 뺀 위치로 바꿔요."
    },
    {
      "action": "say",
      "text": "prices.length는 지금 4이고, 마지막 위치는 그보다 하나 작은 3이에요.",
      "target": "code:prices.length - 1"
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "4000이에요. 개수가 바뀌어도 마지막 위치를 계산해서 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "{1000, 2000, 3000, 4000}",
      "after": "{1000, 2000, 3000}",
      "say": "처음 배열로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "3000이에요. 세 개일 때도 마지막 가격이 나와요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 1을 빼지 않고 prices.length를 그대로 쓰면 없는 자리를 읽어 오류가 나요.",
      "target": "code:prices.length - 1"
    }
  ]
}
