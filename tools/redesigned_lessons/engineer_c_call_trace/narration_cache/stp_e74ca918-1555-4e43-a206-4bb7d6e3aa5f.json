    {
      "action": "say",
      "text": "5부터 1까지 곱한 120이 나와야 해요. 지금은 더하는 재귀예요.",
      "target": "text:orders가 곱을 쌓도록 두 줄을 고치세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "15가 나왔어요. 5 + 4 + 3 + 2 + 1 + 0으로 더했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "n + orders(n - 1)",
      "after": "n * orders(n - 1)",
      "say": "더하기만 곱하기로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "0이 나왔어요. 맨 아래 orders(0)이 0을 돌려줘서 모든 곱이 0이 됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return 0;\n    }",
      "after": "return 1;\n    }",
      "say": "기저의 반환값을 곱해도 그대로인 1로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "120이에요. 돌아오며 1, 1, 2, 6, 24, 120 순서로 쌓였어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 합을 쌓던 틀을 곱으로 바꿀 때 기저 0을 그대로 두면 답이 늘 0이에요.",
      "target": "code:return 1;"
    }
  ]
}
