{
  "by": "hand",
  "source_sha256": "b6ab90c3476d816364213f2e37767d28f464c0fc445a63ff00e101984056db2c",
  "entry": [
    {
      "action": "say",
      "text": "번호표는 1번부터예요. 지금 코드는 몇 번부터 붙는지 볼게요.",
      "target": "text:enumerate 부분을 고쳐 번호표가 1부터 붙게 하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "{0: 'P', 1: 'Q', 2: 'R'}가 나왔어요. enumerate는 0부터 세요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "table[i] = code",
      "after": "table[1] = code",
      "say": "키를 1로 박아 볼게요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "{1: 'R'}만 남았어요. 같은 키 1에 대입할 때마다 앞 값을 덮어썼어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 키를 하나로 고정하면 새 칸이 안 생기고 값만 바뀌어요. 마지막 R만 남아요.",
      "target": "code:table[1] = code"
    },
    {
      "action": "patch_code",
      "before": "table[1] = code",
      "after": "table[i] = code",
      "say": "키를 i로 되돌려요."
    },
    {
      "action": "patch_code",
      "before": "enumerate(codes)",
      "after": "enumerate(codes, 1)",
      "say": "enumerate에 시작 번호 1을 줘요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "{1: 'P', 2: 'Q', 3: 'R'}예요. 번호가 1부터 붙고 넣은 순서대로 출력됐어요.",
      "target": "output"
    }
  ]
}
