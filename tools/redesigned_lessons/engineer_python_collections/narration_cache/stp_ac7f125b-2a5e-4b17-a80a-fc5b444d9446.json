{
  "by": "hand",
  "source_sha256": "2d4f7dfecbfd9676e026d0c061d6216132c1dbb36ee658e14a2608c8c270ce0d",
  "entry": [
    {
      "action": "say",
      "text": "이름과 가격을 함께 받아야 가격으로 고를 수 있어요.",
      "target": "text:for 줄을 고쳐 상품 이름과 가격을 짝으로 받게 하세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "ValueError가 났어요. 사전을 그대로 돌리면 키만 하나씩 나와요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "키 'pen'을 name과 won 둘로 나누려 했는데 글자가 셋이라 멈췄어요.",
      "target": "code:for name, won in price:"
    },
    {
      "action": "patch_code",
      "before": "in price:",
      "after": "in price.items():",
      "say": "items()로 바꿔 (키, 값) 짝을 받아요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "pen cup이 나왔어요. 800원인 ink는 빠졌고 넣은 순서 그대로예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "for name, won in",
      "after": "for won, name in",
      "say": "받는 이름의 순서를 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ],
      "expect_error": "TypeError"
    },
    {
      "action": "say",
      "text": "TypeError가 났어요. won에 'pen'이 들어가 1000과 비교했거든요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. items의 짝은 늘 키가 먼저, 값이 나중이에요. 받는 순서를 바꾸면 이름과 숫자를 비교해요.",
      "target": "code:for won, name in"
    },
    {
      "action": "patch_code",
      "before": "for won, name in",
      "after": "for name, won in",
      "say": "키, 값 순서로 되돌려요."
    }
  ]
}
