{
  "by": "hand",
  "source_sha256": "34cb2d1672add7d1588066c05c52d5324ab4cc2ae0c28781323766e357fb2478",
  "entry": [
    {
      "action": "say",
      "text": "상자를 옮기면 queue에서는 빠지고 done에는 들어가야 해요.",
      "target": "text:끝 상자가 queue에서 빠지면서 done으로 옮겨지게 하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "queue는 그대로고 done에 14가 두 번 들어갔어요. [-1]은 읽기만 해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "queue[-1]",
      "after": "queue.pop()",
      "say": "끝 칸을 빼면서 그 값을 돌려주는 pop으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "[11, 12]와 [14, 13]이에요. 14를 꺼낸 다음 새 끝인 13을 꺼냈어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "queue.pop()",
      "after": "queue.pop(0)",
      "say": "괄호에 0을 넣어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "이번엔 [13, 14]와 [11, 12]예요. 맨 앞 칸부터 꺼냈어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. pop의 괄호 안은 값이 아니라 위치예요. 0을 주면 맨 앞, 비우면 맨 끝을 꺼내요.",
      "target": "code:queue.pop(0)"
    },
    {
      "action": "patch_code",
      "before": "queue.pop(0)",
      "after": "queue.pop()",
      "say": "괄호를 비워 끝에서 꺼내게 되돌려요."
    }
  ]
}
