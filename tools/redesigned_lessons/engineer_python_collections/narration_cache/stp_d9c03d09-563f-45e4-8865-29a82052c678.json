{
  "by": "hand",
  "source_sha256": "ebe9c4c45a063a5c443477a9343d1823be476b8bfe0a32403a3e5b857a6fae65",
  "entry": [
    {
      "action": "say",
      "text": "A2가 kim으로 바뀐 다음의 주인 수를 세야 해요.",
      "target": "text:names를 만드는 줄의 위치를 고쳐 주인이 바뀐 뒤의 사람 수가 출력되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "2가 나왔어요. 지금 owner의 주인은 kim 한 명이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "names는 이 줄에서 그때의 값 kim, lee로 만든 새 집합이에요. owner와 이어져 있지 않아요.",
      "target": "code:names = set(owner.values())"
    },
    {
      "action": "patch_code",
      "before": "names = set(owner.values())\n",
      "after": "",
      "say": "집합을 만드는 줄을 위에서 지워요."
    },
    {
      "action": "patch_code",
      "before": "owner['A2'] = 'kim'\n",
      "after": "owner['A2'] = 'kim'\nnames = set(owner.values())\n",
      "say": "주인을 바꾼 줄 아래에 다시 써요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "1이에요. 바꾼 뒤의 값으로 모으니 kim 하나만 남았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "names = set(owner.values())",
      "after": "names = set(owner)",
      "say": "values를 빼고 사전을 바로 집합으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "3이 나왔어요. 사전을 그대로 넘기면 키 A1, A2, A3이 모여요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. set(owner)는 주인 이름이 아니라 칸 번호를 모아요. 값을 모으려면 values()가 필요해요.",
      "target": "code:set(owner)"
    },
    {
      "action": "patch_code",
      "before": "names = set(owner)",
      "after": "names = set(owner.values())",
      "say": "values()로 되돌려요."
    }
  ]
}
