    {
      "action": "say",
      "text": "함수 안의 대입이 바깥 total을 바꿔야 해요. 함수 첫 줄에 global total을 더해요.",
      "target": "text:함수의 첫 줄에 global 선언을 더해 바깥 total을 바꾸게 하세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "2예요. 함수 안의 total은 지역 이름이라 바깥 total은 그대로예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    total = new_total\n",
      "after": "    global total\n    total = new_total\n",
      "say": "대입 앞에 global total을 써요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "9예요. 함수 안의 대입이 바깥 total을 바꿨어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. global 없이 같은 이름에 대입하면 오류 없이 지역 이름만 생겨요. 결과로 확인해요.",
      "target": "code:global total"
    }
  ]
}
