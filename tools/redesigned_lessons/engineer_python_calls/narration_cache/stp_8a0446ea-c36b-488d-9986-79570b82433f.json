  "entry": [
    {
      "action": "say",
      "text": "작은 문제의 답을 돌려받아 곱해야 해요. n과 multiply(n - 1)을 곱해 돌려줘요.",
      "target": "text:return n 줄을 고쳐 n과 multiply(n - 1)의 결과를 곱해 돌려주세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "4예요. 작은 문제를 부르지 않고 n만 돌려줬어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    return n\n",
      "after": "    return n * multiply(n - 1)\n",
      "say": "return n 뒤에 * multiply(n - 1)을 더해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "24예요. 4 × 3 × 2 × 1을 돌아오면서 곱했어요.",
      "target": "output"
    },
    {
      "action": "code_flow",
      "line": 3,
      "event": "step_line",
      "target": "flow_stack",
      "say": "코드 흐름 보기로 가장 깊은 호출을 열었어요. n이 4, 3, 2, 1인 multiply 네 칸이 쌓였어요."
    },
    {
      "action": "say",
      "text": "조심하세요. n * (n - 1)처럼 한 번만 곱하면 12에서 멈춰요. 작은 문제의 답을 다시 불러야 해요.",
      "target": "code:n * multiply(n - 1)"
    }
  ]
}
