      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "5예요. Rule의 2에 extra 3을 더했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. self.value()를 쓰면 Bonus가 자기 자신을 계속 불러 RecursionError가 나요.",
      "target": "code:super().value()"
    }
  ]
