{
  "by": "hand",
  "source_sha256": "b9fd2e326e757275f3acf681626416416a9cc0bd71aad90c8cd2ec9b83fb744e",
  "entry": [
    {
      "action": "say",
      "text": "UTF-8로 저장한 파일을 다른 규칙으로 읽고 있어요.",
      "target": "text:지금 코드는 이 파일을 ISO_8859_1이라는 다른 문자 인코딩으로 읽어요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "알아볼 수 없는 글자예요. 한글 두 글자의 바이트 여섯 개를 한 바이트씩 다른 글자로 바꿨어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "StandardCharsets.ISO_8859_1",
      "after": "StandardCharsets.UTF_8",
      "say": "저장할 때와 같은 UTF-8로 읽어요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "다음이에요. 같은 규칙으로 읽어서 바이트가 원래 글자로 돌아왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일을 만든 쪽의 인코딩을 모르고 읽으면 오류 없이 글자만 깨질 수 있어요.",
      "target": "code:StandardCharsets.UTF_8"
    }
  ]
}
