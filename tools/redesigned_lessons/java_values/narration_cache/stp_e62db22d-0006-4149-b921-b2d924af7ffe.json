      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "바꾸기 전에는 2가 나와요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "println(2)",
      "after": "println(3)",
      "say": "괄호 안의 2를 3으로 바꿔요."
