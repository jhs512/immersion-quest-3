{
  "by": "hand",
  "source_sha256": "a56892af9e2180afd159d67a1a0dbaf14419eb70b4e1c391b21a2979c39e7c7e",
  "entry": [
    {
      "action": "say",
      "text": "목표는 하나 더한 수량 뒤에 개를 붙이는 거예요. quantity 자체는 바꾸지 않아요.",
      "target": "text:quantity의 값은 그대로 두고 출력할 때만 하나 더해요."
    },
    {
      "action": "say",
      "text": "지금 식은 quantity 뒤에 글자 개와 숫자 1을 +로 연결했어요.",
      "target": "code:quantity + \"개\" + 1"
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "2개1이 나왔어요. 2에 글자 개를 붙여 글자가 됐고, 그 뒤의 1도 글자로 이어 붙었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "quantity + \"개\" + 1",
      "after": "quantity + 1 + \"개\"",
      "say": "숫자끼리의 덧셈을 앞으로 옮겨요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "3개가 나와요. 이 식의 +는 왼쪽부터 계산해요. 2 + 1을 먼저 계산한 뒤 글자 개를 붙여요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int quantity = 2;",
      "after": "int quantity = 7;",
      "say": "수량을 7로 바꿔 같은 식이 통하는지 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "8개예요. 값이 바뀌어도 하나 더한 수량이 나와요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 3개를 글자로 직접 쓰면 수량이 7일 때도 3개가 나와 틀려요.",
      "target": "code:quantity + 1 + \"개\""
    },
    {
      "action": "patch_code",
      "before": "int quantity = 7;",
      "after": "int quantity = 2;",
      "say": "quantity에 저장할 수량을 다시 2로 되돌려요."
    }
  ]
}
