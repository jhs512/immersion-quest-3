{
  "by": "hand",
  "source_sha256": "afe61d14c987a6f1d9eb6ff19153759da54f5e8bc7ba99f195d55a4623f72d75",
  "entry": [
    {
      "action": "say",
      "text": "수량 2에 1을 더해 같은 변수에 다시 저장해요. 그 앞뒤 값을 적는 문제예요.",
      "target": "text:수량 2에 하나를 더해 같은 변수에 저장해요."
    },
    {
      "action": "say",
      "text": "처음 저장한 값은 2예요.",
      "target": "code:int quantity = 2;"
    },
    {
      "action": "fill_answer",
      "value": "{\"before\":\"2\"}",
      "target": "[data-answer-field=\"before\"]",
      "say": "바꾸기 전 칸에는 2를 적어요."
    },
    {
      "action": "say",
      "text": "오른쪽 quantity + 1을 먼저 계산하고, 그 결과를 왼쪽 quantity에 넣어요.",
      "target": "code:quantity = quantity + 1;"
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "3이 나왔어요. 계산한 새 값이 저장됐어요.",
      "target": "output"
    },
    {
      "action": "fill_answer",
      "value": "{\"before\":\"2\",\"after\":\"3\"}",
      "target": "[data-answer-field=\"after\"]",
      "say": "바꾼 뒤 칸에는 3을 적어요."
    },
    {
      "action": "say",
      "text": "조심하세요. 수학의 등식처럼 읽으면 말이 안 되지만, 자바에서는 오른쪽 값을 왼쪽에 넣는 명령이에요.",
      "target": "code:quantity = quantity + 1;"
    }
  ]
}
