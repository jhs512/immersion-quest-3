{
  "by": "hand",
  "source_sha256": "bf7c3d3fb687a35a3bf7480ef68ff58eb012503df5bdf68ad50696b080595948",
  "entry": [
    {
      "action": "say",
      "text": "수량: 이라는 글자 뒤에 저장된 수량을 보여 주려는 출력문이에요.",
      "target": "text:지금 출력문은 변수 이름까지 따옴표 안에 넣었어요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "수량: quantity가 나왔어요. 따옴표 안의 이름은 글자로 찍혀요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\"수량: quantity\"",
      "after": "\"수량: \" + quantity",
      "say": "글자는 따옴표 안에 두고, quantity는 밖으로 꺼내 + 로 이어요."
    },
    {
      "action": "say",
      "text": "따옴표 안은 그대로 보일 글자이고, 따옴표 밖 quantity는 저장된 값으로 바뀌어요.",
      "target": "code:\"수량: \" + quantity"
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "수량: 2가 나왔어요. 글자 뒤에 값 2가 붙었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int quantity = 2;",
      "after": "int quantity = 5;",
      "say": "수량을 5로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "수량: 5예요. 글자 뒤의 숫자가 저장된 값을 따라가요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int quantity = 5;",
      "after": "int quantity = 2;",
      "say": "수량을 다시 2로 돌려놓아요."
    }
  ]
}
