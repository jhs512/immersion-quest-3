{
  "by": "hand",
  "source_sha256": "995b0cd8ef66b8bd9d80da53b0621290ba3038626a67e3867eb0b38e7a8f0ba6",
  "entry": [
    {
      "action": "say",
      "text": "점으로 시작하는 파일을 만들어 보통 목록과 숨김까지 보는 목록을 비교해요.",
      "target": "text:점으로 시작하는 파일을 직접 만들어 볼 거예요."
    },
    {
      "action": "bash_command",
      "command": "echo \"연습 설정\" > .practice",
      "say": ".practice 파일을 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "> 로 저장해서 화면에는 아무것도 나오지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "보통 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo.txt와 notes만 보여요. 방금 만든 .practice는 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls -a",
      "say": "-a 옵션으로 다시 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": ".practice가 보여요. 점으로 시작하는 이름은 -a를 붙여야 목록에 나와요.",
      "target": "#git-demo-terminal"
    }
  ]
}
