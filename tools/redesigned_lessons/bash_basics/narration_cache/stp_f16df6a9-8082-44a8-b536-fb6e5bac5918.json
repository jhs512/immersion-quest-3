  "entry": [
    {
      "action": "say",
      "text": "폴더도 mv로 이름을 바꿔요. notes-copy를 archive로 바꿔요.",
      "target": "text:이번에는 사본 폴더의 이름을 바꿀 거예요."
    },
    {
      "action": "bash_command",
      "command": "mv notes-copy archive",
      "say": "폴더 이름을 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "바깥 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "notes-copy 대신 archive가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls archive",
      "say": "archive 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo.txt가 그대로 들어 있어요. 폴더 이름만 바뀌었어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
