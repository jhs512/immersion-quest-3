{
  "by": "hand",
  "source_sha256": "de39389012124cb7872948ed702810db4c5365856434d068558acd670df1aa4d",
  "entry": [
    {
      "action": "say",
      "text": "memo.txt를 memo-copy.txt로 복사해요. cp 뒤에는 원본, 그다음 사본 이름을 적어요.",
      "target": "text:원본과 사본이 함께 남는지 확인해 보세요."
    },
    {
      "action": "bash_command",
      "command": "cp memo.txt memo-copy.txt",
      "say": "복사해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo-copy.txt와 memo.txt가 둘 다 있어요. 복사는 원본을 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo-copy.txt",
      "say": "사본을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원본과 같은 첫 메모, 둘째 줄이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
