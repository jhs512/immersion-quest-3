{
  "by": "hand",
  "source_sha256": "b9528eb24f2d88ac297627c1b87731de7f5708e8d49f4efa4e234b4cf8c78ee4",
  "entry": [
    {
      "action": "say",
      "text": "바깥의 draft.txt를 notes 안으로 옮겨요. 대상이 폴더면 그 안으로 들어가요.",
      "target": "text:이번에는 notes 안으로 옮길 거예요."
    },
    {
      "action": "bash_command",
      "command": "mv draft.txt notes/",
      "say": "notes/ 로 옮겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "바깥 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "바깥에서는 draft.txt가 없어졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls notes",
      "say": "notes 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "notes 안에 draft.txt와 memo.txt가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat notes/draft.txt",
      "say": "옮긴 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "사본 메모 그대로예요. 위치만 바뀌었어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
