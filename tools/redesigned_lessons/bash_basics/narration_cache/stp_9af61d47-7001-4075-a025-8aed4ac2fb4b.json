{
  "by": "hand",
  "source_sha256": "bb7f9dfb8605069d695a69aac42b6f121f05b923e28d1a249c89862dc1147886",
  "entry": [
    {
      "action": "say",
      "text": "notes 안의 draft.txt 하나만 지워요. rm은 휴지통을 거치지 않고 바로 지워요.",
      "target": "text:rm은 휴지통으로 보내지 않고 삭제해요."
    },
    {
      "action": "bash_command",
      "command": "pwd",
      "say": "먼저 지금 위치를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "바깥 연습 폴더예요. notes/draft.txt라는 경로가 이 위치 기준이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls notes",
      "say": "지울 파일이 있는지 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "draft.txt와 memo.txt가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "rm notes/draft.txt",
      "say": "draft.txt만 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 지워졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls notes",
      "say": "다시 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo.txt만 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. rm은 되돌릴 수 없어요. 그래서 지우기 전에 pwd와 ls로 경로와 대상을 먼저 확인했어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
