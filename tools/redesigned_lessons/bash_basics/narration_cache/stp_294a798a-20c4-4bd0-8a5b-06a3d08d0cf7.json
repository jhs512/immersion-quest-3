{
  "by": "hand",
  "source_sha256": "c9e2a221a405d7c2d06f21509613ab7d020961167a260f31c67920409fcaf8e2",
  "entry": [
    {
      "action": "say",
      "text": "storage/archive는 안에 memo.txt가 있는 폴더예요. 22번의 rmdir로 지워질지부터 확인해요.",
      "target": "text:안에 memo.txt가 들어 있어서 빈 폴더가 아니에요."
    },
    {
      "action": "bash_command",
      "command": "ls storage/archive",
      "say": "지울 폴더 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo.txt가 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "rmdir storage/archive",
      "say": "빈 폴더용 rmdir로 지워 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "Directory not empty라는 실패 메시지가 나와요. 내용이 있으면 rmdir는 지우지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "rm -r storage/archive",
      "say": "그래서 폴더와 안의 내용을 함께 지우는 rm -r을 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 지워졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls storage",
      "say": "storage 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "비어 있어요. archive와 그 안의 memo.txt가 함께 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. rm -r은 폴더 안의 모든 파일까지 한꺼번에 지워요. 원본 notes가 아닌 연습 사본 경로인지 꼭 확인해요.",
      "target": "text:원본 notes는 남겨 두세요."
    }
  ]
}
