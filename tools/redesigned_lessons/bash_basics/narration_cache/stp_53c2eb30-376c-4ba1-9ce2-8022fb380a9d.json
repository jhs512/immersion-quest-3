      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "경로 끝에 notes가 붙었어요. 위치가 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "여기 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "비어 있어요. 바깥의 memo.txt는 notes 안에 있지 않아요.",
      "target": "#git-demo-terminal"
