{
  "by": "hand",
  "source_sha256": "1d5b01ae31bf671e76bd3b1bcfcbb836b25d15582db09c53907f5d12ceff79db",
  "entry": [
    {
      "action": "say",
      "text": "storage 폴더를 만들고 archive를 안의 파일째 그 안으로 옮겨요.",
      "target": "text:새 보관 폴더를 만들고 그 안으로 옮길 거예요."
    },
    {
      "action": "bash_command",
      "command": "mkdir storage",
      "say": "storage 폴더를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "7번의 mkdir처럼 조용히 만들어졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "mv archive storage/",
      "say": "archive를 storage 안으로 옮겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "바깥 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "archive는 사라지고 storage가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls storage",
      "say": "storage 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "archive가 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat storage/archive/memo.txt",
      "say": "옮긴 폴더 안의 메모를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 메모, 둘째 줄이에요. 폴더를 옮기면 안의 파일도 함께 가요.",
      "target": "#git-demo-terminal"
    }
  ]
}
