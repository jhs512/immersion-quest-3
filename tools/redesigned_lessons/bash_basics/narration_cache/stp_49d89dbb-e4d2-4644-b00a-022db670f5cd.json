  "entry": [
    {
      "action": "say",
      "text": "notes에서 한 단계 위, 바깥 폴더로 돌아가요. 두 점 ..은 상위 폴더를 뜻해요.",
      "target": "text:이번에는 바깥 폴더로 돌아갈 거예요."
    },
    {
      "action": "bash_command",
      "command": "cd ..",
      "say": "cd .. 로 한 단계 올라가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "프롬프트가 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "pwd",
      "say": "경로를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "경로 끝의 notes가 빠졌어요. 처음 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "say": "여기서 memo.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 메모와 둘째 줄이에요. 9번에서 만든 폴더 안 메모가 아니라 바깥 파일이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
