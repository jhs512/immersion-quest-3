{
  "by": "hand",
  "source_sha256": "f6fda9f1fe072a8ea3e4b9571f56d99628447859b03a531b9a7710d746628c5b",
  "entry": [
    {
      "action": "say",
      "text": "notes 폴더를 안의 파일까지 통째로 복사해 notes-copy를 만들어요.",
      "target": "text:notes 폴더와 그 안의 파일을 함께 복사할 거예요."
    },
    {
      "action": "bash_command",
      "command": "cp -R notes notes-copy",
      "say": "-R 옵션으로 폴더째 복사해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "바깥 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "notes 옆에 notes-copy가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls notes-copy",
      "say": "사본 폴더 안을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo.txt가 함께 복사됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat notes-copy/memo.txt",
      "say": "사본 폴더의 메모를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "15번에서 덮어쓴 첫 메모, 둘째 줄이에요. 복사할 때의 내용이 그대로 왔어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
