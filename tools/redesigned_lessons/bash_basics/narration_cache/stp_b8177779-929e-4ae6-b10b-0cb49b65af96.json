{
  "by": "hand",
  "source_sha256": "e4640681ad3176edfef115ec39f78aa8d125ca5b6c62df82aa84ada5f410a7ed",
  "entry": [
    {
      "action": "say",
      "text": "빈 폴더 empty를 만들고 rmdir로 지워요. rmdir는 빈 폴더 전용이에요.",
      "target": "text:내용이 없는 폴더는 rmdir로 지울 수 있어요."
    },
    {
      "action": "bash_command",
      "command": "mkdir empty",
      "say": "empty 폴더를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안에 아무것도 없는 폴더가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "empty가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "rmdir empty",
      "say": "rmdir로 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 지워졌어요. 안이 비어 있어서 가능했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "다시 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "empty가 없어졌어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
