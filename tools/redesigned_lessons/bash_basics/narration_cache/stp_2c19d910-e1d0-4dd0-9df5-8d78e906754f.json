  "entry": [
    {
      "action": "say",
      "text": "memo-copy.txt의 이름을 draft.txt로 바꿔요. mv는 이름 바꾸기에도 써요.",
      "target": "text:사본 파일의 이름을 바꿀 거예요."
    },
    {
      "action": "bash_command",
      "command": "mv memo-copy.txt draft.txt",
      "say": "mv로 이름을 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "draft.txt가 생기고 memo-copy.txt는 사라졌어요. 복사와 달리 이전 이름이 남지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat draft.txt",
      "say": "draft.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "14번의 사본 메모예요. 이름만 바뀌고 내용은 그대로예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
