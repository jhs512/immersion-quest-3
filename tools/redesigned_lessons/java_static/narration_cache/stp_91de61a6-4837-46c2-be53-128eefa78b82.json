  "entry": [
    {
      "action": "say",
      "text": "이번 스텝에 제공된 코드로 설명할게요. 직접 작성한 답은 해설 뒤에도 유지돼요.",
      "target": "problem"
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        17,
        17
      ]
    },
    {
      "action": "say",
      "text": "매번 일로 덮어써서 결과는 일이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "created = 1;",
      "after": "created++;",
      "say": "기존 생성 수에 하나씩 더해요."
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        17,
        17
      ]
    },
    {
      "action": "say",
      "text": "두 객체를 만들어 공유 생성 수가 이예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 둘을 고정 출력하면 빈 실행과 다른 개수를 놓쳐요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 2;",
      "after": "count = 0;",
      "say": "하나도 만들지 않는 경우도 확인해요."
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        17,
        17
      ]
    },
    {
      "action": "say",
      "text": "생성하지 않아 처음 값 영이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 0;",
      "after": "count = 2;",
      "say": "처음 생성 개수로 돌아와요."
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        17,
        17
      ]
    },
    {
      "action": "say",
      "text": "공유 범위와 누적 규칙을 함께 확인했어요.",
      "target": "output"
    }
  ]
