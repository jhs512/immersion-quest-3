{
  "by": "hand",
  "source_sha256": "92be0925a9208e4c5a2b526032e6ee32d24ee2a105db5d4106d697be2db92940",
  "entry": [
    {
      "action": "say",
      "text": "제목은 HTML에 들어가도 글자로만 보여야 해요.",
      "target": "text:제목이 태그가 아니라 글자로 보이게 하세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "h1 안에 script 태그가 그대로 들어갔어요. 브라우저는 이걸 실행할 코드로 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "'<h1>' + title + '</h1>'",
      "after": "'<h1>' + html.escape(title) + '</h1>'",
      "say": "title을 html.escape로 감싸요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "<가 &lt;, >가 &gt;로 바뀌었어요. 브라우저는 이제 기호 글자로 보여 줘요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "title = '<script>steal()</script>'",
      "after": "title = 'Tom & Jerry'",
      "say": "&가 든 평범한 제목도 넣어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "&가 &amp;로 바뀌었어요. 화면에는 Tom & Jerry가 그대로 보여요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. <script>라는 글자만 지우면 </script>는 남고, 다른 태그는 못 막아요. 지우지 말고 바꾸세요.",
      "target": "code:html.escape(title)"
    }
  ]
}
