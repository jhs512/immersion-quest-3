{
  "by": "hand",
  "source_sha256": "441dfe64d77943d81a0cd847b0eacbaf1477f4caf09babdff3d805a2a8c8402c",
  "entry": [
    {
      "action": "say",
      "text": "view가 받은 좋아요 수를 화면에 쓰게 고치세요. 버튼마다 다른 자료를 넘겨요.",
      "target": "text:view가 받은 좋아요 수를 화면에 쓰게 고치세요. 버튼마다 다른 자료를 넘겨요."
    },
    {
      "action": "say",
      "text": "현재 자료를 넣으면 어떤 화면이어야 하는지 돌려주는 함수를 만들 수 있어요.",
      "target": "text:현재 자료를 넣으면 어떤 화면이어야 하는지 돌려주는 함수를 만들 수 있어요."
    },
    {
      "action": "say",
      "text": "고정된 0 대신 받은 state의 count를 화면 문자열에 넣어요.",
      "target": "code:`<output>0</output>`"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "현재 자료 0을 넣은 화면이 보여요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#many",
      "say": "다른 자료 7도 같은 함수에 넣어 봐요."
    },
    {
      "action": "say",
      "text": "자료 7을 줘도 고정된 0만 나와요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "`<output>0</output>`",
      "after": "`<output>${state.count}</output>`",
      "say": "고정된 0 대신 받은 state의 count를 화면 문자열에 넣어요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "새 함수도 자료 0에서는 0을 돌려줘요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#many",
      "say": "다른 자료 7도 같은 함수에 넣어 봐요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "함수에 넣은 자료 7이 화면에 나와요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
