{
  "by": "hand",
  "source_sha256": "3ccc64cc5ddc7c332a9aa5fc34f98032a5c9a78c8a829fc0edf6ac6a6488b62d",
  "entry": [
    {
      "action": "say",
      "text": "제목 글은 Header 안이 아니라 부모 App이 넘기는 title에서 와요.",
      "target": "text:Header 컴포넌트는 부모 App이 넘긴 title 값을 제목에 써요."
    },
    {
      "action": "say",
      "text": "Header는 받은 title을 중괄호로 끼워 넣어요.",
      "target": "code:return <h1>{title}</h1>;"
    },
    {
      "action": "say",
      "text": "값은 App의 이 자리에서 넘겨요.",
      "target": "code:title=\"임시 목록\""
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "임시 목록이 보여요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "title=\"임시 목록\"",
      "after": "title=\"내 글 목록\"",
      "say": "넘기는 값만 내 글 목록으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "부모에서 바꾼 값이 자식 제목에 보여요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. Header 안에 글을 직접 적으면, 다른 제목을 넘겨도 늘 같은 글만 보여요.",
      "target": "code:function Header({ title })"
    }
  ]
}
