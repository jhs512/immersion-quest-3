{
  "by": "hand",
  "source_sha256": "4c07a8b4a8f90bff3a748d63cd8a6cbbe743759af80523c7569697be3f91baf6",
  "entry": [
    {
      "action": "say",
      "text": "위쪽과 아래쪽 수량이 항상 같아야 해요. 아래쪽에 고정된 값 대신 부모 상태를 전달하세요.",
      "target": "text:위쪽과 아래쪽 수량이 항상 같아야 해요. 아래쪽에 고정된 값 대신 부모 상태를 전달하세요."
    },
    {
      "action": "say",
      "text": "함께 바뀌어야 하는 값은 가장 가까운 공통 부모가 소유하고 자식에게 전달해요.",
      "target": "text:함께 바뀌어야 하는 값은 가장 가까운 공통 부모가 소유하고 자식에게 전달해요."
    },
    {
      "action": "say",
      "text": "Summary에는 부모 count 대신 고정값 0을 넘겨요.",
      "target": "code:<Summary count={0} />"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "두 표시 모두 시작 값 0이에요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#increase",
      "say": "공유해야 하는 숫자를 바꿔 봐요."
    },
    {
      "action": "say",
      "text": "위 숫자만 1이고 아래는 0으로 남아요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "<Summary count={0} />",
      "after": "<Summary count={count} />",
      "say": "자식에게 부모의 count를 넘겨 별도 복사본이 생기지 않게 해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "같은 상태를 전달한 화면도 0에서 시작해요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#increase",
      "say": "공유해야 하는 숫자를 바꿔 봐요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "부모 상태 한 번의 변경으로 둘 다 1이 돼요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
