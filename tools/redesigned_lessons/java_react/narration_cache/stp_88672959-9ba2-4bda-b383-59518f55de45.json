{
  "by": "hand",
  "source_sha256": "7b3acc9f94e0b2970052fc5daddf9f023c2f6b330315b85bf2557195de4be2a9",
  "entry": [
    {
      "action": "say",
      "text": "두 카운터가 전역 total을 섞어 쓰고 있어요. 각자 처음 클릭에서 1이 나오게 고치세요.",
      "target": "text:두 카운터가 전역 total을 섞어 쓰고 있어요. 각자 처음 클릭에서 1이 나오게 고치세요."
    },
    {
      "action": "say",
      "text": "같은 컴포넌트를 두 번 그리면 각 위치의 상태는 따로 저장돼요.",
      "target": "text:같은 컴포넌트를 두 번 그리면 각 위치의 상태는 따로 저장돼요."
    },
    {
      "action": "say",
      "text": "두 카운터가 전역 total을 올린 값을 자기 상태에 넣어요.",
      "target": "code:total++; setCount(total);"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "두 카운터 모두 각자의 상태 0을 보여요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#a",
      "say": "첫 카운터의 상태부터 올려요."
    },
    {
      "action": "say",
      "text": "첫 카운터가 1을 보여요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#b",
      "say": "다른 카운터를 처음 눌러 봐요."
    },
    {
      "action": "say",
      "text": "전역 total이 이미 늘어서 두 번째는 2가 돼요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "total++; setCount(total);",
      "after": "setCount(c => c + 1);",
      "say": "전역 total 대신 이 Counter의 이전 상태에만 1을 더해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "화면의 같은 위치에 서로 독립된 상태가 준비돼요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#a",
      "say": "첫 카운터의 상태부터 올려요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "첫 카운터의 지역 상태만 1로 바뀌어요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#b",
      "say": "다른 카운터를 처음 눌러 봐요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "두 번째도 자기 첫 클릭이라 1이 돼요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
