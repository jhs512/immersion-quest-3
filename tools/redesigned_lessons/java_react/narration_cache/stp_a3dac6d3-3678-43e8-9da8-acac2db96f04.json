{
  "by": "hand",
  "source_sha256": "968650d733feed1eb90e8ca65db1b65e95758defade79c3fb149a937574eec29",
  "entry": [
    {
      "action": "say",
      "text": "수량이 바뀌면 가격도 바뀌어야 해요. 가격을 고정 문구로 두지 말고 계산하세요.",
      "target": "text:수량이 바뀌면 가격도 바뀌어야 해요. 가격을 고정 문구로 두지 말고 계산하세요."
    },
    {
      "action": "say",
      "text": "렌더링을 다시 하면 그 상태를 사용한 모든 화면 식을 다시 계산해요.",
      "target": "text:렌더링을 다시 하면 그 상태를 사용한 모든 화면 식을 다시 계산해요."
    },
    {
      "action": "say",
      "text": "수량을 한 번 바꾸면 가격 식도 다시 계산되게 연결해요.",
      "target": "code:<p id=\"price\">100</p>"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "수량 1과 가격 100이 보여요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#add",
      "say": "수량과 가격의 관계를 한 번 바꿔 봐요."
    },
    {
      "action": "say",
      "text": "수량은 2인데 가격은 여전히 100이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "<p id=\"price\">100</p>",
      "after": "<p id=\"price\">{quantity * 100}</p>",
      "say": "수량을 한 번 바꾸면 가격 식도 다시 계산되게 연결해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "곱셈식도 처음 수량에서는 100을 계산해요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#add",
      "say": "수량과 가격의 관계를 한 번 바꿔 봐요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "수량 2에서 계산한 가격 200이 함께 보여요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
