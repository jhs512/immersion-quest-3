{
  "by": "hand",
  "source_sha256": "37b485fe7160435d0052d328c00ea9811004d20b40d41ad7e9748e8ac08264a4",
  "entry": [
    {
      "action": "say",
      "text": "클릭할 때 다음 숫자를 계산만 하고 있어요. React가 다음 화면을 그리게 고치세요.",
      "target": "text:클릭할 때 다음 숫자를 계산만 하고 있어요. React가 다음 화면을 그리게 고치세요."
    },
    {
      "action": "say",
      "text": "상태 설정 함수는 다음 렌더링을 요청해요. 계산식만 평가하면 화면은 그대로예요.",
      "target": "text:상태 설정 함수는 다음 렌더링을 요청해요. 계산식만 평가하면 화면은 그대로예요."
    },
    {
      "action": "say",
      "text": "클릭하면 count + 1을 계산만 하고 setCount는 부르지 않아요.",
      "target": "code:count + 1;"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "현재 상태 0을 그린 화면이에요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#plus",
      "say": "계산과 갱신 요청의 차이를 클릭으로 봐요."
    },
    {
      "action": "say",
      "text": "계산만 해서 화면은 0으로 남아요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "count + 1;",
      "after": "setCount(count + 1);",
      "say": "다음 값을 setCount에 넘겨 React에 갱신을 요청해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "수정 후에도 처음 상태는 0에서 시작해요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "click",
      "selector": "#plus",
      "say": "계산과 갱신 요청의 차이를 클릭으로 봐요. 수정한 흐름도 확인해요."
    },
    {
      "action": "say",
      "text": "다음 상태로 다시 그려 숫자 1이 보여요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
