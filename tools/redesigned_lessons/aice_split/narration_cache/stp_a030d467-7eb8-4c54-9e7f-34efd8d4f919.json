  "entry": [
    {
      "action": "say",
      "text": "같은 위치의 입력과 정답이 한 배송이에요. 입력 5가 있는 자리를 찾아 그 자리의 정답을 꺼내야 해요.",
      "target": "text:answer 줄을 고쳐 입력 5가 있는 자리의 정답을 꺼내세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "40이에요. y[5]는 여섯째 자리, 입력 4의 정답이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "answer = y[5]\n",
      "after": "answer = y[X.index(5)]\n",
      "say": "X.index(5)로 5의 자리를 찾아 y의 같은 자리를 읽어요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "50이에요. 입력 5는 둘째 자리이고 같은 자리의 정답이 50이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 값 5와 자리 5는 달라요. 자리는 0부터 세요.",
      "target": "code:X.index(5)"
    }
  ]
}
