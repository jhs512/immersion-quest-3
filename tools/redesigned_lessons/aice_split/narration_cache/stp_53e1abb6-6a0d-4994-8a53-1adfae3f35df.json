    },
    {
      "action": "run",
      "lines": [
        6,
        8
      ]
    },
    {
      "action": "say",
      "text": "large와 0.79예요. 테스트 점수를 보고 골라 마지막 평가가 고르는 데 쓰였어요.",
      "target": "output"
