  "entry": [
    {
      "action": "say",
      "text": "버퍼의 한 칸에 VALUE번 페이지가 있어요. 같은 페이지를 다시 읽을 때 적중 여부를 구하세요.",
      "target": "text:버퍼의 한 칸에 VALUE번 페이지가 있어요. 같은 페이지를 다시 읽을 때 적중 여부를 구하세요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "지금 출력은 적중 false, 페이지 6예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "loaded != requested 부분에서 요구한 관계를 계산하고 있는지 봐요.",
      "target": "code:loaded != requested"
    },
    {
      "action": "patch_code",
      "before": "loaded != requested",
      "after": "loaded == requested",
      "say": "loaded == requested로 바꿔 비교해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "요청한 페이지가 이미 들어 있어요. 다음에는 다른 페이지가 들어올 때 빈 공간을 살펴봐요.",
      "target": "output"
    },
    {
      "action": "submit"
    }
  ]
}
