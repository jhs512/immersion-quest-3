  "entry": [
    {
      "action": "say",
      "text": "두 글 중 입력 번호의 글 하나를 지워요. 남은 글의 번호는 그대로 둬야 해요.",
      "target": "text:두 글에서 입력 번호 하나를 삭제해요."
    },
    {
      "action": "say",
      "text": "지금은 글을 읽기만 하고 있어요.",
      "target": "code:return records.get(id);"
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "시작이라는 내용은 나왔지만 번호 1이 남아 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return records.get(id);",
      "after": "return records.remove(id);",
      "say": "remove로 삭제하면서 지운 값을 돌려줘요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "글 1이 없어지고 번호 2는 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 글 1을 지웠다고 글 2를 1로 바꾸면 기존 글 2를 가리키던 요청이 깨져요.",
      "target": "code:return records.remove(id);"
    }
  ]
}
