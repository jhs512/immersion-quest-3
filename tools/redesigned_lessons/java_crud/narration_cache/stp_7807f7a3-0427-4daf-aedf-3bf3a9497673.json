  "entry": [
    {
      "action": "say",
      "text": "빈 저장소에 입력 두 줄을 차례로 추가해요. 번호는 1부터 하나씩 늘어야 해요.",
      "target": "text:빈 저장소에 입력 두 줄을 차례로 추가해요."
    },
    {
      "action": "say",
      "text": "nextId를 이번 번호로 쓰고 그대로 두고 있어요.",
      "target": "code:int id = nextId;"
    },
    {
      "action": "run",
      "lines": [
        19,
        19
      ]
    },
    {
      "action": "say",
      "text": "두 번 모두 1이에요. 첫 글 자리까지 다음 글이 덮어썼어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int id = nextId;",
      "after": "int id = nextId++;",
      "say": "이번 번호를 꺼낸 뒤 다음 번호를 하나 올려요."
    },
    {
      "action": "run",
      "lines": [
        19,
        19
      ]
    },
    {
      "action": "say",
      "text": "1과 2예요. 두 글이 다른 번호로 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 글의 내용이 같아도 다른 글일 수 있어요. 내용으로 번호를 정하지 마세요.",
      "target": "code:int id = nextId++;"
    }
  ]
}
