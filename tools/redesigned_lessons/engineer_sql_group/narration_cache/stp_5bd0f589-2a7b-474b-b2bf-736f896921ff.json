  "entry": [
    {
      "action": "say",
      "text": "NULL이 있는 열을 셀 때 COUNT의 괄호 안이 무엇이냐에 따라 달라지는 문제예요.",
      "target": "text:COUNT(*)는 몇을 셀까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "별표는 재고가 NULL인 행도 세어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(*)",
      "after": "COUNT(qty)",
      "say": "COUNT(*)를 COUNT(qty)로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "열을 지정하면 그 열의 NULL은 빼요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. COUNT(*)와 COUNT(열)의 대상이 다를 수 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(qty)",
      "after": "COUNT(*)"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 SQL은 NULL 행도 세서 4예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "rows"
    }
  ]
}
