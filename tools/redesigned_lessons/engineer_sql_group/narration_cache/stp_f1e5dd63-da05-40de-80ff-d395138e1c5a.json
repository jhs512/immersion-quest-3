  "entry": [
    {
      "action": "say",
      "text": "분류 값이 A, A, B, B예요. 중복을 뺀 분류의 수를 세야 해요.",
      "target": "text:질의를 고쳐 중복 없는 분류의 수를 세세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "4예요. 분류가 있는 행을 모두 세었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(category)",
      "after": "COUNT(DISTINCT category)",
      "say": "COUNT 괄호 안에 DISTINCT를 써요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "2예요. A와 B 두 종류예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. SELECT DISTINCT COUNT(category)는 결과 한 행의 중복을 없앨 뿐이라 여전히 4예요.",
      "target": "code:COUNT(DISTINCT category)"
    }
  ]
}
