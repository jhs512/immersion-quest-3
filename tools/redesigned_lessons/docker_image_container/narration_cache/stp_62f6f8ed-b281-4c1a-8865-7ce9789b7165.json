{
  "by": "hand",
  "source_sha256": "0b5974babefb38ac85cb66967da9226055a6381a75d3a82f50f94a38c5f87027",
  "entry": [
    {
      "action": "say",
      "text": "지금 Nginx가 실행 중이에요. 컨테이너는 남기고 실행만 멈춰야 해요.",
      "target": "text:컨테이너를 지우지 말고 서버만 멈추세요."
    },
    {
      "action": "bash_command",
      "command": "docker stop \"$BOX\"",
      "say": "stop은 서버를 멈추고 컨테이너는 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "멈춘 컨테이너의 이름이 출력됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker ps -a",
      "say": "-a를 붙이면 멈춘 컨테이너도 표에 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "STATUS가 Exited예요. 컨테이너는 지워지지 않고 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 멈추기와 삭제는 달라요. rm으로 지우면 다시 시작할 컨테이너도 없어져요.",
      "target": "text:rm은 삭제하는 다른 명령이에요."
    }
  ]
}
