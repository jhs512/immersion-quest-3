{
  "by": "hand",
  "source_sha256": "396b795b35dfea887fb45d401b9bd1fcae746ef5c0341e26b370362d35ca1f82",
  "entry": [
    {
      "action": "say",
      "text": "앱을 고쳐 다시 빌드하면 메모가 사라지는 문제예요.",
      "target": "text:앱을 고칠 때마다 메모가 사라지면 쓸 수 없어요."
    },
    {
      "action": "bash_command",
      "command": "cat add.sh",
      "say": "먼저 메모를 쓰는 add.sh를 읽을게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "add.sh는 메모를 /data/memo.txt에 써요. 이 폴더가 핵심이에요.",
      "target": "text:add.sh와 show.sh를 읽고, 메모가 실제로 어느 폴더에 저장되는지 찾으세요."
    },
    {
      "action": "say",
      "text": "build 줄 때문에 up --build가 이미지를 새로 만들고, 그 이미지로 컨테이너도 새로 만들어요.",
      "target": "code:build: ."
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --build",
      "say": "앱 이미지를 빌드하고 실행해요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "이미지를 빌드하고 app 컨테이너를 시작했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec app sh /app/add.sh 우유",
      "say": "메모 우유를 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "add.sh가 /data/memo.txt에 우유를 썼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "patch_code",
      "before": "[v1]",
      "after": "[v2]",
      "say": "앱을 고쳐요. 버전 표시를 v2로 바꿔요.",
      "file": "show.sh"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --build --force-recreate",
      "say": "고친 앱으로 이미지와 컨테이너를 새로 만들어요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "바뀐 show.sh가 든 이미지로 컨테이너를 새로 만들었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec app sh /app/show.sh",
      "say": "버전과 메모를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "v2로 바뀌었는데 메모는 없음이에요. /data가 옛 컨테이너의 쓰기 레이어에 있었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "patch_code",
      "before": "    # 고칠 곳: 앱이 메모를 쓰는 폴더가 지금은 컨테이너 안에만 있어요.\n",
      "after": "    # add.sh는 /data에 메모를 써요. 그 폴더에 볼륨을 연결해요.\n    # 앱 코드는 이미지에, 메모 데이터는 볼륨에 있어서 이미지를 바꿔도 메모가 남아요.\n    volumes:\n      - memos:/data\n\nvolumes:\n  memos:\n",
      "say": "/data에 memos 볼륨을 연결하고 선언해요.",
      "file": "compose.yaml"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --build",
      "say": "바꾼 파일로 다시 실행해요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "볼륨 memos를 만들고 컨테이너를 새로 만들었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec app sh /app/add.sh 우유",
      "say": "우유를 다시 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번 메모는 볼륨에 저장됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --build --force-recreate",
      "say": "컨테이너를 다시 새로 만들어요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "컨테이너는 또 새것이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec app sh /app/show.sh",
      "say": "버전과 메모를 다시 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "v2와 우유가 함께 보여요. 새 컨테이너가 같은 볼륨을 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이미지는 새것으로 바뀌었고, 메모는 볼륨에 있어서 그대로예요. 코드와 데이터가 다른 곳에 있어요.",
      "target": "text:볼륨은 연결한 폴더의 데이터만 지켜요."
    }
  ]
}
