  "entry": [
    {
      "action": "say",
      "text": "만 원 미만 배송비는 2000원이에요. 9999원 주문의 실제 배송비를 기대값 2000과 비교해요.",
      "target": "text:준비 코드는 9999원 주문을 검사해요."
    },
    {
      "action": "say",
      "text": "지금은 값이 같을 때 오류를 던지고 있어요.",
      "target": "code:if (actual == expected)"
    },
    {
      "action": "run",
      "lines": [
        19,
        19
      ]
    },
    {
      "action": "say",
      "text": "요구에 맞는 배송비인데 검사가 실패했어요. 비교 방향이 반대예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "if (actual == expected)",
      "after": "if (actual != expected)",
      "say": "다를 때만 AssertionError를 던지게 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        19,
        19
      ]
    },
    {
      "action": "say",
      "text": "ok예요. 요구와 실제 값이 같아 검사가 끝났어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 확인 코드를 없애면 틀린 기대값도 통과해요. 다른 기대값을 넣었을 때는 실패해야 해요.",
      "target": "code:if (actual != expected)"
    }
  ]
}
