    },
    {
      "action": "say",
      "text": "호출이 정상으로 끝나든 예외가 나든 false를 돌려줘요.",
      "target": "code:        } catch (IllegalArgumentException error) {\n            return false;\n"
    },
    {
      "action": "run",
      "lines": [
        23,
        23
      ]
    },
    {
      "action": "say",
      "text": "false예요. 음수 주문이 거절됐는데 검사 결과에 반영하지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "        } catch (IllegalArgumentException error) {\n            return false;\n",
      "after": "        } catch (IllegalArgumentException error) {\n            return true;\n",
