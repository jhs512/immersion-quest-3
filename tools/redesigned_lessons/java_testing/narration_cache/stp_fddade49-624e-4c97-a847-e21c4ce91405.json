    {
      "action": "patch_code",
      "before": "int expected = 2000;",
      "after": "int expected = 0;",
      "say": "요구에 맞춰 기대값을 0으로 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "true예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 검사가 실패했다고 구현부터 고치면, 맞는 구현을 틀리게 바꿀 수 있어요.",
      "target": "text:규칙상 10,000원은 무료예요."
    },
    {
      "action": "patch_code",
      "before": "int expected = 0;",
      "after": "int expected = 2000;",
      "say": "원래 잘못 적힌 기대로 돌아와요."
