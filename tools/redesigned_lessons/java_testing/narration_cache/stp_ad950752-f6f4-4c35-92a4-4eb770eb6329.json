  "entry": [
    {
      "action": "say",
      "text": "요구는 만 원부터 무료인데 Fees는 경계에서 틀려요. 입력 10000으로 검사해요.",
      "target": "text:제공한 Fees에는 경계 오류가 있어요."
    },
    {
      "action": "say",
      "text": "기대값도 실제 구현을 불러서 가져오고 있어요.",
      "target": "code:return Fees.shipping(amount);"
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "true예요. 같은 결과를 두 번 얻어서 결함을 놓쳤어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return Fees.shipping(amount);",
      "after": "return amount >= 10000 ? 0 : 2000;",
      "say": "만 원부터 무료라는 요구로 기대값을 계산해요."
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "false예요. 검사가 경계 오류를 드러냈어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 실제 값과 기대값을 같은 구현에서 구하면 두 값이 함께 틀려도 통과해요.",
      "target": "code:return amount >= 10000 ? 0 : 2000;"
    }
  ]
}
