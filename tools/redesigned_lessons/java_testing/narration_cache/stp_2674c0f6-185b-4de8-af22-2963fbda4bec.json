    {
      "action": "patch_code",
      "before": "if (amount < 0) throw new IllegalArgumentException(\"negative\");",
      "after": "if (amount < 0) return 0;",
      "say": "거절 대신 0을 돌려주게 잘못 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "no-error예요. 이 검사가 잘못된 변경을 잡아냈어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 거절해야 할 입력을 조용히 0으로 처리하면 배송비가 맞아 보여도 요구와 달라요.",
      "target": "code:if (amount < 0) return 0;"
    },
    {
      "action": "patch_code",
      "before": "if (amount < 0) return 0;",
      "after": "if (amount < 0) throw new IllegalArgumentException(\"negative\");",
      "say": "원래 구현으로 돌아와요."
