{
  "by": "hand",
  "source_sha256": "98a4c4542d9d3de377fbc19a17ad34b8ea1ba10d7c9f2a33f889b18c0a57dea3",
  "entry": [
    {
      "action": "say",
      "text": "요구는 10000원부터 무료인데 구현은 그 경계에서만 틀려요. 검사할 금액은 아직 9999 하나예요.",
      "target": "text:제공한 구현은 그 경계에서만 틀려요."
    },
    {
      "action": "say",
      "text": "현재 입력은 무료배송 바로 전 금액 하나뿐이에요.",
      "target": "code:return new int[]{9999};"
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "9999원 사례는 통과했어요. 경계의 결함은 아직 드러나지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return new int[]{9999};",
      "after": "return new int[]{9999, 10000};",
      "say": "배열에 무료배송이 시작되는 금액을 더해요."
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "9999원은 통과하고 10000원은 실패해요. 경계 사례가 결함을 잡았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 기존 사례를 경계 하나로 바꾸면 이전에 확인하던 유료배송 검사가 사라져요.",
      "target": "code:return new int[]{9999, 10000};"
    }
  ]
}
