  "entry": [
    {
      "action": "say",
      "text": "scikit-learn의 입력은 행마다 특성 목록이 있는 2차원 모양이에요. 배송 한 건, 특성 하나를 어떤 모양으로 넘기는지 골라요.",
      "target": "text:한 행 한 열인 새 거리를 넘기려 해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "1차원 입력이라 모양 오류가 났어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "X_test = [4]",
      "after": "X_test = [[4]]",
      "say": "한 행 안에 한 특성을 담아요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "한 행 한 열을 받아 40.0을 예측해요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 한 특성이어도 행과 열의 축은 구별해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "X_test = [[4]]",
      "after": "X_test = [4]",
      "say": "문제의 원래 입력으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "원래 일차원 입력은 여전히 오류예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "matrix"
    }
  ]
}
