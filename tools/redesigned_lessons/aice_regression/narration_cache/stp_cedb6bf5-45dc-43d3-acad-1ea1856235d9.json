    {
      "action": "run",
      "lines": [
        12,
        12
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "ValueError예요. [4]는 행과 열이 없는 1차원이라 몇 행인지 알 수 없어요.",
      "target": "output"
