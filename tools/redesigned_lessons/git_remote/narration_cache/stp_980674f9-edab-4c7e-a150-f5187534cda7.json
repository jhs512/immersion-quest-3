{
  "by": "hand",
  "source_sha256": "a4e03888b36915495c12101a34e8748e1f04e845eeccb40af5c5fc33e708e62a",
  "entry": [
    {
      "action": "say",
      "text": "이 스텝은 팀과 기록을 주고받을 공유 저장소를 실습 폴더 안에 만들고, 내 저장소에 그 주소를 origin이라는 이름으로 연결하는 일이에요. --bare 저장소는 작업 파일 없이 기록만 보관해요.",
      "target": "text:이번에는 GitHub 대신 실습 폴더에 공유 저장소를 만들어요."
    },
    {
      "action": "git_command",
      "args": [
        "init"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 폴더에 Git 저장소가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "init",
        "--bare",
        "../remote.git"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "실습 폴더 안에 기록을 주고받을 공유 저장소가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "remote",
        "add",
        "origin",
        "../remote.git"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin이라는 이름으로 공유 저장소 주소를 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "remote",
        "-v"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin의 받기·보내기 주소가 보여요. 아직 커밋은 보내지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. origin은 주소에 붙인 이름이에요. 연결만 해서는 커밋을 보내지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
