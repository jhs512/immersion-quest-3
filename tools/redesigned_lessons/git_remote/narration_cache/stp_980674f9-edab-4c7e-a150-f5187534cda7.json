{
  "by": "hand",
  "source_sha256": "cb47e512fa3b9aca911880ed3f943c151c5235c28cc66bcd24dae07c17ba217b",
  "entry": [
    {
      "action": "say",
      "text": "여러분은 메모 서비스 팀의 새 팀원이에요. 안내문 공유를 맡았어요.\n이번에는 GitHub 대신 실습 폴더에 공유 저장소를 만들어요.\n--bare는 작업 파일 없이 기록을 보관하는 저장소예요.\norigin은 연결할 주소에 붙이는 짧은 이름이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "init"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 폴더에 Git 저장소가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "init",
        "--bare",
        "../remote.git"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "실습 폴더 안에 기록을 주고받을 공유 저장소가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "remote",
        "add",
        "origin",
        "../remote.git"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin이라는 이름으로 공유 저장소 주소를 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "remote",
        "-v"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin의 받기·보내기 주소가 보여요. 아직 커밋은 보내지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. origin은 주소에 붙인 이름이에요. 연결만 해서는 커밋을 보내지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
