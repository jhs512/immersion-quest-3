  "entry": [
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "같은 원격 기록을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격 추적 참조만 최신으로 맞춰요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "현재 기록을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "base가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "받은 기록을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "shared가 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 현재 파일과 받아 둔 기록이 다르다고 바로 오류인 것은 아니에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "notmerged"
    }
  ]
