{
  "by": "hand",
  "source_sha256": "c7115a98424bde909d09c3728856d6ae3403f7ae4714cb62ba83f18fb9911472",
  "entry": [
    {
      "action": "say",
      "text": "내 작업 파일과 현재 커밋에는 base가 있어요. 이 문제에서는 아직 git fetch를 실행하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "먼저 git fetch origin으로 원격의 커밋을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 받은 커밋을 가리켜요. 내 main은 아직 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "내 현재 커밋에 담긴 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "base가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "원격에서 받은 커밋의 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "여기에는 shared가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. fetch에 성공해도 내 main에 병합하기 전에는 내용이 다를 수 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "notmerged"
    }
  ]
}
