  "entry": [
    {
      "action": "say",
      "text": "같은 안내문인데 두 내용이 달라요. 방금 한 행동으로 판단해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받아 둔 기록에는 문의 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 main에는 메모 안내만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 받은 기록과 내 main이 달라도 fetch가 실패한 것은 아니에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
