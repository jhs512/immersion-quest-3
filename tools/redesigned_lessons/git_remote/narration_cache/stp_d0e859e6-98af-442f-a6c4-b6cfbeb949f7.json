{
  "by": "hand",
  "source_sha256": "8abb7f04d6e5566aa9c91f1a7a4b2895c2ff5f1e37e40575391043c1612957a5",
  "entry": [
    {
      "action": "say",
      "text": "origin과 main을 준비해 뒀어요. 이번 origin은 앱이 만든 연습 저장소라 실제 GitLab에는 쓰지 않아요.",
      "target": "text:공유할 origin과 현재 main을 준비했어요."
    },
    {
      "action": "git_command",
      "args": [
        "remote",
        "-v"
      ],
      "target": "#git-demo-terminal",
      "say": "원격 저장소의 이름과 주소를 읽어요."
    },
    {
      "action": "say",
      "text": "origin 옆에 연결된 연습 저장소의 주소가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "target": "#git-demo-terminal",
      "say": "브랜치 목록과 현재 위치를 읽어요."
    },
    {
      "action": "say",
      "text": "별표가 붙은 main이 현재 브랜치예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. origin은 주소의 별명이고 main은 브랜치예요. 같은 종류의 이름이 아니에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
