{
  "by": "hand",
  "source_sha256": "a0d6f6d90fbb4a0a14681997570fdef1ed40347aa98792c4d4141823fa7de8e4",
  "entry": [
    {
      "action": "say",
      "text": "작업 파일의 변경과 공유된 기록은 나누어 다뤄요.",
      "target": "text:임시 문구를 작업 파일에만 추가하고 차이를 확인하세요"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "원래 안내를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안전하게 함께 남기는 안내와 상담 창구가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 임시 창구\" >> guide.txt",
      "say": "원래 내용 뒤에 임시 창구 한 줄을 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일만 고쳤고 아직 준비하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal",
      "say": "준비 영역과 작업 파일을 비교해요."
    },
    {
      "action": "say",
      "text": "임시 창구 줄이 더하기 표시로 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 이 diff는 원격 저장소와 비교하는 명령이 아니에요. 작업 파일과 준비 영역을 비교해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
