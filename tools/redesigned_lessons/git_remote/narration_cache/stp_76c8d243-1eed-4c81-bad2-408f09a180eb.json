  "entry": [
    {
      "action": "say",
      "text": "받아 둔 문의 안내를 merge로 내 main에 합쳐 작업 파일에도 반영해요.",
      "target": "text:이제 내 파일에도 반영해요."
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "병합 전에는 메모 안내만 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "origin/main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 main이 받아 둔 문의 안내 커밋까지 이어졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 파일에도 문의 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. merge는 지금 작업하는 브랜치에 반영해요. 여기서는 내 main이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
