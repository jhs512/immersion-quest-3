{
  "by": "hand",
  "source_sha256": "ee19c9adda43ddeb1f84fa1857bb84fe991dcc0e922fd04d1e103a522b5e7572",
  "entry": [
    {
      "action": "say",
      "text": "내 작업 파일(guide.txt)과 현재 커밋에는 아직 base가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "git fetch origin으로 새 커밋을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 내 main의 guide.txt는 base예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "origin/main이 main보다 앞에 있어요. 내 main에는 따로 갈라진 새 커밋이 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "origin/main"
      ],
      "say": "git merge로 origin/main의 커밋을 내 main에 반영해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 main에는 따로 추가한 커밋이 없어요. 받은 커밋으로 바로 이동해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "main과 origin/main이 같은 커밋을 가리켜요. 새 병합 커밋 없이 main이 앞으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "내 현재 커밋의 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "shared가 나와요. 받은 내용이 main에 반영됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 양쪽에서 따로 변경했으면 병합 커밋이나 충돌이 생길 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
