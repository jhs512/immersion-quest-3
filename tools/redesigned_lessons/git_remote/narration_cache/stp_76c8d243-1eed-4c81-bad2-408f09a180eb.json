{
  "by": "hand",
  "source_sha256": "7c27003160927d1d12d74d966bc729702cecb07dcb8ee38d0513d3826a58acc5",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "먼저 새 기록을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 내 작업은 이전 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "--ff-only",
        "origin/main"
      ],
      "say": "이번에는 받은 기록으로 전진해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "갈라진 로컬 변경이 없어 바로 전진했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "합친 현재 안내를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이제 현재 기록에도 shared가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. ff-only는 갈라진 이력의 충돌을 알아서 해결하는 옵션이 아니에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
