{
  "by": "hand",
  "source_sha256": "459851ea76afe019d621469de5a5923afb574f77143eca788b8acb1d9064cd24",
  "entry": [
    {
      "action": "say",
      "text": "내 작업 파일(guide.txt)과 현재 커밋에는 아직 base가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "git fetch origin으로 새 커밋을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 내 main의 guide.txt는 base예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline",
        "--all",
        "--graph",
        "--decorate"
      ],
      "say": "커밋 그래프로 현재 연결과 브랜치 위치를 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 main보다 앞에 있어요. 내 main에는 따로 갈라진 새 커밋이 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "--ff-only",
        "origin/main"
      ],
      "say": "git merge로 origin/main의 커밋을 내 main에 반영해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 main에는 따로 추가한 커밋이 없어요. 받은 커밋으로 바로 이동해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline",
        "--all",
        "--graph",
        "--decorate"
      ],
      "say": "커밋 그래프로 현재 연결과 브랜치 위치를 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main과 origin/main이 같은 커밋을 가리켜요. 새 병합 커밋 없이 main이 앞으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "내 현재 커밋의 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "shared가 나와요. 받은 내용이 main에 반영됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 양쪽에 서로 다른 새 커밋이 있으면 ff-only 병합은 멈춰요.",
      "target": "#git-demo-terminal"
    }
  ]
}
