  "entry": [
    {
      "action": "git_command",
      "args": [
        "diff",
        "--",
        "guide.txt"
      ],
      "say": "git diff로 guide.txt에서 바뀐 부분을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "빼기 표시 옆에 base, 더하기 표시 옆에 draft가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 이 명령은 원격 저장소와 비교하지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 파일과 준비 영역을 비교해요. git diff --cached는 준비 영역과 현재 커밋을 비교해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "working-index"
    }
  ]
}
