  "entry": [
    {
      "action": "say",
      "text": "fetch는 받은 기록을 내 브랜치에 자동으로 합치지 않아요.",
      "target": "text:받은 원격 기록과 내 커밋의 안내를 비교하세요"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "받아 둔 원격 기록의 안내를 읽어요."
    },
    {
      "action": "say",
      "text": "메모 안내에 문의 줄도 더해져 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "내 현재 커밋의 안내를 읽어요."
    },
    {
      "action": "say",
      "text": "내 main에는 아직 메모 안내 한 줄만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 두 파일이 달라도 fetch 실패가 아니에요. 받은 기록을 합치는 일은 별개예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
