  "by": "hand",
  "source_sha256": "2bf9e325b493c6f2ed0fa763e1c0c9556b46f07744fbde4dbfaac9d46b7286a2",
  "entry": [
    {
      "action": "say",
      "text": "fetch로 받은 문의 안내는 origin/main에 있고, 내 main은 이전 안내에 있어요.",
      "target": "text:origin/main은 새 기록을 가리키고 내 main은 이전 안내에 있어요."
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "받아 둔 원격 기록의 안내를 읽어요."
    },
    {
      "action": "say",
      "text": "메모 안내에 문의 줄도 더해져 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "내 현재 커밋의 안내를 읽어요."
    },
    {
      "action": "say",
      "text": "내 main에는 아직 메모 안내 한 줄만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 두 파일이 달라도 fetch 실패가 아니에요. 받은 기록을 합치는 일은 별개예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
