{
  "by": "hand",
  "source_sha256": "2f9bbf0e4e13cdfab995c1759f260bb78bf9027177798f1117d5ece1bd67a6e1",
  "entry": [
    {
      "action": "say",
      "text": "이제 내 병합 기록을 push하고, 지수 쪽에서도 받아 같은 결과인지 확인해요.",
      "target": "text:이제 내 push를 다시 시도해요."
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 성공했어요. 동료 기록도 포함했거든요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../peer",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 폴더로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "완성한 병합 기록을 받았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "origin/main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 main도 병합 기록까지 이어졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안전하게 함께 남기라는 같은 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 내 병합 커밋도 push해야 동료가 받을 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
