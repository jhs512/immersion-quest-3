{
  "by": "hand",
  "source_sha256": "7490eaa794440d2683188b296e38e615ab620b5c9a0e2f12083b2a1e923b9d16",
  "entry": [
    {
      "action": "say",
      "text": "이제 내 push를 다시 시도해요.\n지수도 완성된 안내를 받아 같은 결과를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 성공했어요. 동료 기록도 포함했거든요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../peer",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 폴더로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "완성한 병합 기록을 받았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "origin/main"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 main도 병합 기록까지 이어졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안전하게 함께 남기라는 같은 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 내 병합 커밋도 push해야 동료가 받을 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
