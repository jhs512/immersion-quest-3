{
  "by": "hand",
  "source_sha256": "d66dbdc5ec8496c19e00930331711b5fa317af51ecea751be3bb5acf7fc1174e",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "diff",
        "--",
        "guide.txt"
      ],
      "say": "버리기 전에 작업 변경을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내가 mistake로 바뀌어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 복원하면 이 미기록 수정은 사라져요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지금은 독립 실습 파일만 다뤄요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "restore",
        "--worktree",
        "--",
        "guide.txt"
      ],
      "say": "인덱스의 안내로 작업 파일을 복원해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "복원 명령이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff",
        "--",
        "guide.txt"
      ],
      "say": "남은 작업 변경도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "차이 출력이 없어요. 기록 자체는 그대로예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
