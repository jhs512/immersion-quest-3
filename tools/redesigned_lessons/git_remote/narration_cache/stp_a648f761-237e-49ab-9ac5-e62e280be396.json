{
  "by": "hand",
  "source_sha256": "b3469c7dd3301b076eb067a581d08bb1da4df71b9ca96a6f5ffa4b7daa253cbf",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 임시 창구 안내는 쓰지 않기로 했어요.\n방금 직접 더한 줄만 되돌려요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 커밋하지 않은 임시 창구 줄이 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "restore",
        "guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 파일을 준비 영역의 안내로 되돌렸어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안전하게 함께 남기는 안내와 상담 창구가 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "추가 수정이 없는 깨끗한 상태예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. restore는 커밋하지 않은 파일 수정을 버려요. 취소할 내용을 먼저 확인하세요.",
      "target": "#git-demo-terminal"
    }
  ]
}
