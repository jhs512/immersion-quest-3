  "entry": [
    {
      "action": "git_command",
      "args": [
        "remote",
        "-v"
      ],
      "say": "원격 이름과 주소를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin 주소는 이 실습 안의 로컬 저장소예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "--show-current"
      ],
      "say": "현재 브랜치 이름도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지금 브랜치는 main이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 여기서는 실제 GitHub 계정이나 개인 저장소에 전송하지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "different"
    }
  ]
}
