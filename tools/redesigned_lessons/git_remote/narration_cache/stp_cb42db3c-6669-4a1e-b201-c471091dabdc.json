{
  "by": "hand",
  "source_sha256": "7d95756faf8955c217bc61b133c8ff90566e142e4d1bc99ee17404e96e0d3498",
  "entry": [
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "main이 마지막 변경 커밋을 가리켜요. 그 아래에 기존 커밋도 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "revert",
        "HEAD"
      ],
      "say": "git revert로 마지막 커밋의 변경을 취소해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 커밋을 지우지 않고 변경을 취소하는 새 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "되돌리는 새 커밋이 맨 위에 생겼어요. 잘못된 변경 커밋도 그 아래 그대로 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "현재 커밋에 담긴 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "base가 나와요. wrong으로 바꾼 변경이 취소됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. revert는 잘못된 커밋 자체를 지우지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다른 변경과 충돌하는 경우에는 충돌을 해결한 뒤 마쳐야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
