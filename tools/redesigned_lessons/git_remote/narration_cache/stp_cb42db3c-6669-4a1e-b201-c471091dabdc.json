{
  "by": "hand",
  "source_sha256": "cb4bbca6ffa454fe1a7525277aaa821d2bacb1e32e4efa32dbb540249dc5335a",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "revert",
        "--no-edit",
        "HEAD"
      ],
      "say": "git revert로 마지막 커밋의 변경을 취소해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 커밋을 지우지 않고 변경을 취소하는 새 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "현재 커밋에 담긴 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "base가 나와요. wrong으로 바꾼 변경이 취소됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "rev-list",
        "--count",
        "HEAD"
      ],
      "say": "git rev-list로 현재까지 이어진 커밋 수를 세어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "3이 나와요. 기존 두 커밋에 되돌린 커밋 하나가 추가됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. revert는 잘못된 커밋 자체를 지우지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다른 변경과 충돌하는 경우에는 충돌을 해결한 뒤 마쳐야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
