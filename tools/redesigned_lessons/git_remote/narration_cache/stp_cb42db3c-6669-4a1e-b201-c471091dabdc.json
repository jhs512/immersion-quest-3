{
  "by": "hand",
  "source_sha256": "7e1c4d918f6e5072980658a6fd75e6778c9df2dc5964f5190725b26ec3f100df",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "revert",
        "--no-edit",
        "HEAD"
      ],
      "say": "마지막 변경을 되돌리는 새 기록을 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "잘못된 변경의 반대 내용이 새로 기록됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "현재 안내를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 안내는 다시 base예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "rev-list",
        "--count",
        "HEAD"
      ],
      "say": "이전 기록도 남았는지 세어 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "처음 두 개에 새 기록까지 세 개예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 과거 기록을 지우는 reset과 달라요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "충돌이 생기는 다른 상황에는 별도 해결이 필요할 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
