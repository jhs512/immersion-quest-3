{
  "by": "hand",
  "source_sha256": "810b1c52c6c6a3a5ba1bf4e6f4c2f1989df9e91438fa81a44b8dd54af5499e6a",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 기본 안내문을 준비해 달래요.\n../inbox도 이 실습 전용 폴더예요. 그곳에서 작성해 옮겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "mkdir ../inbox",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내문을 준비할 바깥 폴더가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모를 남겨요\" > ../inbox/guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "준비 폴더에 안내문을 썼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat ../inbox/guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모를 남기라는 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "mv ../inbox/guide.txt .",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내문을 현재 저장소로 옮겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "같은 안내문이 저장소 안에서 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 커밋하지 않은 guide.txt가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. mv는 파일을 옮겨요. 원래 준비 폴더에는 파일이 남지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
