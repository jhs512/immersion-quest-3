{
  "by": "hand",
  "source_sha256": "6f83e0388683495d217c68b98035144bd675a72a8a36a223ac99d89751807403",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 기본 안내문을 부탁했어요. 저장소 바깥 ../inbox에서 써서 mv로 옮겨 와요.",
      "target": "text:팀장이 기본 안내문을 준비해 달래요."
    },
    {
      "action": "bash_command",
      "command": "mkdir ../inbox",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내문을 준비할 바깥 폴더가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모를 남겨요\" > ../inbox/guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "준비 폴더에 안내문을 썼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat ../inbox/guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모를 남기라는 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "mv ../inbox/guide.txt .",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내문을 현재 저장소로 옮겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "같은 안내문이 저장소 안에서 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 커밋하지 않은 guide.txt가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. mv는 파일을 옮겨요. 원래 준비 폴더에는 파일이 남지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
