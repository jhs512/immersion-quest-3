{
  "by": "hand",
  "source_sha256": "52ac4487ffb7da44732660886db400d626ea170e5ea66da72f3e5924f3138a3f",
  "entry": [
    {
      "action": "say",
      "text": "잘못된 내용도 커밋하면 기록에 남아요.\n이번에는 커밋 후 복구가 왜 다른지 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "종료 안내를 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "잘못된 종료 안내"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "잘못된 종료 안내가 새 커밋으로 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "앞선 협업 기록 위에 잘못된 종료 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 잘못된 내용도 commit하면 기록에 남아요. 커밋 전 내용을 읽어야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
