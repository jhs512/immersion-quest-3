{
  "by": "hand",
  "source_sha256": "1a393a6de64cc632eb495ca920c8ea672a2a40fbfcf4e57d685cc71c37a9b9e9",
  "entry": [
    {
      "action": "say",
      "text": "revert는 이미 남긴 기록에 취소 기록을 더해요.",
      "target": "text:되돌림 커밋이 기존 기록을 보존했는지 확인하세요"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "-2",
        "--oneline"
      ],
      "target": "#git-demo-terminal",
      "say": "최근 두 기록을 읽어요."
    },
    {
      "action": "say",
      "text": "되돌림 커밋 아래에 잘못된 종료 안내 커밋도 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal",
      "say": "아직 커밋하지 않은 파일 변경도 확인해요."
    },
    {
      "action": "say",
      "text": "출력이 없어요. 현재 파일은 복구한 커밋과 같아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. restore는 아직 커밋하지 않은 파일을 되돌려요. 공유한 커밋을 취소하는 revert와 역할이 달라요.",
      "target": "#git-demo-terminal"
    }
  ]
}
