{
  "by": "hand",
  "source_sha256": "c0280fb45aec4c4ca8fe12d46253c3b690317a8502ab5878d49b604961b501bc",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "다른 작업자의 기록을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격 추적 기록이 새 안내를 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "내 현재 기록의 안내를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 안내는 아직 base예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "받아 둔 원격 기록도 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받은 기록에는 shared가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. fetch만으로 현재 브랜치나 작업 파일을 합치지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
