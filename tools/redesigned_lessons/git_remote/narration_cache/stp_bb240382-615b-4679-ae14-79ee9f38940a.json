{
  "by": "hand",
  "source_sha256": "e01f49c9d4cdad4f222e955fb0567267e43ae1e80a781c1c7490dae9d99ac58b",
  "entry": [
    {
      "action": "say",
      "text": "지수가 보낸 기록을 받아요. fetch는 origin/main이라는 받은 기록만 갱신하고 내 main은 그대로 둬요.",
      "target": "text:fetch는 받은 기록을 갱신해요."
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 동료의 새 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받은 기록에는 문의 안내도 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 파일에는 메모 안내만 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. fetch는 받은 기록만 갱신해요. 내 main과 작업 파일은 그대로예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
