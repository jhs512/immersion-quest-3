{
  "by": "hand",
  "source_sha256": "a1f7bc7db11bc3ad5798d5e7b843cd05a41d1956ca33efd30047f5e974dc9ff7",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "git fetch origin으로 원격에 추가된 커밋을 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 방금 받은 원격 main의 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "origin/main이 새 커밋을 가리켜요. main은 이전 커밋에 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "HEAD는 내 현재 커밋이에요. 여기에 담긴 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "base가 나와요. 내 현재 커밋은 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "origin/main에 담긴 guide.txt도 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "shared가 나와요. 원격에서 받은 새 내용이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. fetch는 커밋을 받는 명령이에요. 내 브랜치에 합치지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
