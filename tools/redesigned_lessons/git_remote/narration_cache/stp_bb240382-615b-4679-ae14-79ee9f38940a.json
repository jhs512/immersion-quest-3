{
  "by": "hand",
  "source_sha256": "42a9d2df1821d8c559dfd15b4040ccef15b28052bd9d3dbb7962926c17927801",
  "entry": [
    {
      "action": "say",
      "text": "지수가 보낸 기록을 내 저장소로 받아요.\nfetch는 받은 기록을 갱신해요. 내 main은 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 동료의 새 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받은 기록에는 문의 안내도 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 파일에는 메모 안내만 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. fetch는 받은 기록만 갱신해요. 내 main과 작업 파일은 그대로예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
