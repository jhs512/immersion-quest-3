{
  "by": "hand",
  "source_sha256": "645c675698ed2f168c0870f14d56650fae1ebe878f2e949b22e9dcfc2a267293",
  "entry": [
    {
      "action": "say",
      "text": "지수가 보낸 기록을 받아요. fetch는 origin/main이라는 받은 기록만 갱신하고 내 main은 그대로 둬요.",
      "target": "text:fetch는 받은 기록을 갱신해요."
    },
    {
      "action": "git_command",
      "args": [
        "fetch",
        "origin"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main이 동료의 새 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "origin/main:guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받은 기록에는 문의 안내도 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 파일에는 메모 안내만 남아 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
