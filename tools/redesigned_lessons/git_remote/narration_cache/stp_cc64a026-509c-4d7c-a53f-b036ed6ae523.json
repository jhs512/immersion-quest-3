{
  "by": "hand",
  "source_sha256": "50088dfe0cfa95d758ebafb04158d7a98efcc46ba22367fc01e70f05e9c34972",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "git push origin main으로 main의 커밋을 원격 저장소에 보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "전송이 성공했어요. 원격 main에도 내 커밋이 반영됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline"
      ],
      "say": "보낸 커밋의 설명을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Local guide가 나와요. 안내 파일을 수정한 커밋이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. git commit은 내 저장소에만 커밋을 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격 저장소로 보내려면 git push를 따로 실행해야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
