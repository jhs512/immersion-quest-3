{
  "by": "hand",
  "source_sha256": "55b6d8770a0ff8b8a8569a2cbef297284a4f4d0f9a60bddb52338836e97e4798",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "로컬 원격으로 안내 기록을 보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "push가 성공해 실제 원격 main도 같은 기록을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "-1",
        "--format=%s"
      ],
      "say": "보낸 마지막 기록의 제목을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Local guide 기록이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 커밋은 로컬 기록이에요. 실제 원격으로 보내는 동작은 따로 필요해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
