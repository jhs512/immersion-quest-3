{
  "by": "hand",
  "source_sha256": "1bc89076b25496734960b65cd60e31ebe7220eff7ee1d3feea1fca4b1e234a03",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "git push origin main으로 main의 커밋을 원격 저장소에 보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "전송이 성공했어요. 원격 main에도 내 커밋이 반영됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "-1",
        "--format=%s"
      ],
      "say": "보낸 커밋의 설명을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Local guide가 나와요. 안내 파일을 수정한 커밋이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. git commit은 내 저장소에만 커밋을 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격 저장소로 보내려면 git push를 따로 실행해야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
