{
  "by": "hand",
  "source_sha256": "f91773b4bbc3c8b7c12ad9e271fd8e02aadfd3a51aeaa846c16d1ee17c2e98e7",
  "entry": [
    {
      "action": "say",
      "text": "안내문은 내 main에만 있어요. 팀에서도 받을 수 있게 보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "공유 저장소의 main에도 메모 안내 커밋이 반영됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "보낸 기록은 내 메모 안내 커밋이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 어느 저장소의 어느 브랜치로 보내는지 확인하세요. 여기서는 origin의 main이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
