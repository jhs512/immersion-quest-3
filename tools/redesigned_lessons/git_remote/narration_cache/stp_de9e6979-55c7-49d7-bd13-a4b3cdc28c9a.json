{
  "by": "hand",
  "source_sha256": "0a04737023c64c7fff14a663ba717f7af94ec053cd2c0e937a07581c52925a78",
  "entry": [
    {
      "action": "say",
      "text": "파일 내용은 정했지만 Git은 아직 병합 중이에요. add로 해결했다고 알리고 commit으로 병합 기록을 남겨요.",
      "target": "text:이제 해결됐다고 알리고 기록해요."
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "충돌을 해결한 파일로 준비했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "충돌은 해결됐지만 병합 커밋을 남기라는 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "메모 안내 병합"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 작업을 함께 잇는 병합 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 요청을 반영한 안내가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일만 고쳐서는 병합이 끝나지 않아요. add와 commit으로 해결을 기록해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
