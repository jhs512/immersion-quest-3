{
  "by": "hand",
  "source_sha256": "9f72d3d86840c8dfee91f06507d16f9308da067c569d4b7f3901142eb6382868",
  "entry": [
    {
      "action": "say",
      "text": "이번에는 같은 안내문을 함께 고쳐요.\n여러분은 안전 안내, 지수는 함께 쓰기 안내를 맡았어요.\n아직 서로의 새 작업을 받지 않은 상태예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "공유한 정상 안내가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모를 안전하게 남겨요\" > guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내가 맡은 안전 안내로 첫 줄을 바꿨어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 문의 안내도 다시 남겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내가 바꾼 첫 줄이 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안전 안내를 준비했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "안전한 메모 안내"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 main에만 안전 안내 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 내 커밋을 만들었다고 동료의 복제본까지 바뀌지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
