{
  "by": "hand",
  "source_sha256": "67522440c079c395fc9654e3adb35a8879d99fb71569eeba7799b9d46fcc0ce9",
  "entry": [
    {
      "action": "say",
      "text": "지수 역할로 바꿔요. 같은 첫 줄을 다르게 고쳐 먼저 보내요.\n내 작업 폴더의 안전 안내 커밋은 그대로 남아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../peer",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 복제본으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모를 함께 남겨요\" > guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수는 같은 첫 줄에 함께 쓰기 안내를 적었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내는 유지했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 변경을 준비했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "함께 쓰는 메모 안내"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수의 별도 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지수가 먼저 공유 저장소에 보냈어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 파일은 여전히 안전 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 동료 역할의 변경은 peer에 기록해요. 내 work의 커밋과 구분하세요.",
      "target": "#git-demo-terminal"
    }
  ]
}
