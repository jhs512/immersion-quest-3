{
  "by": "hand",
  "source_sha256": "3b68941acd2601303be149526395a6cef34d913f6ceae84527f765a8d5e62b82",
  "entry": [
    {
      "action": "say",
      "text": "동료 지수 역할이 되어, 공유 저장소를 peer 폴더로 복제해 문의 안내를 더하고 보내요. 끝나면 내 work 폴더로 돌아와요.",
      "target": "text:clone은 공유 저장소를 새 작업 폴더로 복제해요."
    },
    {
      "action": "git_command",
      "args": [
        "clone",
        "../remote.git",
        "../peer"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료가 쓸 별도 복제본 peer가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../peer",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 작업 폴더로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 안내문에 문의 한 줄을 더했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 메모 안내와 새 문의 안내가 함께 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내를 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "문의 안내"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 main에 문의 안내 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 문의 안내가 공유 저장소로 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 파일에는 아직 메모 안내만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 동료 역할의 작업은 peer에서 해요. 끝나면 내 work 폴더로 돌아오세요.",
      "target": "#git-demo-terminal"
    }
  ]
}
