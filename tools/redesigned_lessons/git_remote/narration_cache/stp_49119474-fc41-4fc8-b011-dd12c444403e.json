{
  "by": "hand",
  "source_sha256": "a1337639f3dd2544843c1d47b478f3a2e5e93b08fdf658db99d03643dc7dc9c7",
  "entry": [
    {
      "action": "say",
      "text": "동료 지수는 문의 안내를 맡았어요.\n동료의 별도 복제본에서 직접 수정하고 보내 볼게요.\nclone은 공유 저장소를 새 작업 폴더로 복제해요.\n마지막에는 내 work 폴더로 돌아와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "clone",
        "../remote.git",
        "../peer"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료가 쓸 별도 복제본 peer가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../peer",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 작업 폴더로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 안내문에 문의 한 줄을 더했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 메모 안내와 새 문의 안내가 함께 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내를 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "문의 안내"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 main에 문의 안내 커밋이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "push",
        "origin",
        "main"
      ],
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "동료의 문의 안내가 공유 저장소로 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 작업 폴더로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 실행하고 결과를 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "내 파일에는 아직 메모 안내만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 동료 역할의 작업은 peer에서 해요. 끝나면 내 work 폴더로 돌아오세요.",
      "target": "#git-demo-terminal"
    }
  ]
}
