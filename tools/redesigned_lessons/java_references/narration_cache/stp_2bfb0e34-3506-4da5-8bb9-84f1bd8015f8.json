{
  "by": "hand",
  "source_sha256": "53917faea86deedd798eaa8a3d42787c25f8929930b8c5adf4a8d4ce21c9e4ea",
  "entry": [
    {
      "action": "say",
      "text": "생성자에 2를 넘겼는데 필드에는 0이 남아요.",
      "target": "text:생성자에 2를 줬지만 필드에는 0이 남아요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 필드에 아무것도 쓰지 않았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "이 줄의 두 count는 모두 매개변수예요. 매개변수에 자기 자신을 넣고 끝났어요.",
      "target": "code:        count = count;"
    },
    {
      "action": "patch_code",
      "before": "        count = count;",
      "after": "        this.count = count;",
      "say": "왼쪽을 this.count로 바꿔 현재 객체의 필드에 넣어요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "2예요. 이제 필드에 저장됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 매개변수와 필드 이름이 같으면, 그냥 count라고 쓴 쪽은 매개변수를 가리켜요.",
      "target": "text:매개변수 이름과 필드 이름이 둘 다 count예요."
    },
    {
      "action": "patch_code",
      "before": "initial = 2;",
      "after": "initial = 5;",
      "say": "다른 초기값 5도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "5예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "initial = 5;",
      "after": "initial = 2;",
      "say": "처음 값으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "this로 필드와 매개변수를 나눠 해결했어요.",
      "target": "output"
    }
  ]
}
