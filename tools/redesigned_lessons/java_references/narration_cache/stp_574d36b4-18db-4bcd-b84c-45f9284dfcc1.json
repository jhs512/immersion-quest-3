{
  "by": "hand",
  "source_sha256": "49a7635a9ebdf21b96cd5aeac887231a60dfa8d8b2f9cca199bfee6f6e76d82a",
  "entry": [
    {
      "action": "say",
      "text": "status에는 ready라는 글자가 들어 있는데 대기가 나와요.",
      "target": "text:그런데 지금 조건은 대기를 출력해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        10
      ]
    },
    {
      "action": "say",
      "text": "대기예요. ==는 글자가 아니라 같은 객체인지 비교하는데, 따로 만든 문자열이라 거짓이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "status == \"ready\"",
      "after": "status.equals(\"ready\")",
      "say": "글자 내용을 비교하는 equals로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        10
      ]
    },
    {
      "action": "say",
      "text": "출발이에요. 두 문자열의 글자가 같아서 equals가 참이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "new String(\"ready\")",
      "after": "new String(\"hold\")",
      "say": "상태를 hold로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        10
      ]
    },
    {
      "action": "say",
      "text": "대기예요. 글자가 다르면 equals도 거짓이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 문자열을 ==로 비교하면 어떤 때는 맞는 것처럼 보여도 따로 만든 문자열에서 틀려요. 내용은 equals로 비교해요.",
      "target": "code:status.equals(\"ready\")"
    },
    {
      "action": "patch_code",
      "before": "new String(\"hold\")",
      "after": "new String(\"ready\")",
      "say": "상태를 ready로 되돌려요."
    }
  ]
}
