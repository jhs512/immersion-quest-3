{
  "by": "hand",
  "source_sha256": "cf5eb3fd0b7cdff36c78c8515cfffa49d97e889ca8324ae803bc4784d6e1cedd",
  "entry": [
    {
      "action": "say",
      "text": "두 상자의 count는 둘 다 2예요. 질문은 이 Box의 equals가 그 내용을 비교하는지예요.",
      "target": "text:이 Box 클래스는 equals를 직접 만들지 않았어요."
    },
    {
      "action": "say",
      "text": "==는 같은 객체인지, equals는 클래스가 정한 기준으로 비교해요.",
      "target": "lines:15:16"
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "둘 다 false예요. 직접 만들지 않은 equals는 같은 객체인지만 봐요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "Box b = new Box(2);",
      "after": "Box b = a;",
      "say": "b가 a와 같은 상자를 가리키게 해요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "둘 다 true예요. 같은 객체라서요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 내용으로 비교하려면 그 클래스가 equals를 직접 정의해야 해요.",
      "target": "text:그러면 equals는 기본으로 같은 객체인지만 비교해요."
    },
    {
      "action": "patch_code",
      "before": "Box b = a;",
      "after": "Box b = new Box(2);",
      "say": "내용만 같은 별도 상자로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "이 Box에서는 내용이 같아도 equals가 false예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "identity"
    }
  ]
}
