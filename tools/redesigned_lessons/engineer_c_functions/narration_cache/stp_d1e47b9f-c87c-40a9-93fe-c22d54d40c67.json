  "entry": [
    {
      "action": "say",
      "text": "재귀 함수는 자기 자신을 다시 부르기 때문에, 부르지 않고 끝나는 끝 조건이 있어야 해요. 입력 0일 때의 경로를 고르는 문제예요.",
      "target": "text:입력이 0이면 어느 경로로 끝날까요?"
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "끝 조건을 만나 바로 0을 돌려줬어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 0;",
      "after": "count = 1;",
      "say": "하나 큰 입력으로도 끝까지 가 볼게요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "1에서 0을 부른 뒤 1과 0을 더했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 끝 조건이 있어야 더 작은 호출도 멈춰요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 1;",
      "after": "count = 0;",
      "say": "처음의 끝값 입력으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "지금은 자기 호출을 하지 않고 끝났어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "base"
    }
  ]
}
