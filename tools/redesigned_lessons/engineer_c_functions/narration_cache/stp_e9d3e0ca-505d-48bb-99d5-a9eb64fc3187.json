      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "내려갈 때 2, 1, 0. 돌아올 때 0, 1, 2예요.",
      "target": "output",
      "diagram": {
        "title": "호출과 복귀의 순서",
