    {
      "action": "say",
      "text": "n이 0이면 더 부르지 않고 0을 반환하는 끝 조건을 써야 해요. 지금은 0에서도 멈추지 않아요.",
      "target": "text:if 안의 주석 아래에 0을 반환하는 끝 조건을 쓰세요."
    },
    {
      "action": "patch_code",
      "before": "        // 이 주석 아래에 0을 반환하는 끝 조건을 쓰세요.\n",
      "after": "        // 이 주석 아래에 0을 반환하는 끝 조건을 쓰세요.\n        return 0;\n",
      "say": "if 안에 return 0을 써요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 입력 0은 끝 조건에서 바로 0을 반환했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int count = 0;\n",
      "after": "    int count = 4;\n",
      "say": "입력을 4로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "10이에요. 4, 3, 2, 1을 거쳐 0에서 멈춘 뒤 더해 돌아왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int count = 4;\n",
      "after": "    int count = 0;\n",
      "say": "입력을 처음 값 0으로 되돌려요."
    },
    {
      "action": "say",
      "text": "조심하세요. 끝 조건이 비어 있으면 0에서도 sum_to(-1)을 불러 스택이 넘칠 때까지 멈추지 않아요.",
      "target": "code:return n + sum_to(n - 1);"
    }
  ]
