{
  "by": "hand",
  "source_sha256": "aa9b12e0f5af888b9c39c7794e5ddde4abb10c8e1b383f31c2af11dd84ee8376",
  "entry": [
    {
      "action": "say",
      "text": "끝 조건이 0 대신 다른 값을 돌려줘 모든 합이 커졌어요. 아무것도 더하지 않은 빈 합이 0이 되도록 끝값 한 곳을 고치는 문제예요.",
      "target": "text:빈 합이 0이 되도록 끝값 한 곳만 고치세요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "끝값 1까지 더해 합이 7로 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return 1;",
      "after": "return 0;",
      "say": "더할 값이 없을 때는 0을 돌려줘요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "이번에는 1과 2와 3의 합 6이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 결과 6을 고정하면 빈 합을 설명할 수 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 3;",
      "after": "count = 0;",
      "say": "끝 조건만 실행하는 입력 0도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "빈 합은 0으로 바로 끝나요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 0;",
      "after": "count = 3;",
      "say": "처음 입력을 복원해요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "끝값과 돌아오는 계산을 연결해 확인했어요.",
      "target": "output"
    }
  ]
}
