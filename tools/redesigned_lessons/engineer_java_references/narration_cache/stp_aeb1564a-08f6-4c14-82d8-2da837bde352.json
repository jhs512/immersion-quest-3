  "entry": [
    {
      "action": "say",
      "text": "String은 한번 만들면 내용이 바뀌지 않아요. b에 느낌표를 붙이는 것이 같은 글을 고치는지 새 글을 만드는지가 질문이에요.",
      "target": "text:b에 느낌표를 붙였어요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "a는 원래 글, b는 느낌표가 붙은 새 글을 봐요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "b = b + \"!\";",
      "after": "b = b + \"!\";\n        a = b;",
      "say": "b를 만든 뒤 a에도 b의 참조값을 대입해 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "a에도 b의 참조값을 담으면 둘이 새 글을 봐요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. b + \"!\"는 기존 글을 고치지 않고 새 String을 만들어요. b만 새 글을 가리키게 될 뿐이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "b = b + \"!\";\n        a = b;",
      "after": "b = b + \"!\";",
      "say": "a = b; 줄을 빼고 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "처음 코드에서 a는 go, b는 go!예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "immutable"
    }
  ]
}
