  "entry": [
    {
      "action": "say",
      "text": "text가 아직 null이에요. null이면 길이를 묻지 말고 false가 나와야 해요.",
      "target": "text:조건의 연산자 한 곳을 고쳐 text가 null이면 길이를 묻지 않고 false가 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        8
      ]
    },
    {
      "action": "say",
      "text": "missing이 나와요. &는 왼쪽이 false여도 오른쪽 text.length()까지 실행해서 예외가 났어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "text != null & text.length() > 0",
      "after": "text != null && text.length() > 0",
      "say": "&를 &&로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        6,
        8
      ]
    },
    {
      "action": "say",
      "text": "false가 나와요. 왼쪽이 false라서 &&가 오른쪽을 건너뛰었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 두 조건의 순서를 바꿔 text.length()를 앞에 두면 &&여도 먼저 예외가 나요.",
      "target": "code:text != null && text.length() > 0"
    }
  ]
}
