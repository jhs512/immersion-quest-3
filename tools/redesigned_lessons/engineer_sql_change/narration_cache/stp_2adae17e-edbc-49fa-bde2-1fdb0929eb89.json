  "entry": [
    {
      "action": "say",
      "text": "조회 결과의 행을 새 행으로 넣어요. 재고가 양수인 행만 복사해야 해요.",
      "target": "text:문장에 조건을 더해 재고가 양수인 행만 ID에 10을 더해 복사하세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "11부터 14까지 네 행이 더 생겼어요. NULL과 0인 행까지 모두 복사했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "SELECT id + 10, qty FROM stocks;",
      "after": "SELECT id + 10, qty FROM stocks WHERE qty > 0;",
      "say": "SELECT 끝에 WHERE qty > 0을 붙여요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "11과 12만 새로 생겼어요. 재고 2와 4인 행만 복사됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 새 ID가 기존 ID와 겹치면 기본 키 때문에 문장 전체가 실패해요.",
      "target": "code:id + 10"
    }
  ]
}
