  "entry": [
    {
      "action": "say",
      "text": "필요한 권한만, 다시 줄 수 없게 주는 명령을 고르는 문제예요.",
      "target": "text:PostgreSQL 18에서 줄 권한을 고르세요."
    },
    {
      "action": "say",
      "text": "조회만 필요하므로 SELECT 권한을 골라요.",
      "target": "answer:read"
    },
    {
      "action": "say",
      "text": "다시 줄 필요가 없으니 WITH GRANT OPTION도 붙이지 않아요.",
      "target": "answer:regrant"
    },
    {
      "action": "say",
      "text": "ALL PRIVILEGES는 수정·삭제까지 줘서 최소 권한이 아니에요.",
      "target": "answer:all"
    },
    {
      "action": "say",
      "text": "이 문항은 PostgreSQL 18의 문법 자료를 읽어요.",
      "target": "text:PostgreSQL 18"
    },
    {
      "action": "say",
      "text": "SQLite에서 권한을 실행한 결과가 아니에요.",
      "target": "text:PostgreSQL 18"
    },
    {
      "action": "choose_answer",
      "id": "read"
    }
  ]
}
