{
  "by": "hand",
  "source_sha256": "fc2b8d7fa99af2732fd76521cded1f7f8350231cfd5ea438ee16ef0ac559e6bc",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. NULL 조건과 여러 변경문의 실행 순서로 최종 표를 만들어요.",
      "target": "text:NULL 조건과 여러 변경문의 실행 순서로 최종 표를 만들어요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "NULL 행은 정정되지 않아 2번이 남았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "WHERE qty = NULL;",
      "after": "WHERE qty IS NULL;",
      "say": "먼저 UPDATE의 NULL 비교를 IS NULL로 고치세요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "모르는 재고도 먼저 0이 돼 함께 삭제되고 양수 두 행은 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. DELETE를 먼저 하면 나중에 0으로 정정한 행은 삭제되지 않아요.",
      "target": "code:WHERE qty IS NULL;"
    }
  ]
}
