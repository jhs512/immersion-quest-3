  "entry": [
    {
      "action": "say",
      "text": "0과 NULL 가운데 어느 조건이 참이 되는지 따지는 문제예요.",
      "target": "text:어떤 행이 지워질까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ]
    },
    {
      "action": "say",
      "text": "재고 0인 물건만 지워서 1, 2, 3이 남아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "qty=0",
      "after": "qty IS NULL",
      "say": "조건을 qty IS NULL로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ]
    },
    {
      "action": "say",
      "text": "IS NULL로 바꾸면 모르는 재고의 ID 3을 지워요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 0과 NULL은 서로 다른 조건이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "qty IS NULL",
      "after": "qty=0"
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ]
    },
    {
      "action": "say",
      "text": "처음 SQL은 재고 0인 ID 4만 지워요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "zero"
    }
  ]
