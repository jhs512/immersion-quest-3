{
  "by": "hand",
  "source_sha256": "526040194a7a9d1308c1461b0f590577d1a99395e17d6e9d7a6a98d4602251bc",
  "entry": [
    {
      "action": "say",
      "text": "map은 사전에 있는 이름을 그 값으로 바꿔요. 사전에 없는 west가 어떤 값이 되고 행은 어떻게 되는지 봐요.",
      "target": "text:사전에는 north와 south만 있어요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "west 자리에만 결측이 생기고 네 행은 남아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "{\"north\": 0, \"south\": 1}",
      "after": "{\"north\": 0, \"south\": 1, \"west\": 2}",
      "say": "west의 뜻도 사전에 명시해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "이번에는 알려진 이름이라 결측이 없어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 모르는 지역을 멋대로 north와 합치지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "{\"north\": 0, \"south\": 1, \"west\": 2}",
      "after": "{\"north\": 0, \"south\": 1}",
      "say": "처음 사전으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "미지 범주는 확인할 정보로 남겨요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "missing"
    }
  ]
}
