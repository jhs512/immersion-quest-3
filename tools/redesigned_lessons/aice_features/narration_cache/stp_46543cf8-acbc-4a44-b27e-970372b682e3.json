  "entry": [
    {
      "action": "say",
      "text": "errors=\"ignore\"는 변환이 실패하면 오류를 내지 않고 원래 값을 그대로 돌려줘요. 오류가 안 보이면 변환된 것인지 판단해요.",
      "target": "text:변환 오류를 ignore로 숨겼어요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "첫 값도 str이고 bad가 있는 문자열 그대로예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "errors=\"ignore\"",
      "after": "errors=\"raise\"",
      "say": "실패를 숨기지 않고 확인해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "bad를 정수로 바꿀 수 없어 오류가 났어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 오류가 안 보인다고 변환 성공은 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "errors=\"raise\"",
      "after": "errors=\"ignore\"",
      "say": "원래 오류 억제 비교로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "여전히 원래 문자가 남아 있음을 확인해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "unchanged"
    }
  ]
}
