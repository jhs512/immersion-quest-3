{
  "by": "hand",
  "source_sha256": "fee44625cb40ad3e03ca1adcfcf2925780c582ca8b9e01b5255040dafe723fa8",
  "entry": [
    {
      "action": "say",
      "text": "메모 파일의 기본 커밋을 준비했어요. 이번에는 이 컴퓨터의 GitLab에 공유할 프로젝트를 만들어요.",
      "target": "text:메모 파일의 기본 커밋을 준비했어요. 이번에는 이 컴퓨터의 GitLab에 공유할 프로젝트를 만들어요."
    },
    {
      "action": "bash_command",
      "command": "glab repo create \"$MQ3_REPO\" --private --defaultBranch main --skipGitInit",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "GitLab 프로젝트만 생겼어요. 아직 로컬 커밋은 전송하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git remote add origin \"$MQ3_GITLAB/$MQ3_NAMESPACE/$MQ3_REPO.git\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin을 이 프로젝트의 HTTP 주소에 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git remote -v",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin에 로컬 GitLab 주소가 보이면 연결된 거예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
