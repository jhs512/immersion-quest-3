{
  "by": "hand",
  "source_sha256": "7e77fd5524f42d4f3b1f9d96912aa8396068a28bad86aafe848b5959d5cda3b7",
  "entry": [
    {
      "action": "say",
      "text": "새 메모 프로젝트에서 혼자 전체 흐름을 완성하세요.",
      "target": "text:새 메모 프로젝트에서 혼자 전체 흐름을 완성하세요."
    },
    {
      "action": "bash_command",
      "command": "glab repo create \"$MQ3_REPO\" --private --defaultBranch main --skipGitInit",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "새 비공개 프로젝트를 만들었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git remote add origin \"$MQ3_GITLAB/$MQ3_NAMESPACE/$MQ3_REPO.git\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin을 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git push -u origin main",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기본 main을 보냈어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git switch -c feature",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에서 작업해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "printf '함께 읽는 메모\\n' > memo.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모를 바꿨어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git add memo.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다음 커밋에 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"메모 안내 개선\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에 기록했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git push -u origin feature",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 브랜치를 보냈어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "glab mr create --source-branch feature --target-branch main --title \"메모 안내 개선\" --description \"메모 문구를 바꿨어요.\" --yes",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main으로 변경을 제안했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "glab mr diff",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "MR의 실제 차이를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "glab mr merge --yes",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격에서 병합했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git switch main",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "로컬 main으로 돌아와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git pull",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "병합 결과를 받았어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
