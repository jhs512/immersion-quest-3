  "entry": [
    {
      "action": "say",
      "text": "수정한 feature는 아직 내 컴퓨터에만 있어요. GitLab이 두 브랜치를 비교할 수 있게 보내세요.",
      "target": "text:수정한 feature는 아직 내 컴퓨터에만 있어요. GitLab이 두 브랜치를 비교할 수 있게 보내세요."
    },
    {
      "action": "bash_command",
      "command": "git push -u origin feature",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature의 새 커밋이 원격에도 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git branch -r",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "origin/main과 origin/feature는 원격 브랜치의 위치를 기억한 이름이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
