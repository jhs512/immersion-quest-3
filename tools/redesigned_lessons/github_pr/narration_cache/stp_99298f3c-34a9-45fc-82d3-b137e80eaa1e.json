  "entry": [
    {
      "action": "say",
      "text": "팀원이 함께 볼 문구로 바꾸세요. main의 메모는 아직 바꾸지 않아요.",
      "target": "text:팀원이 함께 볼 문구로 바꾸세요. main의 메모는 아직 바꾸지 않아요."
    },
    {
      "action": "bash_command",
      "command": "printf '함께 읽는 메모\\n' > memo.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 파일의 내용이 함께 읽는 메모로 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git add memo.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "바꾼 파일을 다음 커밋에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"메모 안내 개선\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에 새 커밋이 생겼어요. 아직 GitLab으로 보내지는 않았어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
