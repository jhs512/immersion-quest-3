{
  "by": "hand",
  "source_sha256": "060a028c71d7a503ab77bab5f4eadd17b9ee13a7228988f4ada66a16ae6fbec2",
  "entry": [
    {
      "action": "say",
      "text": "검토한 변경을 GitLab의 main에 합치세요. 그다음 내 컴퓨터의 main에도 받아야 해요.",
      "target": "text:검토한 변경을 GitLab의 main에 합치세요. 그다음 내 컴퓨터의 main에도 받아야 해요."
    },
    {
      "action": "bash_command",
      "command": "glab mr merge --yes",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "GitLab에서 MR이 병합됐어요. 이 순간에는 내 로컬 main이 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git switch main",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "로컬 main으로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git pull",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "원격에서 병합한 기록을 로컬 main으로 받았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "함께 읽는 메모가 보이면 원격의 병합 결과를 내 main에서도 읽은 거예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
