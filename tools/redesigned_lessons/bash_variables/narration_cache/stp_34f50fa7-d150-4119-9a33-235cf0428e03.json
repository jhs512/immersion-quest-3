{
  "by": "hand",
  "source_sha256": "825c86b2b4876c2c58c0ebde052a3fb4eaa7f5ea59fabead8a8f307ac807d460",
  "entry": [
    {
      "action": "say",
      "text": "명령은 고정돼 있고, 그 명령이 읽을 두 변수를 직접 정하는 마지막 도전이에요.",
      "target": "text:아래 두 명령은 미리 정해져 있어요."
    },
    {
      "action": "say",
      "text": "폴더 이름은 day에서, 파일에 쓸 글은 memo에서 나와요.",
      "target": "text:2026-10-30 폴더 안의 memo.txt에 \"우유 사기\" 한 줄이 생겨야 해요."
    },
    {
      "action": "bash_command",
      "command": "day=2026-10-30",
      "say": "폴더 이름부터 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "날짜에는 공백이 없어서 따옴표 없이도 한 값이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "memo=\"우유 사기\"",
      "say": "메모는 공백이 있으니 큰따옴표로 묶어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo에 우유 사기 전체가 들어갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "mkdir \"$day\"",
      "say": "정해진 첫 명령을 그대로 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "2026-10-30 폴더가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"$memo\" > \"$day/memo.txt\"",
      "say": "정해진 둘째 명령도 그대로 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "폴더 안의 memo.txt에 메모를 썼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat 2026-10-30/memo.txt",
      "say": "파일을 직접 읽어 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "우유 사기 한 줄이 나왔어요. 요구한 파일과 같아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
