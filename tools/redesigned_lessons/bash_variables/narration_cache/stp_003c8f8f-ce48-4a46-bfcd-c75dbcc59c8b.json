{
  "by": "hand",
  "source_sha256": "3e9d3671613a73b30c26f14093f22bb334ba25f36f8494e98277c16977e3bf2c",
  "entry": [
    {
      "action": "say",
      "text": "파일 이름을 변수에 담아 두 명령에서 함께 쓰는 문제예요.",
      "target": "text:같은 파일 이름을 여러 명령에서 쓸 때는 변수에 한 번 담아 두면 편해요."
    },
    {
      "action": "bash_command",
      "command": "file=today.txt",
      "say": "파일 이름 today.txt를 file에 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이제 file이 파일 이름을 대신해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"우유 사기\" > \"$file\"",
      "say": "그 이름의 파일에 한 줄을 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Bash가 \"$file\"을 today.txt로 바꾼 뒤 그 파일에 썼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "ls",
      "say": "폴더 목록을 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "today.txt가 생겼어요. file이라는 이름의 파일은 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat \"$file\"",
      "say": "같은 변수로 내용을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "우유 사기 한 줄이 나왔어요. 이름을 바꿀 때는 file 한 곳만 고치면 돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"우유 사기\" > \"$fiel\"",
      "say": "이름을 fiel로 잘못 쓰면 어떻게 될까요?",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "No such file or directory가 나왔어요. 오타 난 변수가 빈 글자가 돼서 이름 없는 파일에 쓰려 했어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
