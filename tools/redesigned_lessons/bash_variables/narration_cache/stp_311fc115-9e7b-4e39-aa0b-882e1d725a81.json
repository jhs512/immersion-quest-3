{
  "by": "hand",
  "source_sha256": "59e5b787be10de70c7f057877293f190687b6f07d148559fedd64489f1c512fa",
  "entry": [
    {
      "action": "say",
      "text": "변수를 지운 뒤 같은 이름을 꺼내면 무엇이 나오는지 봐요.",
      "target": "text:unset a는 현재 셸에서 변수 a를 지워요."
    },
    {
      "action": "bash_command",
      "command": "a=4",
      "say": "a에 4를 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조용히 담겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"[$a]\"",
      "say": "대괄호 안에 꺼내 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "[4]가 나왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "unset a",
      "say": "이제 a를 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지우는 명령도 아무것도 출력하지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"[$a]\"",
      "say": "같은 명령으로 다시 꺼내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "대괄호 사이가 비었어요. 없는 변수는 오류 없이 빈 글자가 돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. $aa처럼 이름을 잘못 써도 오류가 나지 않아요. 빈 값이 그대로 다음 명령에 쓰여요.",
      "target": "text:지운 변수를 꺼내면 어떻게 되는지 확인해요."
    }
  ]
}
