  "entry": [
    {
      "action": "say",
      "text": "등호 양옆에 공백을 넣으면 무엇이 달라지는지 비교해요.",
      "target": "text:Bash에서는 공백이 명령 이름과 인자를 나눠요."
    },
    {
      "action": "bash_command",
      "command": "a = 4",
      "say": "띄어 쓴 할당부터 실행해 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "a: command not found가 나왔어요. Bash가 a를 명령 이름으로, =와 4를 인자로 읽었거든요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "a=4",
      "say": "공백 없이 다시 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 오류 없이 지나갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"$a\"",
      "say": "담긴 값을 꺼내 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "4가 나왔어요. 할당은 이름, 등호, 값을 붙여 써야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
