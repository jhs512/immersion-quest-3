  "entry": [
    {
      "action": "say",
      "text": "공백이 든 값을 그대로 담으면 어떻게 되는지부터 봐요.",
      "target": "text:우유와 사기 사이에 공백이 한 칸 있어요."
    },
    {
      "action": "bash_command",
      "command": "memo=우유 사기",
      "say": "따옴표 없이 담아 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "사기: command not found가 나왔어요. 공백 뒤의 사기를 명령 이름으로 읽었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"[$memo]\"",
      "say": "memo에 무엇이 남았는지 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "대괄호 사이가 비었어요. 셸의 memo에는 아무것도 담기지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "memo=\"우유 사기\"",
      "say": "이번엔 값 전체를 큰따옴표로 묶어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "따옴표 안의 공백은 단어를 나누지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"[$memo]\"",
      "say": "다시 꺼내 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "[우유 사기]가 나왔어요. 공백까지 한 값으로 담겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo=우유가 사기 명령에만 붙은 이유는 명령 앞 할당을 배우는 수업에서 다시 봐요.",
      "target": "text:memo=우유 사기를 실행해 나오는 메시지를 읽으세요."
    }
  ]
}
