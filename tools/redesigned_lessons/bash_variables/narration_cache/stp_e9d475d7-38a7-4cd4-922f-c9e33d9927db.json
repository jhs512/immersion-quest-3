{
  "by": "hand",
  "source_sha256": "72832f969280223abd0f6ca51f00325eacfcdf33d3457015f80f05b14cf600bb",
  "entry": [
    {
      "action": "say",
      "text": "담을 때 지킨 공백 네 칸이 꺼낼 때도 남는지 확인하는 문제예요.",
      "target": "text:이 간격을 그대로 memo.txt에 남겨야 해요."
    },
    {
      "action": "bash_command",
      "command": "memo=\"우유    사기\"",
      "say": "공백 네 칸을 넣어 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "값에는 공백 네 칸이 그대로 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo $memo",
      "say": "따옴표 없이 꺼내 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "우유 사기가 한 칸 간격으로 나왔어요. 따옴표가 없으면 Bash가 값을 공백에서 다시 나눠 단어 두 개로 넘겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"$memo\"",
      "say": "이번엔 큰따옴표로 감싸 꺼내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "네 칸이 그대로예요. 따옴표 안의 값은 한 덩어리로 넘어가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"$memo\" > memo.txt",
      "say": "같은 방법으로 파일에 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 화면 대신 memo.txt로 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "say": "파일 내용을 읽어 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "간격 네 칸이 파일에도 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. echo $memo > memo.txt로 쓰면 파일에는 한 칸만 남아요. 꺼낼 때도 따옴표로 감싸요.",
      "target": "text:echo $memo를 따옴표 없이 실행해 출력을 보세요."
    }
  ]
}
