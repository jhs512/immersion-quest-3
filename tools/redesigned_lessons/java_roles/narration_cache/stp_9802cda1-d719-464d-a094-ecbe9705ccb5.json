  "by": "hand",
  "source_sha256": "06eee6cf5cf508c1b583e91783867fbc4d256b14bd6b425726aea8d9425e8f6c",
  "entry": [
    {
      "action": "say",
      "text": "음수로 시작하려다 생성자가 예외를 던져요. try 안의 after까지 실행될까요?",
      "target": "problem"
    },
    {
      "action": "say",
      "text": "이번 스텝에 제공된 코드로 설명할게요. 직접 작성한 답은 해설 뒤에도 유지돼요.",
      "target": "problem"
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "잘못된 생성 조건을 알려 invalid만 출력해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "new Account(-1)",
      "after": "new Account(100)",
      "say": "유효한 시작 잔액으로 비교해요."
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "이제 생성 뒤 잔액 백과 after가 출력돼요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 예외가 나면 해당 try의 다음 문장을 그대로 이어 실행하지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "new Account(100)",
      "after": "new Account(-1)",
      "say": "문제의 잘못된 시작 조건으로 돌아와요."
    },
    {
      "action": "run",
      "say": "실행해서 실제 결과를 함께 확인해요.",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "원래 음수 시작은 catch로 이동해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "catch"
    }
  ]
}
