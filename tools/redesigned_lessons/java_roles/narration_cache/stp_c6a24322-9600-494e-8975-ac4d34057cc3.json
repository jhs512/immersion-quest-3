  "entry": [
    {
      "action": "say",
      "text": "잔액 balance는 private이라 Account 밖에서는 직접 읽을 수 없어요.",
      "target": "text:Account 클래스가 잔액 balance를 private으로 숨겼어요."
    },
    {
      "action": "say",
      "text": "지금 main은 필드를 직접 읽으려고 해요.",
      "target": "code:account.balance);"
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "private access"
    },
    {
      "action": "say",
      "text": "private access 컴파일 오류예요. 다른 클래스에서 private 필드에 닿을 수 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "account.balance);",
      "after": "account.balance());",
      "say": "공개 메서드 balance()를 호출하게 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "100이에요. 공개된 읽기 메서드로 잔액을 읽었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. private는 암호화가 아니라 접근 범위를 정하는 규칙이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "getter"
    }
  ]
}
