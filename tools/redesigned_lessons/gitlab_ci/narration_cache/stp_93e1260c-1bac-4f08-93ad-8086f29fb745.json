      "target": "lines:3"
    },
    {
      "action": "bash_command",
      "command": "git add .",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 프로세스에 전달할 MESSAGE 값을 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"CI 설정 변경\"",
      "target": "#git-demo-terminal"
    },
    {
