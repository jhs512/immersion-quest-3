{
  "by": "hand",
  "source_sha256": "97dfdfabc3290081ef62bbbb1c66cb836566eed42d2c4a635a232a4adc39d3bd",
  "entry": [
    {
      "action": "say",
      "text": "작업 컨테이너에서 report.txt를 만들었어요. 컨테이너가 끝난 뒤에도 GitLab에서 받아야 해요.",
      "target": "text:작업 컨테이너에서 report.txt를 만들었어요. 컨테이너가 끝난 뒤에도 GitLab에서 받아야 해요."
    },
    {
      "action": "patch_code",
      "file": ".gitlab-ci.yml",
      "before": "paths: [missing.txt]",
      "after": "paths: [report.txt]",
      "say": ".gitlab-ci.yml의 paths: [missing.txt] 부분을 paths: [report.txt]로 바꿔요.",
      "target": "lines:5"
    },
    {
      "action": "bash_command",
      "command": "git add .",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "실제 만들어지는 report.txt 경로를 등록했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"CI 설정 변경\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "컨테이너 밖에 보관할 파일 경로를 커밋했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git push",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "package가 끝나면 GitLab에서 report.txt를 내려받을 수 있어야 해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 로그의 글자가 아니라 GitLab에 업로드된 실제 파일을 읽어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
