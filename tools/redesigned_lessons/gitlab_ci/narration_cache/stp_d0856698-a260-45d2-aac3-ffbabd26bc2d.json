  "entry": [
    {
      "action": "say",
      "text": "새 프로젝트에서 검사가 실패하고 산출물 경로도 틀려요.",
      "target": "text:새 프로젝트에서 검사가 실패하고 산출물 경로도 틀려요."
    },
    {
      "action": "patch_code",
      "file": "check.sh",
      "before": "actual=4",
      "after": "actual=5",
      "say": "check.sh의 actual=4 부분을 actual=5로 바꿔요.",
      "target": "lines:1"
    },
    {
      "action": "patch_code",
      "file": ".gitlab-ci.yml",
      "before": "paths: [missing.txt]",
      "after": "paths: [result.txt]",
      "say": ".gitlab-ci.yml의 paths: [missing.txt] 부분을 paths: [result.txt]로 바꿔요.",
      "target": "lines:10"
    },
    {
      "action": "bash_command",
      "command": "git add .",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "검사 값과 실제 산출물 경로를 함께 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"CI 설정 변경\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 결함을 고친 변경을 한 커밋으로 기록했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git push",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "실제 검사 통과 뒤 만들어진 result.txt까지 확인해야 도전이 끝나요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 커밋의 성공·작업 순서·실제 산출물이 모두 맞아야 도전 통과예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
