{
  "by": "hand",
  "source_sha256": "d7d8687872f2fb71d5168167d25dabeb361cd03d5e97f5bb09878a5f6edc8d97",
  "entry": [
    {
      "action": "say",
      "text": "직접 실행하던 sh check.sh를 GitLab Runner가 실행하게 하세요.",
      "target": "text:직접 실행하던 sh check.sh를 GitLab Runner가 실행하게 하세요."
    },
    {
      "action": "patch_code",
      "file": ".gitlab-ci.yml",
      "before": "echo 준비",
      "after": "sh check.sh",
      "say": ".gitlab-ci.yml의 echo 준비 부분을 sh check.sh로 바꿔요.",
      "target": "lines:4"
    },
    {
      "action": "bash_command",
      "command": "git add .",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Runner가 실행할 명령을 설정 파일에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git commit -m \"CI 설정 변경\"",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "검사 명령을 자동화 설정에 기록한 커밋이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "git push",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이 커밋을 받은 GitLab이 check 작업을 예약해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "실행 주체가 내 터미널에서 Runner의 작업 컨테이너로 바뀌어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
