    {
      "action": "say",
      "text": "struct Stock은 재고 수 count와 코드 code를 한 묶음으로 담아요. 점(.) 뒤에 필드 이름을 써서 하나씩 읽어요. 두 필드를 읽은 결과를 고르는 문제예요.",
      "target": "text:같은 재고의 count와 code를 묶었어요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "count는 2, code는 7이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "{2, 7}",
      "after": "{5, 7}",
      "say": "count의 처음 값만 5로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "count만 5이고 code는 7로 남아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 필드 이름과 그 필드에 담긴 값은 달라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "{5, 7}",
      "after": "{2, 7}",
      "say": "처음 묶음으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "같은 묶음 안에서도 필드를 나눠 읽어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "fields"
    }
  ]
