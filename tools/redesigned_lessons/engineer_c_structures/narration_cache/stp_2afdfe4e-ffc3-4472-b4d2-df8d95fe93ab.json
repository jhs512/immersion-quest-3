  "entry": [
    {
      "action": "say",
      "text": "함수를 다른 함수의 인수로 넘기면, 받은 쪽은 그 함수를 불러 계산해요. apply가 안에서 무엇을 하는지 고르는 문제예요.",
      "target": "text:apply에 add_one을 넘겼어요."
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "넘겨받은 하나 더하기를 적용해 삼이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "apply(value, add_one)",
      "after": "apply(value, twice)",
      "say": "같은 호출에 다른 규칙을 넘겨요."
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "이번에는 두 배 규칙이라 사예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 호출할 함수의 매개변수와 반환 타입이 맞아야 해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "apply(value, twice)",
      "after": "apply(value, add_one)",
      "say": "처음 규칙으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "호출부와 함수 안의 규칙 적용을 연결해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "call"
    }
  ]
}
