{
  "by": "hand",
  "source_sha256": "2c2e1ef5ff43d1423f9ee96f3c6bb072e0d26246af1afcbb49d3871c840e6ea7",
  "entry": [
    {
      "action": "say",
      "text": "두 값의 같은 자리가 모두 1인 비트만 남겨야 해요. 비트 AND 연산자 &를 써요.",
      "target": "text:value 줄을 고쳐 flags와 mask의 같은 자리가 모두 1인 비트만 남기세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 아직 연산 없이 0을 넣었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    unsigned int value = 0u;\n",
      "after": "    unsigned int value = flags & mask;\n",
      "say": "0u를 flags & mask로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "1이에요. 101과 011에서 둘 다 1인 자리는 맨 오른쪽 하나라 1이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. &&를 쓰면 자리마다 비교하지 않고 참 거짓만 봐요. 12와 10이면 & 결과는 8인데 &&는 1이에요.",
      "target": "code:flags & mask"
    }
  ]
}
