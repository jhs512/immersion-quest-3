  "entry": [
    {
      "action": "say",
      "text": "두 값이 모두 0이 아닌지 판단해야 해요. 자리별 & 대신 논리 AND &&를 써요.",
      "target": "text:both 줄을 고쳐 두 값이 모두 0이 아닌지 논리 AND로 판단하세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 2는 10, 1은 01이라 같은 자리에 함께 켜진 1이 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int both = a & b;\n",
      "after": "    int both = a && b;\n",
      "say": "&를 &&로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "1이에요. 두 값이 모두 0이 아니라서 참 1이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 둘 다 0이 아닌데 &는 0이 될 수 있어요. 조건 판단에는 &&를 써요.",
      "target": "code:a && b"
    }
  ]
}
