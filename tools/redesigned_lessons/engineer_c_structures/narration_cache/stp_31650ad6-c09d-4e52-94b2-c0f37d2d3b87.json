{
  "by": "hand",
  "source_sha256": "440eb960eb34ccc234a7d475be17aa23f8b725670769bb648a42743fb52ad456",
  "entry": [
    {
      "action": "say",
      "text": "구조체 포인터에서는 화살표(->)로 필드를 골라요. p->count가 어떤 식과 같은 뜻인지 고르는 문제예요.",
      "target": "text:p로 같은 구조체의 필드를 고쳤어요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "같은 구조체의 count가 오예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "p->count = 5;",
      "after": "(*p).count = 5;",
      "say": "간접 참조 뒤 필드를 읽는 표기로 비교해요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "같은 대상이라 결과도 오예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. (*p).count의 괄호는 먼저 p가 가리킨 구조체를 읽게 해요. 괄호 없이 *p.count로 쓰면 뜻이 달라져요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "(*p).count = 5;",
      "after": "p->count = 5;",
      "say": "간단한 화살표 표기로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "포인터를 통해 원래 필드를 바꿨어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "indirect"
    }
  ]
}
