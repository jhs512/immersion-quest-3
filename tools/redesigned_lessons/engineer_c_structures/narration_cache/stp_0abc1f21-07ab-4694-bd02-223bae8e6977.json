{
  "by": "hand",
  "source_sha256": "b9c1779ee8d8a7e914ee3f49096060f739f4d80eee166153674aee219e0a23ee",
  "entry": [
    {
      "action": "say",
      "text": "같은 두 값에 논리 AND를 쓰면 무엇이 나오는지 따지는 문제예요. 값이 0인지 아닌지만 봐요.",
      "target": "text:&&는 두 값이 모두 0이 아니면 참(1), 하나라도 0이면 거짓(0)을 돌려줘요."
    },
    {
      "action": "say",
      "text": "2와 1은 둘 다 0이 아니에요.",
      "target": "code:2u && 1u"
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "참이라 1이 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "2u && 1u",
      "after": "2u & 1u",
      "say": "앰퍼샌드 하나짜리 비트 AND로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 2는 1 0, 1은 0 1이라 함께 1인 자리가 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "2u & 1u",
      "after": "2u && 1u",
      "say": "논리 AND로 되돌려요."
    },
    {
      "action": "say",
      "text": "조심하세요. 기호 하나 차이로 결과가 1과 0으로 갈려요. 조건을 이을 때는 &&를 써요.",
      "target": "code:int value"
    },
    {
      "action": "fill_answer",
      "value": "1"
    }
  ]
}
