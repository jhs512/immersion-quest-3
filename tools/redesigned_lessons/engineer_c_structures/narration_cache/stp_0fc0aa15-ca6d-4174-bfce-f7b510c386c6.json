  "entry": [
    {
      "action": "say",
      "text": "저장소 하나를 두 이름이 가리키는 상황이에요. q로 쓴 값을 p로 읽을 때를 따지는 문제예요.",
      "target": "text:int *q = p;는 새 저장소를 만들지 않고 같은 주소를 복사해요."
    },
    {
      "action": "say",
      "text": "q로 9를 쓰고 p로 읽어요.",
      "target": "code:*q = 9;"
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "9예요. 같은 저장소예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "*q = 9;",
      "after": "*p = 9;",
      "say": "이번엔 p로 직접 써 볼게요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "결과는 같은 9예요. 어느 이름으로 써도 한 저장소에 써요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "*p = 9;",
      "after": "*q = 9;",
      "say": "q로 쓰는 줄로 되돌려요."
    },
    {
      "action": "say",
      "text": "조심하세요. 이름이 둘이어도 할당은 하나라서 free도 한 번만 해요.",
      "target": "code:free(p);"
    },
    {
      "action": "fill_answer",
      "value": "9"
    }
  ]
}
