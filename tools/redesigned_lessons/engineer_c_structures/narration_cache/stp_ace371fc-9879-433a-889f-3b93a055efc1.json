  "entry": [
    {
      "action": "say",
      "text": "구조체를 대입하면 모든 필드 값이 새 변수로 복사돼요. 복사본 b를 고치면 원본 a도 바뀌는지가 질문이에요.",
      "target": "text:b에 a의 구조체 값을 대입했어요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "별도 값으로 복사해서 a는 2, b는 5예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "b.count = 5;",
      "after": "b.count = 9;",
      "say": "복사본의 재고만 9로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "a는 여전히 2이고 b만 9예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 구조체 값 대입은 같은 대상을 가리키는 포인터 대입과 달라요. b는 a의 복사본이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "b.count = 9;",
      "after": "b.count = 5;",
      "say": "처음 수정값으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "값 복사와 대상 공유를 나눠 읽어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "copy"
    }
  ]
}
