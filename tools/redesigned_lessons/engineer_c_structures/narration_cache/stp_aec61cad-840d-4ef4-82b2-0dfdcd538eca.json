  "source_sha256": "4b4ecb6f628b82c71ab6be2d9a8bffd69a700a8a65cbb8d13c07672fd7ac6cd4",
  "entry": [
    {
      "action": "say",
      "text": "확보, 실패 확인, 저장, 읽기, 해제의 순서를 따라 정상 경로의 출력을 적는 문제예요.",
      "target": "text:malloc은 저장소를 확보만 하고 값은 채우지 않아요."
    },
    {
      "action": "say",
      "text": "p == NULL이면 바로 끝내고, 아니면 7을 저장해요.",
      "target": "code:if (p == NULL) return 1;"
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "저장한 7을 읽었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "*p = 7;",
      "after": "*p = 4;",
      "say": "저장하는 값을 4로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "4가 나와요. 읽는 값은 확보할 때가 아니라 저장한 값이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "*p = 4;",
      "after": "*p = 7;",
      "say": "7로 되돌려요."
    },
    {
      "action": "say",
      "text": "조심하세요. 저장하기 전에 malloc한 칸을 읽으면 정해진 값이 없어요.",
      "target": "code:*p = 7;"
    },
    {
      "action": "fill_answer",
      "value": "7"
    }
  ]
}
