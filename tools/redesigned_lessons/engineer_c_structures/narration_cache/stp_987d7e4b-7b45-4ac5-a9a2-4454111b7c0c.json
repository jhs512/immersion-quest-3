    {
      "action": "say",
      "text": "지금 rule은 두 배 함수를 가리켜요. 요구는 하나 늘리기라서 대입할 함수 이름 한 곳을 고치는 문제예요.",
      "target": "text:선택한 함수 이름 한 곳만 고치세요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "지금은 두 배를 계산해 4예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "= twice;",
      "after": "= add_one;",
      "say": "하나 더하는 함수로 선택을 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "같은 입력에 하나를 더해 3이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 결과 3을 고정하면 다른 입력을 놓쳐요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "value = 2;",
      "after": "value = 5;",
      "say": "입력이 5여도 규칙을 적용해요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "하나 더해 6을 얻었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "value = 5;",
      "after": "value = 2;",
      "say": "처음 입력으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "선택한 함수와 실제 결과를 확인했어요.",
      "target": "output"
    }
  ]
