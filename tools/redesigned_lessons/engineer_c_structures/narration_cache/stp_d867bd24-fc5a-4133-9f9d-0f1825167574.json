  "entry": [
    {
      "action": "say",
      "text": "해제한 뒤 이름 하나만 NULL로 바꿨을 때, 다른 이름도 함께 비워지는지 따지는 문제예요.",
      "target": "text:q는 해제 전에 같은 주소를 복사한 별칭이에요."
    },
    {
      "action": "say",
      "text": "NULL을 대입한 것은 p뿐이에요.",
      "target": "code:p = NULL;"
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "0이에요. q는 여전히 해제된 저장소의 주소를 들고 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": ", q == NULL)",
      "after": ", p == NULL)",
      "say": "같은 비교를 p로 해 볼게요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "p는 1이에요. 대입한 이름만 비워졌어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": ", p == NULL)",
      "after": ", q == NULL)",
      "say": "q 비교로 되돌려요."
    },
    {
      "action": "say",
      "text": "조심하세요. q로 *q를 읽거나 다시 free하면 안 돼요. 해제한 뒤에는 모든 별칭을 쓰지 않거나 함께 NULL로 바꿔요.",
      "target": "code:int *q = p;"
    },
    {
      "action": "fill_answer",
      "value": "0"
    }
  ]
}
