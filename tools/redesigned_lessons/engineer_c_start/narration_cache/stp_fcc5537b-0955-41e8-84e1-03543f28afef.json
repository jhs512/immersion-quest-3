    {
      "action": "say",
      "text": "shown = stock은 그 순간의 값을 복사해요. 그 뒤에 stock만 바꾸면 shown도 따라 바뀌는지가 질문이에요.",
      "target": "text:표시용 값을 복사한 뒤 재고만 정정했어요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "현재 재고는 5, 복사한 표시값은 2예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 5",
      "after": "stock = 9",
      "say": "재고만 9로 다시 바꿔 봐요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "9와 2예요. 표시값은 자동으로 따라가지 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 두 정수 변수는 서로 다른 저장값이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 9",
      "after": "stock = 5",
      "say": "주어진 정정값 5로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "이 문제에서는 5와 2가 차례로 나와요.",
      "target": "output"
    },
    {
      "action": "fill_answer",
      "value": "5 2"
    }
  ]
