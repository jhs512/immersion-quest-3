{
  "by": "hand",
  "source_sha256": "3c76f1c25fe62fa8e52b471ec85c9cdf25150052d1451225206f128a03d61a20",
  "entry": [
    {
      "action": "say",
      "text": "앞 문제에서 옮겨 온 guide.txt를 그대로 써요. 아직 커밋이 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "앞에서 옮긴 기본 안내가 그대로 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안내 파일을 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "기본 안내"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에 첫 기록이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 main 앞에 있어요. 지금 작업하는 브랜치예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 앞 문제의 파일과 기록을 그대로 이어서 써요.",
      "target": "#git-demo-terminal"
    }
  ]
}
