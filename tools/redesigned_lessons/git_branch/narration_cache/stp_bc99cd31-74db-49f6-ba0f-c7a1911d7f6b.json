  "entry": [
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "say": "이미 만들어 둔 feature로 작업을 옮겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "--show-current"
      ],
      "say": "지금 작업하는 브랜치를 다시 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 feature가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치를 바꾸는 건 새 기록을 만드는 일이 아니에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
