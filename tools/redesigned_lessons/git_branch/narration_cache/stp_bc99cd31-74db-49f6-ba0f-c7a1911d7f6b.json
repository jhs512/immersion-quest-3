  "entry": [
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "say": "git switch feature로 현재 브랜치를 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "git branch로 목록을 봐요. 별표가 현재 위치예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature 앞에 별표가 있어요. 이제 feature에서 작업하고 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치를 바꾸기만 해서는 새 커밋이 생기지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
