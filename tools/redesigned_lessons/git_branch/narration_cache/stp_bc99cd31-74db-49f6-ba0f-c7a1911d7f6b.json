  "entry": [
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "say": "git switch feature로 현재 브랜치를 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "--show-current"
      ],
      "say": "git branch --show-current로 결과를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature가 나와요. 이제 feature에서 작업하고 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치를 바꾸기만 해서는 새 커밋이 생기지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
