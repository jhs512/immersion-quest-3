  "entry": [
    {
      "action": "say",
      "text": "앞에서 만든 feature로 옮겨요. 아직 어느 쪽에서도 안내문을 수정하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "전환 전에는 기본 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치를 feature로 바꿨어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 feature로 옮겨졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일 내용은 같아요. 아직 두 브랜치가 같은 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆 그래프에서 HEAD와 브랜치 위치를 비교해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "전환은 현재 브랜치를 바꾸며 파일을 복제하지 않아요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. 앞 문제의 파일과 기록을 그대로 이어서 써요.",
      "target": "#git-demo-terminal"
    }
  ]
}
