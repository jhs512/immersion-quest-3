{
  "by": "hand",
  "source_sha256": "2d299b4f652ddbda393d85fca2fa7f1f5bc84835c7f1d95813c7cede3088948a",
  "entry": [
    {
      "action": "say",
      "text": "앞 문제에서 직접 바꾼 안내를 기록해요. main의 기본 안내는 그대로 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "직접 바꾼 메모 기능 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "수정한 안내를 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "메모 기능"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에 새 기록이 생겼어요. main은 이전 기록에 남아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main의 커밋에는 아직 기본 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆 그래프에서 HEAD와 브랜치 위치를 비교해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "커밋은 현재 브랜치의 끝만 이동시켜요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일 수정과 커밋은 서로 다른 행동이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
