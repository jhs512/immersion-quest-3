{
  "by": "hand",
  "source_sha256": "ac02827163ef429392cba607c743df19367d8ed535e5130deb76006387bb89cf",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "add",
        "--",
        "guide.txt"
      ],
      "say": "고쳐 둔 안내 파일을 기록할 준비부터 해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "새 안내"
      ],
      "say": "준비한 내용을 feature의 새 기록으로 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "현재 기록의 안내 내용을 확인해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "맨 위 안내가 메모를 남기라는 문구로 바뀌었죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "say": "main의 안내 내용도 따로 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "여기에는 기본 안내가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 한 브랜치의 새 기록이 다른 브랜치를 옮기지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
