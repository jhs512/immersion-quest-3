{
  "by": "hand",
  "source_sha256": "4a4fb1b276e4b53e4324d1ab0232d60b3c1a7d982a91cc11e4a8375e51d130a1",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "git add로 수정한 guide.txt를 준비 영역에 넣어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "새 안내"
      ],
      "say": "새 안내라는 설명으로 feature에 커밋해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "feature가 새 커밋에 있어요. main은 그 아래 이전 커밋에 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "git show로 현재 커밋의 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 줄에 안내: 메모를 남겨요가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "say": "main의 커밋에 담긴 guide.txt도 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에는 안내: 기본 안내가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. feature에서 커밋해도 main의 커밋은 바뀌지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
