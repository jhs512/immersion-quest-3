{
  "by": "hand",
  "source_sha256": "14613dfe0fe94145e05ace35bd52ab086f256eb1404f8f911e787c475139ce74",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "add",
        "--",
        "guide.txt"
      ],
      "say": "git add로 수정한 guide.txt를 준비 영역에 넣어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "새 안내"
      ],
      "say": "새 안내라는 설명으로 feature에 커밋해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "git show로 현재 커밋의 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 줄에 안내: 메모를 남겨요가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "say": "main의 커밋에 담긴 guide.txt도 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에는 안내: 기본 안내가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. feature에서 커밋해도 main의 커밋은 바뀌지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
