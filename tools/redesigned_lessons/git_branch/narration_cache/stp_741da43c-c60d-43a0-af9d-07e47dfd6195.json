{
  "by": "hand",
  "source_sha256": "2c8fb6740d6e8cb740793322ec1c7bee6b81b63ba468e0e1d4103bddeff2aa43",
  "entry": [
    {
      "action": "say",
      "text": "문의 안내 검토도 끝났어요. 두 번째 작업을 main에 반영해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치는 main이에요. 문의 안내를 합쳐 두 작업의 결과를 함께 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "feature2"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에 두 번째 작업을 합쳤어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모 기능과 문의 안내가 함께 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 main과 이전 작업 이름들을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 기록하지 않은 변경 없이 작업을 마쳤어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆 그래프에서 HEAD와 브랜치 위치를 비교해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "같은 생성·전환·기록·병합 흐름을 다시 설명할 수 있어요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. merge는 지금 작업 중인 브랜치에 반영해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
