{
  "by": "hand",
  "source_sha256": "cbbba906135e38f3fb8b439f656b91750ea6f894b227b73e306bd54900c384a8",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "merge",
        "--no-edit",
        "feature"
      ],
      "say": "같은 파일의 서로 다른 부분을 합쳐 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "합친 안내 파일의 위와 아래를 살펴봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "새 안내와 바뀐 문의 창구가 모두 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 같은 파일을 고쳤다고 항상 충돌하지는 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "auto-merge"
    },
    {
      "action": "say",
      "text": "서로 다른 부분은 자동으로 합쳐졌어요.",
      "target": "answer:auto-merge"
    }
  ]
}
