{
  "by": "hand",
  "source_sha256": "c710fc0d42f42c31c483934f5ad1124f9857dfa920d0d5b89b7f7b4c178f2da3",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 메모 기능 안내를 맡겼어요. 배포용 main은 두고 feature에서 준비해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에 앞에서 남긴 기본 안내 커밋이 있어요. 별도의 작업 이름 feature를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치는 main이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "feature"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "같은 커밋을 가리키는 feature가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature가 생겼지만 별표는 아직 main 앞에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆 그래프에서 HEAD와 브랜치 위치를 비교해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "브랜치를 만들어도 현재 브랜치는 그대로임을 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치를 만들기만 하면 현재 브랜치는 바뀌지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
