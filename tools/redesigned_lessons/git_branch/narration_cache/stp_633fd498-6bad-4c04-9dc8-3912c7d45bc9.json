  "entry": [
    {
      "action": "git_command",
      "args": [
        "branch",
        "feature"
      ],
      "say": "다른 작업에 쓸 브랜치 이름을 만들어 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "--show-current"
      ],
      "say": "현재 작업하는 브랜치 이름도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main이 나와요. 이름을 만들어도 이동하지는 않죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치 생성과 전환은 다른 행동이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
