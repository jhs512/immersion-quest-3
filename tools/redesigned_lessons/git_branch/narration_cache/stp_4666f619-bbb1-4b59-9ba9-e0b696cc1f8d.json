{
  "by": "hand",
  "source_sha256": "f7e070988cb7f6c0e95d5686708856d6fefae85c39b35ad4eaa8a20681c8771f",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "restore",
        "--source=feature",
        "--worktree",
        "--",
        "guide.txt"
      ],
      "say": "작업 파일에 feature의 안내를 가져올게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff",
        "--name-only",
        "--diff-filter=U"
      ],
      "say": "파일을 바꾼 뒤 미병합 경로도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "guide.txt가 아직 나와요. 인덱스는 해결 전이죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 충돌 표시를 지우는 것만으로는 부족해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "--",
        "guide.txt"
      ],
      "say": "이제 선택한 안내를 인덱스에 준비해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "선택한 내용이 준비됐는지 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "충돌은 해결됐지만 병합 커밋은 아직 남아 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
