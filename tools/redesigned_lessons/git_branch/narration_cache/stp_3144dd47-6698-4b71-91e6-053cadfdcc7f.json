  "by": "hand",
  "source_sha256": "3043c229eb18ceeab2d10cc24f7703158bb3b6e038d18563cfe5f2d05e53588b",
  "entry": [
    {
      "action": "say",
      "text": "팀에서 상담 창구 안내를 추가해 달래요. 메모 안내는 유지해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치는 feature2예요. 메모 기능은 보존하고 문의 안내만 한 줄 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 메모 기능 안내를 먼저 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 꺾쇠로 기존 내용 뒤에 한 줄을 덧붙였어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모 기능 아래에 문의 안내가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 줄은 그대로이고 문의 줄만 추가됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 한 꺾쇠는 덮어쓰고 두 꺾쇠는 뒤에 붙여요.",
      "target": "#git-demo-terminal"
    }
  ]
}
