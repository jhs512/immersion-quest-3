  "entry": [
    {
      "action": "say",
      "text": "상담 창구 안내를 한 줄 더해요. 메모 기능 줄은 지우지 않아야 해요.",
      "target": "text:팀에서 상담 창구 안내를 추가해 달래요."
    },
    {
      "action": "say",
      "text": "그래서 이번엔 꺾쇠 두 개로 기존 내용 뒤에 붙여요.",
      "target": "text:메모 기능은 보존하고 문의 안내만 한 줄 더해요."
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 메모 기능 안내를 먼저 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"문의: 상담 창구\" >> guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 꺾쇠로 기존 내용 뒤에 한 줄을 덧붙였어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모 기능 아래에 문의 안내가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 줄은 그대로이고 문의 줄만 추가됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. > 로 쓰면 메모 기능 줄이 지워지고 문의 줄만 남아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
