{
  "by": "hand",
  "source_sha256": "4c2dde3f308dd3f7296a478df7b1e93c99e0330db506ad648bdf26fb89f1fe1d",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 반영 전에 배포본과 작업본을 비교해 달래요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에는 메모 기능을 기록했어요. main으로 돌아가 파일이 어떻게 보이는지 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature의 메모 기능 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "main"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main으로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기본 안내로 돌아왔어요. feature의 기록이 사라진 것은 아니에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "feature:guide.txt"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에는 메모 기능 안내가 그대로 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 앞 문제의 파일과 기록을 그대로 이어서 써요.",
      "target": "#git-demo-terminal"
    }
  ]
}
