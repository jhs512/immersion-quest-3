{
  "by": "hand",
  "source_sha256": "849731228af12d39e2713771a83692af6609bc6e76e8da6bbe554266a76d29d9",
  "entry": [
    {
      "action": "say",
      "text": "팀장이 배포본 main과 작업본 feature를 비교해 달래요. main으로 돌아가 guide.txt 내용이 어떻게 바뀌는지 봐요.",
      "target": "text:팀장이 반영 전에 배포본과 작업본을 비교해 달래요."
    },
    {
      "action": "say",
      "text": "feature에는 메모 기능이 기록돼 있어요.",
      "target": "text:feature에는 메모 기능을 기록했어요."
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature의 메모 기능 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main으로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기본 안내로 돌아왔어요. feature의 기록이 사라진 것은 아니에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "feature:guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에는 메모 기능 안내가 그대로 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. main에서 기본 안내가 보여도 feature의 커밋이 지워진 게 아니에요. show로 다른 브랜치의 파일을 확인할 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
