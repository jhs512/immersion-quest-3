{
  "by": "hand",
  "source_sha256": "40d8a2d34e64bbd50609547aa65b44ce1142597fde62c6ab9469b72af3bad9f2",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "merge",
        "--no-edit",
        "feature"
      ],
      "say": "이번에는 양쪽에 새 기록이 있어요. 합쳐 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "합친 기록의 안내 문구부터 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "새 안내가 반영돼 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:operations.txt"
      ],
      "say": "main에서 추가한 운영 메모도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "운영 메모도 남아 있죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "-1",
        "--format=%P"
      ],
      "say": "이번 기록의 부모들을 확인해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "서로 다른 두 부모 기록이 이어져 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 병합 방향은 지금 작업하는 브랜치예요.",
      "target": "#git-demo-terminal"
    }
  ]
}
