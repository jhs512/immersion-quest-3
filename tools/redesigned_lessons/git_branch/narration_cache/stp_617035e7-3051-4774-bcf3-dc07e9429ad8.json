{
  "by": "hand",
  "source_sha256": "11522b2fa3656d5f3157dac243acc65c8474da2428b436031d80b4de0e5e2e62",
  "entry": [
    {
      "action": "say",
      "text": "문의 안내를 합치기 전에 main으로 돌아가 아직 없는 줄을 확인해요.",
      "target": "text:main에 아직 없는 줄을 확인해요."
    },
    {
      "action": "say",
      "text": "feature2에는 문의 안내까지, main에는 메모 기능까지 있어요.",
      "target": "text:feature2에 문의 안내까지 기록했어요."
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "main"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main으로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 main 앞에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에는 메모 기능만 있고 문의 줄은 아직 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "feature2:guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature2에는 문의 안내까지 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "합치기 전에 두 쪽의 파일을 비교해 두면, 합친 뒤 무엇이 들어왔는지 바로 확인할 수 있어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
