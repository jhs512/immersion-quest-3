{
  "by": "hand",
  "source_sha256": "18460581d61c10d573f9e39baf991c9aa97cf9e7def9521f109d185fa74dba6d",
  "entry": [
    {
      "action": "say",
      "text": "문의 안내도 검토할 차례예요. main에 아직 없는 줄을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature2에 문의 안내까지 기록했어요. 합치기 전에 main의 파일을 다시 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "main"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main으로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 main 앞에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에는 메모 기능만 있고 문의 줄은 아직 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "feature2:guide.txt"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature2에는 문의 안내까지 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 앞 문제의 파일과 기록을 그대로 이어서 써요.",
      "target": "#git-demo-terminal"
    }
  ]
}
