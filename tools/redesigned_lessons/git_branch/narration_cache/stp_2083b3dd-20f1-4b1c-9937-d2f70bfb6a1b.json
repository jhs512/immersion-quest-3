{
  "by": "hand",
  "source_sha256": "81c0301cbd56facf4bed3b9de398d796c9e63b517f3e813b4896fa0574e1ebe7",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 메모 기능은 memo 브랜치에서 만들어 main에 반영하고, 검색 기능은 반영된 main에서 search 브랜치로 시작해요.",
      "target": "text:검색 기능은 메모 기능이 반영된 main에서 시작해야 해요."
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "memo"
      ],
      "say": "memo 브랜치를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없어요. memo가 지금 main과 같은 커밋을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "memo"
      ],
      "say": "memo로 옮겨 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Switched to branch 'memo'가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"메모: 메모를 남겨요\" >> guide.txt",
      "say": "메모 안내 한 줄을 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 guide.txt가 두 줄이 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "두 줄을 준비 영역에 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없어요. 메모 줄이 준비됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "메모 기능"
      ],
      "say": "memo 브랜치에 커밋해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "memo 브랜치에만 새 기록이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "main"
      ],
      "say": "main으로 돌아가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main의 guide.txt는 아직 한 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "memo"
      ],
      "say": "memo를 main에 합쳐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Fast-forward예요. main이 메모 기능 커밋으로 옮겨 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "search"
      ],
      "say": "합쳐진 main에서 search 브랜치를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "search는 지금 main과 같은 커밋에서 출발해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "search"
      ],
      "say": "search로 옮겨 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Switched to branch 'search'가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"검색: 메모를 찾아요\" >> guide.txt",
      "say": "검색 안내 한 줄을 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "guide.txt가 세 줄이 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "세 줄을 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없어요. 검색 줄이 준비됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "검색 기능"
      ],
      "say": "search에 커밋해요. main에는 아직 합치지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "search만 한 커밋 앞서 있어요. main과 memo는 메모 기능 커밋에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "브랜치 목록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 search에 있어요. memo, main도 함께 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 병합하기 전에 search를 만들면 메모 안내가 없는 옛 main에서 출발해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
