{
  "by": "hand",
  "source_sha256": "b434234d21957eb60680a986994d9e9bb12ba6184cab9106db7384e70ee2490f",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "commit",
        "--no-edit"
      ],
      "say": "이미 준비된 내용으로 병합 기록을 마쳐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "마친 기록에 선택한 안내가 담겼는지 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에서 선택한 안내가 들어 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "-1",
        "--format=%P"
      ],
      "say": "두 작업의 부모 기록도 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "부모가 두 개예요. 양쪽 이력이 이어져 있죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status",
        "--porcelain"
      ],
      "say": "마지막으로 남은 변경이 있는지 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아무 줄도 없어요. 병합을 마쳤어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 브랜치를 억지로 옮기는 것과 병합은 달라요.",
      "target": "#git-demo-terminal"
    }
  ]
}
