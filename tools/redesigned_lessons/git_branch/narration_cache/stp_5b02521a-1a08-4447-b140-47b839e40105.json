{
  "by": "hand",
  "source_sha256": "dc4c9a8b83524bb7713d29ee8bc92e8a74219f88d8c76fcda3e75a4aea9994d6",
  "entry": [
    {
      "action": "say",
      "text": "첫 요청은 기본 안내를 메모 기능 안내로 바꾸는 거예요.",
      "target": "text:첫 요청이에요."
    },
    {
      "action": "say",
      "text": "지금은 feature에 있어요. 파일만 고치고 아직 커밋은 하지 않아요.",
      "target": "text:현재 브랜치는 feature예요."
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "수정 전의 기본 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모 기능\" > guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 파일을 메모 기능 안내로 바꿨어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에 직접 쓴 새 안내를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지운 줄과 새로 쓴 줄의 차이가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일을 고친 것만으로는 feature의 기록이 바뀌지 않아요. git diff는 기록과 파일의 차이를 보여 줄 뿐이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
