  "entry": [
    {
      "action": "say",
      "text": "첫 요청이에요. 기본 안내를 메모 기능 안내로 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치는 feature예요. 기본 안내를 메모 기능 안내로 직접 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "수정 전의 기본 안내예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"안내: 메모 기능\" > guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "작업 파일을 메모 기능 안내로 바꿨어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에 직접 쓴 새 안내를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지운 줄과 새로 쓴 줄의 차이가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일 수정과 커밋은 서로 다른 행동이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
