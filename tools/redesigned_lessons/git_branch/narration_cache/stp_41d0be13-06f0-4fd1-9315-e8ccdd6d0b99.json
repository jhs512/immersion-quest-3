{
  "by": "hand",
  "source_sha256": "7e6ae8322f16f4965901f81c3d3c8b5ee334f347bdc091dd6e45d1025a56782e",
  "entry": [
    {
      "action": "say",
      "text": "10번에서 더한 문의 안내를 feature2에 기록해요. main과 feature는 아직 메모 기능 커밋에 있어요.",
      "target": "text:main과 첫 feature는 아직 메모 기능 커밋에 있어요."
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내를 준비 영역에 담았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "문의 안내"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature2가 새 커밋으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에는 문의 줄이 아직 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "그래프에서 feature2만 한 칸 나아갔어요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. add 없이 commit하면 수정이 기록되지 않아요. 준비 영역에 담은 것만 커밋돼요.",
      "target": "#git-demo-terminal"
    }
  ]
}
