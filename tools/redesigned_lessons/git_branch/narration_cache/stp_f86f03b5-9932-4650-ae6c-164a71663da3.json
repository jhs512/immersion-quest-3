  "entry": [
    {
      "action": "say",
      "text": "메모 안내 검토가 끝났어요. 배포용 main에 반영해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "현재 브랜치는 main이에요. feature에서 완성한 안내를 main에 가져와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 main 앞에 있는지 먼저 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "합치기 전에는 기본 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "feature"
      ],
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main이 feature의 기록까지 앞으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "화면의 명령을 한 번 실행해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에서도 메모 기능 안내가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆 그래프에서 HEAD와 브랜치 위치를 비교해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "merge는 다른 브랜치의 기록을 현재 브랜치에 반영해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. merge는 지금 작업 중인 브랜치에 반영해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
