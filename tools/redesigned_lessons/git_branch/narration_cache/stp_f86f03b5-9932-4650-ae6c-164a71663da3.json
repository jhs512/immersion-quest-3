  "entry": [
    {
      "action": "git_command",
      "args": [
        "merge",
        "feature"
      ],
      "say": "main에 feature의 새 안내를 반영해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "branch",
        "-v"
      ],
      "say": "두 브랜치가 가리키는 기록을 비교해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 두 이름이 같은 새 기록을 가리켜요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에 다른 새 기록이 없어서 앞으로 이동한 거예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 병합할 때마다 두 부모 커밋이 생기지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
