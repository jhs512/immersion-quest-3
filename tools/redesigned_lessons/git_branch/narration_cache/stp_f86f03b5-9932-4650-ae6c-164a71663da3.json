  "entry": [
    {
      "action": "say",
      "text": "검토가 끝나서 feature의 메모 기능을 배포용 main에 합쳐요.",
      "target": "text:메모 안내 검토가 끝났어요."
    },
    {
      "action": "say",
      "text": "merge는 지금 있는 브랜치에 다른 브랜치를 가져와요. 그래서 main에 있는지 먼저 확인해요.",
      "target": "text:현재 브랜치는 main이에요."
    },
    {
      "action": "git_command",
      "args": [
        "branch"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "별표가 main 앞에 있는지 먼저 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "합치기 전에는 기본 안내가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "feature"
      ],
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main이 feature의 기록까지 앞으로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "main에서도 메모 기능 안내가 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "main은 feature 커밋까지 앞으로 이동했어요. 그사이 main에 새 커밋이 없어서 그대로 따라간 거예요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "조심하세요. feature에서 git merge main을 실행하면 반대로 feature가 바뀌어요. 합칠 곳에 먼저 서 있어야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
