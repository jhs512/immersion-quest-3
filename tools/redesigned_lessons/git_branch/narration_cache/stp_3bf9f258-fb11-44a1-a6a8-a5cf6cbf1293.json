{
  "by": "hand",
  "source_sha256": "dca6416cd9f7735a01789ebcc344159b12d5298f8c63a2e05527eb52da1ec330",
  "entry": [
    {
      "action": "say",
      "text": "병합은 지금 서 있는 브랜치를 바꿔요.",
      "target": "text:feature에서 main을 병합해 두 안내를 모두 반영하세요"
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "target": "#git-demo-terminal",
      "say": "병합을 받을 feature로 전환해요."
    },
    {
      "action": "say",
      "text": "지금 서 있는 브랜치가 feature예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "합치기 전 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 메모 기능 한 줄만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "main"
      ],
      "target": "#git-demo-terminal",
      "say": "feature에 main의 기록을 합쳐요."
    },
    {
      "action": "say",
      "text": "Fast-forward예요. feature가 main의 위치로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "바뀐 feature의 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내도 함께 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "main의 내용도 확인해요."
    },
    {
      "action": "say",
      "text": "main은 원래 두 줄 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. merge 뒤에 적은 브랜치가 바뀌는 게 아니에요. 지금 있는 브랜치가 바뀌어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
