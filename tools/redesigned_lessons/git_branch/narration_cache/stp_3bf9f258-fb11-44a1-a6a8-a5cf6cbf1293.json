{
  "by": "hand",
  "source_sha256": "074067ac25a26eb57f1aebc94335d9cc46c5c74c20e4c3c3e6a54777153b9051",
  "entry": [
    {
      "action": "say",
      "text": "main에는 두 안내가 있고, feature는 메모 기능 기록에 머물러 있어요. feature로 옮겨 main을 합쳐요.",
      "target": "text:main에는 메모 기능과 문의 안내가 모두 있어요."
    },
    {
      "action": "git_command",
      "args": [
        "switch",
        "feature"
      ],
      "target": "#git-demo-terminal",
      "say": "병합을 받을 feature로 전환해요."
    },
    {
      "action": "say",
      "text": "지금 서 있는 브랜치가 feature예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "합치기 전 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 메모 기능 한 줄만 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "merge",
        "main"
      ],
      "target": "#git-demo-terminal",
      "say": "feature에 main의 기록을 합쳐요."
    },
    {
      "action": "say",
      "text": "Fast-forward예요. feature가 main의 위치로 이동했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat guide.txt",
      "say": "바뀐 feature의 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "문의 안내도 함께 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "main:guide.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "main의 내용도 확인해요."
    },
    {
      "action": "say",
      "text": "main은 원래 두 줄 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. merge 뒤에 적은 브랜치가 바뀌는 게 아니에요. 지금 있는 브랜치가 바뀌어요.",
      "target": "#git-demo-terminal"
    }
  ]
}
