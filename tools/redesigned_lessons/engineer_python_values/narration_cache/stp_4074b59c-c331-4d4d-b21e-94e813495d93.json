      ]
    },
    {
      "action": "say",
      "text": "바깥만 복사해 안쪽 첫 목록은 공유해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "backup = rows.copy()",
      "after": "backup = copy.deepcopy(rows)",
      "say": "copy.deepcopy로 안쪽까지 복사해 볼게요."
