{
  "by": "hand",
  "source_sha256": "dcf7ecf2f510b876ff31cd13e4d20adce021cbfddf0b54c7d6bd7f6a9a796256",
  "entry": [
    {
      "action": "say",
      "text": "없는 키를 읽는 것과 키를 넣는 것을 구별해, 읽은 값과 키 개수를 적는 문제예요.",
      "target": "text:출력될 결과를 그대로 적으세요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "영을 읽어도 딕셔너리에 새 키가 생기지는 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "counts.get(\"book\", 0)",
      "after": "counts.setdefault(\"book\", 0)",
      "say": "get을 setdefault로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "setdefault는 없는 키를 실제로 추가해 키 수가 둘이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 값을 읽는 것과 자료를 바꾸는 메서드를 구별해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "counts.setdefault(\"book\", 0)",
      "after": "counts.get(\"book\", 0)",
      "say": "get으로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "처음 코드는 0을 읽고 키는 여전히 하나라 0:1이에요.",
      "target": "output"
    },
    {
      "action": "fill_answer",
      "value": "0:1"
    }
  ]
}
