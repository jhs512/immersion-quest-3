  "entry": [
    {
      "action": "say",
      "text": "목록을 마지막부터 처음 방향으로 읽어야 해요. 슬라이스의 간격을 -1로 써요.",
      "target": "text:print 줄을 고쳐 stocks를 마지막부터 처음 방향으로 읽으세요."
    },
    {
      "action": "run",
      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "[2, 4, 6, 8]이에요. 아직 처음부터 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(stocks)",
      "after": "print(stocks[::-1])",
      "say": "대괄호 안에 ::-1을 써요."
    },
    {
      "action": "run",
      "lines": [
        3,
        3
      ]
    },
    {
      "action": "say",
      "text": "[8, 6, 4, 2]예요. 끝에서부터 한 칸씩 거꾸로 읽었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 지금은 정렬해 뒤집어도 같아 보이지만, [5, 1, 9]라면 역순은 [9, 1, 5]이고 큰 순서는 [9, 5, 1]이에요.",
      "target": "code:stocks[::-1]"
    }
  ]
}
