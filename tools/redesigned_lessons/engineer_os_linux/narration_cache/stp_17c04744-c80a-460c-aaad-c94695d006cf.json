  "by": "hand",
  "source_sha256": "7c3b629a3bc59dd4247dc132908dea5dabb8a4db34bec16a8c7047558486071e",
  "entry": [
    {
      "action": "say",
      "text": "chmod의 8진수 자리는 서로 다른 사용자 범주를 나타내요.",
      "target": "text:owner, group, other는 각 범주의 권한 한 자리예요. 각 자리를 8진수 위치에 배치해 전체 모드를 만드세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "0o12예요. 세 범주의 자리를 나누지 않고 더했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "mode = owner + group + other",
      "after": "mode = owner * 64 + group * 8 + other"
    },
    {
      "action": "say",
      "text": "8진수 한 자리는 세 비트예요. 소유자는 두 자리, 그룹은 한 자리만큼 왼쪽으로 옮겨요.",
      "target": "code:mode = owner * 64 + group * 8 + other"
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "0o640이에요. 소유자는 읽기·쓰기, 그룹은 읽기만 가능해요.",
      "target": "output"
    }
  ]
}
