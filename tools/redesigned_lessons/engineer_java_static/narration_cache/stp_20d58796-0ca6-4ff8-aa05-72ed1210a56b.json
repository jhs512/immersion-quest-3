  "entry": [
    {
      "action": "say",
      "text": "local은 static이 없는 인스턴스 필드, total은 static 필드예요. a에서 둘을 늘렸을 때 세 값을 고르는 문제예요.",
      "target": "text:a의 local과 공유 total을 늘렸어요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "a의 local만 1이고 공유 total도 1이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "a.local++;",
      "after": "b.local++;",
      "say": "a 대신 b의 local을 늘려 볼게요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "b의 local을 늘리면 0:1:1이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. local은 객체마다 따로, total은 모든 객체가 하나를 함께 써요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "클래스 값과 객체 값을 나누어 봐요.",
      "target": "output",
      "diagram": {
        "title": "공유 칸과 각 표의 칸",
        "rows": [
          "Ticket.total = 1",
          "a.local = 1",
          "b.local = 0"
        ]
      }
    },
    {
      "action": "patch_code",
      "before": "b.local++;",
      "after": "a.local++;",
      "say": "a의 local을 늘리는 줄로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "처음 코드는 a.local만 1, b.local은 0, 공유 total은 1이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "separate"
    }
  ]
