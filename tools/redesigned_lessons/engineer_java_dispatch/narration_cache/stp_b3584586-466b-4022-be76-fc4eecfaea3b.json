{
  "by": "hand",
  "source_sha256": "ea31283b7531db1a066f37695c33f188b6f22cb2883ef83ef3a7a2c5d5a5ebcb",
  "entry": [
    {
      "action": "say",
      "text": "memo에는 글자가 들어 있는데 어느 kind가 불릴지가 문제예요.",
      "target": "text:memo의 선언 한 곳을 고쳐 String 버전의 kind가 불리게 하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "물건이 나왔어요. 실제 객체가 글자여도 Object 버전이 불렸어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "컴파일러는 memo를 Object라고만 알아요. 그래서 kind(Object)로 정했어요.",
      "target": "code:Object memo"
    },
    {
      "action": "patch_code",
      "before": "Object memo = \"coupon\";",
      "after": "String memo = \"coupon\";",
      "say": "memo의 선언형을 String으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "글자 6개가 나왔어요. 선언형이 String이라 String 버전이 정해졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 선언형은 Object로 두고 new String으로 만들어도 물건이 나와요. 고르는 기준은 객체가 아니라 선언형이에요.",
      "target": "code:String memo"
    }
  ]
}
