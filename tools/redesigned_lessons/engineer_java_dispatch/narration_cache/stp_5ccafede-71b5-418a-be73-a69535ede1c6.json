  "entry": [
    {
      "action": "say",
      "text": "네 값 가운데 tag만 바꾸고 나머지 셋은 그대로 둬야 해요.",
      "target": "text:선언 한 곳을 고쳐 tag 자리에만 Bonus의 String 규칙 S-B가 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        25,
        25
      ]
    },
    {
      "action": "say",
      "text": "R O-B 35 2가 나왔어요. 하나씩 따라가 볼게요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "level은 static이라 r의 선언형 Rule 것, R이에요.",
      "target": "code:r.level()"
    },
    {
      "action": "say",
      "text": "tag는 word가 Object라 tag(Object)로 정해지고, 실행은 Bonus 것이에요.",
      "target": "code:r.tag(word)"
    },
    {
      "action": "say",
      "text": "score(2)는 Bonus에서 10을 더하고 Rule로 가요. Rule의 score(1)은 다시 Bonus로 와요.",
      "target": "code:return n + score(n - 1);"
    },
    {
      "action": "say",
      "text": "그래서 10이 세 번 더해지고, 맨 끝 base는 Rule 필드 2라 35예요.",
      "target": "code:if (n <= 0) return base;"
    },
    {
      "action": "patch_code",
      "before": "Rule r = new Bonus();",
      "after": "Bonus r = new Bonus();",
      "say": "r을 Bonus로 선언해 볼게요."
    },
    {
      "action": "run",
      "lines": [
        25,
        25
      ]
    },
    {
      "action": "say",
      "text": "B O-B 35 5예요. tag는 그대로이고 static level과 필드 base만 바뀌었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "Bonus r = new Bonus();",
      "after": "Rule r = new Bonus();",
      "say": "r은 되돌려요."
    },
    {
      "action": "patch_code",
      "before": "Object word = \"vip\";",
      "after": "String word = \"vip\";",
      "say": "대신 word의 선언형만 String으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        25,
        25
      ]
    },
    {
      "action": "say",
      "text": "R S-B 35 2예요. 오버로드만 String 버전으로 바뀌고 나머지는 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. r의 선언형을 바꾸면 static과 필드도 함께 바뀌어요. 바꿀 것은 인수의 선언형이에요.",
      "target": "code:String word"
    }
  ]
}
