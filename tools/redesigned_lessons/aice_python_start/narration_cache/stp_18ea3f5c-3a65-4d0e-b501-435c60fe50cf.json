  "entry": [
    {
      "action": "say",
      "text": "len은 목록에 든 항목의 개수를 돌려줘요. 배송 건수를 count에 담아야 해요.",
      "target": "text:count 줄을 고쳐 목록에 든 배송 건수를 count에 담으세요."
    },
    {
      "action": "run",
      "lines": [
        3,
        6
      ]
    },
    {
      "action": "say",
      "text": "12와 0이에요. 아직 건수를 세지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 0\n",
      "after": "count = len(minutes)\n",
      "say": "count에 len(minutes)를 담아요."
    },
    {
      "action": "run",
      "lines": [
        3,
        6
      ]
    },
    {
      "action": "say",
      "text": "12와 4예요. 첫 배송은 12분이고 배송은 모두 네 건이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 건수 4는 위치가 아니에요. 마지막 항목의 위치는 3이에요.",
      "target": "code:count = len(minutes)"
    }
  ]
}
