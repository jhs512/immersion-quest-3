{
  "by": "hand",
  "source_sha256": "af5678a95a58be0a4fa7589a0df0b9e1aad9accf9a26fa982784862c6f134ac2",
  "entry": [
    {
      "action": "say",
      "text": "가격 3,000원, 수량 2개면 2,800원이어야 해요. 메서드는 가격을 첫째, 수량을 둘째로 받아요.",
      "target": "text:가격 3,000원에 수량 2개면 2,800원이어야 해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "-299998이 나왔어요. 수량 2가 가격 자리에, 가격 3000이 수량 자리에 들어갔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "둘 다 int라서 컴파일러는 순서가 바뀐 것을 알아채지 못해요.",
      "target": "code:discounted(quantity, price)"
    },
    {
      "action": "patch_code",
      "before": "discounted(quantity, price)",
      "after": "discounted(price, quantity)",
      "say": "선언 순서대로 가격, 수량을 넘겨요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "2800이에요. 인수는 이름이 아니라 자리 순서로 매개변수에 들어가요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int quantity = 2;",
      "after": "int quantity = 3;",
      "say": "수량을 3으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "2700이에요. 수량 하나에 100원씩 깎였어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 변수 이름이 매개변수 이름과 같아도 자리를 바꿔 넘기면 그대로 바뀐 자리에 들어가요.",
      "target": "code:discounted(price, quantity)"
    },
    {
      "action": "patch_code",
      "before": "int quantity = 3;",
      "after": "int quantity = 2;",
      "say": "수량을 처음 값 2로 되돌려요."
    }
  ]
}
