{
  "by": "hand",
  "source_sha256": "570cf0b009d90f5bc58a0a88b1d9211a2d16cc1749bb74c0274e5cd3a16cc1e7",
  "entry": [
    {
      "action": "say",
      "text": "규칙은 기준 금액부터 무료예요. 기준은 매개변수 freeFrom으로 들어와요.",
      "target": "text:shipping은 기준을 매개변수 freeFrom으로 받아요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "2,500이에요. 기준과 같은 10,000원인데 배송비가 붙었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "초과 비교라서 기준과 같은 금액이 빠졌어요.",
      "target": "code:amount > freeFrom"
    },
    {
      "action": "patch_code",
      "before": "amount > freeFrom",
      "after": "amount >= freeFrom",
      "say": "같은 금액도 포함하도록 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 기준과 같은 10,000원도 이제 무료배송이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "amount = 10000;",
      "after": "amount = 9999;",
      "say": "기준 바로 아래 금액도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "2,500이에요. 아래쪽 경계도 맞아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int amount = 9999;\n        int freeFrom = 10000;",
      "after": "int amount = 20000;\n        int freeFrom = 20000;",
      "say": "기준을 20,000원으로 바꾼 가게라면 어떨까요?"
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 메서드가 받은 기준으로 판단하니 기준이 달라도 같은 규칙이 지켜져요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 10000을 조건에 직접 쓰면 다른 기준을 쓰는 채점에서 틀려요.",
      "target": "code:amount >= freeFrom"
    }
  ]
}
