{
  "by": "hand",
  "source_sha256": "6a50b75a9b52df6ff442985d088ce3dbc4e7f5be45f39a32707580f63a030b11",
  "entry": [
    {
      "action": "say",
      "text": "next_fee는 배송비를 받아 1,000원 더한 값을 돌려줘야 해요.",
      "target": "text:next_fee가 받은 배송비 fee에 1,000원을 더한 값을 돌려주도록 return 줄을 고치세요."
    },
    {
      "action": "say",
      "text": "main은 fee 2000을 넘겨 호출하고, 돌려받은 값을 출력해요.",
      "target": "code:next_fee(fee)"
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "2000이 나와요. return이 받은 값을 그대로 돌려주고 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "        return fee;\n",
      "after": "        return fee + 1000;\n",
      "say": "return 뒤의 식에 1,000을 더해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "3000이에요. 호출한 자리에 돌려받은 값이 들어갔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. return 3000처럼 결과를 직접 쓰면 다른 배송비로 호출할 때 틀려요. 채점은 다른 값으로도 직접 호출해요.",
      "target": "code:return fee + 1000;"
    }
  ]
}
