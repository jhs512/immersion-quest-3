{
  "by": "hand",
  "source_sha256": "0f38c923b37ec801db8c93493217279492aeff08f2dec2b4dc44857905cd2e8f",
  "entry": [
    {
      "action": "say",
      "text": "배송비를 계산하는 코드에 next_fee라는 이름을 붙였어요. 질문은 이 메서드가 돌려주는 값이에요.",
      "target": "text:배송비 계산에 이름을 붙였어요."
    },
    {
      "action": "say",
      "text": "fee로 받은 값에 1,000을 더해 return으로 돌려줘요.",
      "target": "code:return fee + 1000;"
    },
    {
      "action": "say",
      "text": "main은 2,000을 넘기며 호출하고, 돌아온 값을 바로 출력해요.",
      "target": "code:next_fee(fee)"
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "3,000이에요. 넘긴 2,000에 1,000을 더해 돌려받았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "fee = 2000;",
      "after": "fee = 4000;",
      "say": "넘길 값만 4,000으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "5,000이에요. 같은 계산이 넘긴 값에 따라 다른 결과를 내요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 메서드를 선언만 하고 호출하지 않으면 그 안의 계산은 한 번도 실행되지 않아요.",
      "target": "code:static int next_fee(int fee)"
    },
    {
      "action": "patch_code",
      "before": "fee = 4000;",
      "after": "fee = 2000;",
      "say": "처음 값으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "2,000을 넘겨 3,000을 받았어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "next"
    }
  ]
}
