  "entry": [
    {
      "action": "say",
      "text": "재고가 0이면 trips도 0이어야 해요. 지금은 1이 나와요.",
      "target": "text:재고가 0이면 한 번도 옮기지 않아야 하는데 1이 나와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "1이에요. 본문을 먼저 실행해 trips가 1이 된 뒤에 조건을 봤어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조건 stock > 0은 맨 끝에 있어요. 처음 한 번은 조건 없이 들어가요.",
      "target": "code:} while (stock > 0);"
    },
    {
      "action": "patch_code",
      "before": "        do {\n",
      "after": "        while (stock > 0) {\n",
      "say": "조건을 반복 맨 앞으로 올려요."
    },
    {
      "action": "patch_code",
      "before": "        } while (stock > 0);\n",
      "after": "        }\n",
      "say": "끝에 있던 조건은 지워요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "0이에요. 0 > 0이 false라서 본문에 한 번도 들어가지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int stock = 0;",
      "after": "int stock = 10;",
      "say": "재고를 10으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "3이에요. 남은 재고가 10, 6, 2일 때 한 번씩 옮겼어요.",
      "target": "output"
    }
  ]
}
