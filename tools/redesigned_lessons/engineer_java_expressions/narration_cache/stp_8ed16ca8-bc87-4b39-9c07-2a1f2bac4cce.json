  "by": "hand",
  "source_sha256": "d96ab4cbcd083cfc6138a00d72bdddc80f18301379702ae5e354435c5c6f4165",
  "entry": [
    {
      "action": "say",
      "text": "두 검사 중 하나만 통과한 줄에서만 셋째 칸이 true여야 해요.",
      "target": "text:둘 중 정확히 하나만 통과한 상자는 다시 검사하려 해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "셋째 칸이 false, true, true, true예요. |는 하나라도 true면 true라 마지막 줄도 true예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "(p | q)",
      "after": "(p & q)",
      "say": "&로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "이번엔 false, false, false, true예요. &는 둘 다 true인 마지막 줄만 true예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "(p & q)",
      "after": "(p ^ q)",
      "say": "^로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "false, true, true, false예요. p와 q가 다른 가운데 두 줄만 true예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. ^를 거듭제곱으로 읽으면 안 돼요. 자바에서 ^는 두 값이 다른지 보는 연산자예요.",
      "target": "code:(p ^ q)"
    }
  ]
}
