  "entry": [
    {
      "action": "say",
      "text": "자리마다 그대로와 두 배가 번갈아야 해요. 어디서 어긋나는지 찾는 문제예요.",
      "target": "text:지금은 셋째 자리부터 번갈아 가지 않아요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "7 4 12 8 = 31이에요. 셋째 자리 6도 두 배가 되어 12로 들어갔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "첫 반복 뒤 twice는 false | true라 true예요. 그다음도 true | true라 계속 true예요.",
      "target": "code:twice = twice | true;"
    },
    {
      "action": "patch_code",
      "before": "twice = twice | true;",
      "after": "twice = twice ^ true;",
      "say": "^로 바꿔요. true와 ^하면 값이 뒤집혀요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "7 4 6 8 = 25예요. twice가 false, true, false, true로 번갈아 바뀌었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "trace는 앞이 문자열이라 d를 글자로 이어 붙여요. sum에는 숫자로 더해져요.",
      "target": "code:trace = trace + d + \" \";"
    }
  ]
}
