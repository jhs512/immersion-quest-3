      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "ValueError예요. Classifier는 0.5 같은 연속 값을 종류로 다룰 수 없어요.",
