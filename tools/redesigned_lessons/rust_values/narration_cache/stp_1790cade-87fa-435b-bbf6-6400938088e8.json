{
  "by": "hand",
  "source_sha256": "ca854f9bbd01cef0031b9e3e1979571d49d0515bb2da6b2eb949e7825b1e5ab9",
  "entry": [
    {
      "action": "say",
      "text": "판매 뒤 상품이 들어왔어요. 입고 수량 arrived를 stock에 더해 다시 넣어야 해요.",
      "target": "text:입고 후 출력 앞에 stock에 arrived를 더해 다시 넣는 줄을 쓰세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        9
      ]
    },
    {
      "action": "say",
      "text": "두 줄 모두 3이에요. 아직 입고를 더하는 줄이 없거든요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    println!(\"입고 후: {stock}\");\n",
      "after": "    stock = arrived;\n    println!(\"입고 후: {stock}\");\n",
      "say": "등호 하나로 arrived를 넣어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        10
      ]
    },
    {
      "action": "say",
      "text": "조심하세요. =만 쓰면 더하지 않고 덮어써요. 남아 있던 3이 사라지고 입고 후가 4가 됐어요.",
      "target": "code:stock = arrived;"
    },
    {
      "action": "patch_code",
      "before": "    stock = arrived;\n",
      "after": "    stock += arrived;\n",
      "say": "+=로 바꿔 더한 결과를 다시 넣어요."
    },
    {
      "action": "run",
      "lines": [
        7,
        10
      ]
    },
    {
      "action": "say",
      "text": "입고 후가 7이에요. 3에 4를 더했죠. 판매 후 줄은 먼저 실행돼서 3 그대로예요.",
      "target": "output"
    }
  ]
}
