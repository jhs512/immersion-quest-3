      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "남은 수량: 0이에요. left에 계산 없이 0을 적어 뒀거든요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "let left = 0;",
      "after": "let left = sold - stock;",
      "say": "빼는 순서를 거꾸로 적으면 어떨까요?"
