{
  "by": "hand",
  "source_sha256": "9e59ad16655df758c87d7a86cd3eb36f2c485fe9d27e72e6804ae78a22371749",
  "entry": [
    {
      "action": "say",
      "text": "==가 무엇을 비교하는지가 이 문제예요. 내용이 같으면 true여야 해요.",
      "target": "text:두 메서드가 내용이 같으면 true를 돌려주게 고치세요."
    },
    {
      "action": "run",
      "lines": [
        19,
        21
      ]
    },
    {
      "action": "say",
      "text": "true, false, false예요. 첫 줄은 ==인데도 true가 나왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "코드에 그대로 쓴 \"A7\" 두 개는 같은 String 객체를 함께 써요. 그래서 ==가 true예요.",
      "target": "code:sameCode(\"A7\", \"A7\")"
    },
    {
      "action": "say",
      "text": "scanned는 실행 중에 이어 붙여 만든 새 객체예요. 글자가 같아도 ==는 false죠.",
      "target": "code:\"A\" + num"
    },
    {
      "action": "patch_code",
      "before": "String y) {\n        return x == y;",
      "after": "String y) {\n        return x.equals(y);",
      "say": "sameCode는 equals로 글자 내용을 비교해요."
    },
    {
      "action": "run",
      "lines": [
        19,
        21
      ]
    },
    {
      "action": "say",
      "text": "true, true, false예요. 둘째 줄이 내용 비교로 true가 됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int[] y) {\n        return x == y;",
      "after": "int[] y) {\n        return x.equals(y);",
      "say": "배열도 equals로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        19,
        21
      ]
    },
    {
      "action": "say",
      "text": "셋째 줄은 여전히 false예요. 배열의 equals는 ==처럼 같은 객체인지만 봐요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int[] y) {\n        return x.equals(y);",
      "after": "int[] y) {\n        return Arrays.equals(x, y);",
      "say": "Arrays.equals로 칸 값을 차례로 비교해요."
    },
    {
      "action": "run",
      "lines": [
        19,
        21
      ]
    },
    {
      "action": "say",
      "text": "true, true, true예요. 두 배열의 길이와 칸 값이 모두 같아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 배열에 x.equals(y)를 쓰면 칸 값이 같아도 false예요. 배열 내용은 Arrays.equals로 비교해요.",
      "target": "code:Arrays.equals(x, y)"
    }
  ]
}
