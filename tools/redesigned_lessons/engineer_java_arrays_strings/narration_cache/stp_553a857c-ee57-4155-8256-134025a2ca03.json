  "entry": [
    {
      "action": "say",
      "text": "3줄 4칸 번호표를 만들어야 해요. 배열 크기를 정하는 줄이 문제예요.",
      "target": "text:배열을 만드는 줄을 고쳐 3줄 4칸짜리 번호표가 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "3칸짜리 줄이 4개 나왔어요. 번호도 4, 8, 12가 빠지고 15까지 갔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "new int[앞][뒤]에서 앞 크기가 줄 수예요. 지금은 cols 4를 줄 수로 썼어요.",
      "target": "code:new int[cols][rows]"
    },
    {
      "action": "patch_code",
      "before": "new int[cols][rows]",
      "after": "new int[rows][cols]",
      "say": "줄 수 rows를 앞에, 칸 수 cols를 뒤에 써요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "[1, 2, 3, 4]부터 [9, 10, 11, 12]까지 세 줄이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "r * cols는 앞 줄들이 쓴 번호 수예요. 1번 줄은 4를 건너뛰고 5부터 시작해요.",
      "target": "code:r * cols + c + 1"
    }
  ]
}
