{
  "by": "hand",
  "source_sha256": "9967a8613c3afce935c5521053368a70ab98ebc7e12e7a20c5e1349c3bf1dc22",
  "entry": [
    {
      "action": "say",
      "text": "정렬 반복은 이미 있어요. 두 칸을 바꾸는 swap만 고치면 되는 문제예요.",
      "target": "text:swap 메서드의 본문을 고쳐 무게가 가벼운 순서로 정렬되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        24,
        24
      ]
    },
    {
      "action": "say",
      "text": "[2, 2, 2, 2]가 나왔어요. 바꿀 때마다 한 칸의 값이 사라졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "a[i] = a[j]가 먼저 a[i]를 덮어써요. 다음 줄은 이미 바뀐 값을 다시 넣어요.",
      "target": "code:a[j] = a[i];"
    },
    {
      "action": "patch_code",
      "before": "        a[i] = a[j];\n        a[j] = a[i];\n",
      "after": "        int temp = a[i];\n        a[i] = a[j];\n        a[j] = a[i];\n",
      "say": "덮어쓰기 전에 a[i]를 temp에 보관해요."
    },
    {
      "action": "patch_code",
      "before": "        a[j] = a[i];\n",
      "after": "        a[j] = temp;\n",
      "say": "a[j]에는 보관해 둔 temp를 넣어요."
    },
    {
      "action": "run",
      "lines": [
        25,
        25
      ]
    },
    {
      "action": "say",
      "text": "[2, 3, 7, 9]예요. swap이 받은 a는 weights와 같은 배열이라 main에서도 바뀐 값이 보여요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. a[i]와 a[j]를 지역 변수에 꺼내 그 변수끼리 바꾸면 배열 칸은 그대로예요. 칸에 다시 대입해야 해요.",
      "target": "code:a[j] = temp;"
    }
  ]
}
