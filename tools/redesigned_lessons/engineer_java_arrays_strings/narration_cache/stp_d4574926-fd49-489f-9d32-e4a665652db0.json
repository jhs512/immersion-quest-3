  "by": "hand",
  "source_sha256": "2fcc632e80ef503444168dd564a1423b9c2e2ef43fd6ef5b10caa08360acfddb",
  "entry": [
    {
      "action": "say",
      "text": "code를 거꾸로 읽은 글을 만들고, code 자신은 지켜야 해요.",
      "target": "text:rev를 만드는 줄을 고쳐 code를 거꾸로 읽은 글이 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        10
      ]
    },
    {
      "action": "say",
      "text": "AB12가 두 번 나왔어요. 꺼낸 글자를 rev 뒤에 붙여서 원래 순서 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "charAt(i)는 0번 A부터 3번 2까지 차례로 꺼내요.",
      "target": "code:code.charAt(i)"
    },
    {
      "action": "patch_code",
      "before": "rev = rev + code.charAt(i);",
      "after": "rev = code.charAt(i) + rev;",
      "say": "새 글자를 rev 앞에 붙여요."
    },
    {
      "action": "run",
      "lines": [
        9,
        10
      ]
    },
    {
      "action": "say",
      "text": "21BA와 AB12예요. 먼저 꺼낸 글자일수록 뒤로 밀렸고, code는 바뀌지 않았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 글자를 1번부터 세어 i <= code.length()까지 돌면 마지막에 범위 밖 예외가 나요.",
      "target": "code:i < code.length()"
    }
  ]
}
