  "by": "hand",
  "source_sha256": "cd068d1302c7f3c1918e70a5575b02be9bb983075aa5fe99c69da92058d08dd7",
  "entry": [
    {
      "action": "say",
      "text": "줄마다 칸 수가 다른 선반이에요. 그래도 세 줄의 합이 모두 나와야 해요.",
      "target": "text:줄마다 칸 수가 달라요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ],
      "expect_error": "ArrayIndexOutOfBoundsException"
    },
    {
      "action": "say",
      "text": "11을 찍은 뒤 예외가 났어요. 1번 줄은 칸이 하나인데 세 칸을 읽으려 했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "shelf[0].length는 0번 줄의 칸 수 3이에요. 모든 줄이 3칸이라고 가정한 거죠.",
      "target": "code:shelf[0].length"
    },
    {
      "action": "patch_code",
      "before": "c < shelf[0].length",
      "after": "c < shelf[r].length",
      "say": "지금 줄 r의 칸 수까지만 돌게 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "11, 2, 6이에요. 줄마다 자기 길이만큼만 돌았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "shelf.length는 줄 수 3이에요. shelf[r].length가 그 줄의 칸 수예요.",
      "target": "code:r < shelf.length"
    }
  ]
}
