  "entry": [
    {
      "action": "say",
      "text": "11개가 됐는데 full이 1이 아닌 이유를 찾는 문제예요.",
      "target": "text:그런데 11개가 됐는데도 full이 1이 아니에요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "0 11이에요. count는 11이 됐지만 비교는 늘기 전 10으로 했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "10 > 10은 거짓이라 0이에요. 비교가 끝난 뒤에야 count가 11이 돼요.",
      "target": "code:count++ > 10"
    },
    {
      "action": "patch_code",
      "before": "count++ > 10",
      "after": "++count > 10",
      "say": "먼저 늘리고 그 값으로 비교해요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "1 11이에요. 11 > 10을 비교해 1이 됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. count++ > 10을 11 > 10으로 읽기 쉬워요. 뒤에 붙은 ++는 비교에 옛 값을 내놓아요.",
      "target": "code:++count > 10"
    }
  ]
}
