      "action": "run",
      "lines": [
        18,
        18
      ]
    },
    {
      "action": "say",
      "text": "35예요. case 3도 default로 흘러내렸어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "            cost += 30;\n",
      "after": "            cost += 30;\n            break;\n",
      "say": "상자 비용 뒤에도 break를 넣어요."
