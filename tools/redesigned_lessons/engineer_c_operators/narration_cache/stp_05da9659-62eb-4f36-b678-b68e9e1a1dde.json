  "by": "hand",
  "source_sha256": "9fef698b176f73a4bc6ac3db87cd5b9d0f79652b33eed415c1d4e689c25efda2",
  "entry": [
    {
      "action": "say",
      "text": "선반 번호가 7인데 조건이 거짓이에요. 식이 어떻게 묶이는지 찾는 문제예요.",
      "target": "text:그런데 선반 번호가 7인지 묻는 조건이 거짓으로 나와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "0이 나왔어요. if 안으로 들어가지 못했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "==가 &보다 먼저 묶여요. 0x0F == 7이 먼저 0이 되고, tag & 0도 0이에요.",
      "target": "code:tag & 0x0F == 7"
    },
    {
      "action": "patch_code",
      "before": "if (tag & 0x0F == 7) {",
      "after": "if ((tag & 0x0F) == 7) {",
      "say": "마스크 부분을 괄호로 묶어요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "1이 나왔어요. 꺼낸 선반 번호 7을 7과 비교했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 괄호 없는 이 조건은 라벨이 무엇이든 0이에요. 맞는 라벨로 실행해도 늘 거짓이에요.",
      "target": "code:(tag & 0x0F) == 7"
    }
  ]
}
