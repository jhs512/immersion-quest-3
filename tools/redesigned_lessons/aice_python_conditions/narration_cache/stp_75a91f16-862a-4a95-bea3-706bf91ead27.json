    {
      "action": "say",
      "text": "규칙이 바뀌었어요. 딱 30분인 배송도 지연에 넣어야 해요. 같은 값에서 두 비교 기호가 어떻게 갈리는지 보고 맞는 조건을 골라요.",
      "target": "text:30분과 같은 배송도 지연에 포함해요."
    },
    {
      "action": "patch_code",
      "before": "minutes = 30",
      "after": "minutes = 29",
      "say": "먼저 기준보다 작은 29로 비교해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "두 조건 모두 거짓인 False가 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "minutes = 29",
      "after": "minutes = 31",
      "say": "기준보다 큰 31도 비교해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "이번에는 두 조건 모두 참이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "minutes = 31",
      "after": "minutes = 30",
      "say": "기준과 같은 30을 넣어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "이상은 참이고 초과는 거짓이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 같은 값에서 두 조건이 달라져요.",
      "target": "lines:3:4"
    },
    {
      "action": "patch_code",
      "before": "print(minutes > 30)",
      "after": "print(minutes >= 30)",
      "say": "같은 값도 포함하도록 등호 하나를 넣어요."
