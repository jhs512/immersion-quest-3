    {
      "action": "say",
      "text": "minutes가 limit 이상인지 비교한 결과를 late에 담아야 해요. >=는 기준 이상인지 확인해요.",
      "target": "text:late 줄을 고쳐 minutes가 limit 이상인지 비교한 결과를 late에 담으세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "False예요. 아직 비교하지 않고 False를 넣었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "late = False\n",
      "after": "late = minutes >= limit\n",
      "say": "late에 minutes >= limit을 담아요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "True예요. 31은 30 이상이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 비교 결과는 숫자 31이 아니라 참과 거짓이에요.",
      "target": "code:late = minutes >= limit"
    }
  ]
}
