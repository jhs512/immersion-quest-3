{
  "by": "hand",
  "source_sha256": "03252252c378e4be3d5bbc1d1912aac06b09f7ad4bcb4da7328ac96d9b2ee132",
  "entry": [
    {
      "action": "say",
      "text": "배송 시간 24는 그대로 두고 기준만 30으로 올려 결과가 어떻게 바뀌는지 보는 문제예요. 고칠 곳은 limit 한 줄이에요.",
      "target": "text:준비 코드의 기준은 20, 배송 시간은 24예요."
    },
    {
      "action": "say",
      "text": "이번에는 출력값을 고르는 대신 기준값을 바꿔요.",
      "target": "text:출력값을 고르는 대신 코드를 수정하는 문제예요."
    },
    {
      "action": "say",
      "text": "먼저 준비 코드를 그대로 실행할게요.",
      "target": "lines:2:4"
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "24분은 기준 20분 이상이라 참이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "limit = 20",
      "after": "limit = 30",
      "say": "기준만 30으로 바꿔 같은 시간을 비교해요."
    },
    {
      "action": "run",
      "lines": [
        4,
        4
      ]
    },
    {
      "action": "say",
      "text": "같은 24분인데 이번에는 거짓이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 기준을 바꾼 것이지 배송 시간을 바꾼 게 아니에요.",
      "target": "lines:2:3"
    },
    {
      "action": "say",
      "text": "배송 시간과 비교식은 그대로 두었어요. 기준값을 바꾼 코드를 제출하면 돼요.",
      "target": "lines:2:4"
    }
  ]
}
