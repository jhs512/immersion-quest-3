  "entry": [
    {
      "action": "say",
      "text": "기준과 같은 30분도 지연이에요. 같은 값도 포함하는 비교로 고쳐야 해요.",
      "target": "text:print 줄의 비교를 고쳐 기준과 같은 값도 True가 되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "False예요. >는 30과 30이 같으면 거짓이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "print(minutes > limit)",
      "after": "print(minutes >= limit)",
      "say": ">를 >=로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "True예요. 같은 값도 포함했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 경계값 하나 차이로 결과가 달라져요. 기준과 같은 값을 꼭 실행해 확인해요.",
      "target": "code:minutes >= limit"
    }
  ]
}
