{
  "by": "hand",
  "source_sha256": "cedd3a62c379c9434164f9ff303dadfc4bdd5f987608ec1054efe263a8a271f7",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "merge",
        "--no-edit",
        "feature"
      ],
      "say": "같은 guide.txt의 서로 떨어진 두 줄을 병합해 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "병합한 guide.txt의 첫 줄과 마지막 줄을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature의 안내와 main의 문의가 모두 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 같은 파일을 수정해도 서로 다른 부분이면 자동으로 합쳐질 수 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "auto-merge"
    },
    {
      "action": "say",
      "text": "이 문제에서는 두 변경이 자동으로 합쳐진다는 보기를 골라요.",
      "target": "answer:auto-merge"
    }
  ]
}
