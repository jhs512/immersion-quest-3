{
  "by": "hand",
  "source_sha256": "58bc8f4895658d4274ec57074358e878cef2641127f2683e3d3da113d207904a",
  "entry": [
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "두 브랜치의 선이 아직 갈라져 있어요. 충돌을 고쳐 담아도 병합 커밋은 아직 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "충돌 해결"
      ],
      "say": "남길 내용을 준비했어요. 충돌 해결이라는 설명으로 커밋해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_graph",
      "say": "옆의 커밋 그래프를 확인해요.",
      "target": "#git-demo-terminal + .git-graph-panel"
    },
    {
      "action": "say",
      "text": "main에 병합 커밋이 생겼어요. 두 선이 이 커밋으로 이어져요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:guide.txt"
      ],
      "say": "병합 커밋에 담긴 guide.txt를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "feature에서 선택한 안내: 메모를 남겨요가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "git status으로 남은 변경을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커밋할 변경이 없다는 안내가 나와요. 병합을 마쳤어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 충돌한 파일만 고치고 끝내면 안 돼요. git add와 커밋까지 해야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
