{
  "by": "hand",
  "source_sha256": "75c5f69270777c580f1226c2a50c1dd6e1fe5a73684efc77508e9bab04148b4c",
  "entry": [
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "git status로 충돌이 난 상태를 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff",
        "--name-only",
        "--diff-filter=U"
      ],
      "say": "충돌을 아직 해결하지 않은 파일 이름을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "guide.txt가 나와요. 이 파일에 남길 내용을 정해야 해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 충돌이 나도 양쪽의 기존 커밋은 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "choose-content"
    },
    {
      "action": "say",
      "text": "내용을 정하고 git add로 준비한 뒤 커밋한다는 보기를 골라요.",
      "target": "answer:choose-content"
    }
  ]
}
