  "entry": [
    {
      "action": "say",
      "text": "같은 첫 줄을 두 브랜치가 다르게 바꿔서 병합 도중 충돌이 났어요. 지금 해야 할 다음 행동을 고르는 문제예요.",
      "target": "text:main에서 병합하다 충돌이 난 상태예요."
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "충돌을 아직 해결하지 않은 파일 이름을 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "guide.txt가 나와요. 이 파일에 남길 내용을 정해야 해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 충돌이 나도 양쪽의 기존 커밋은 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "choose-content"
    },
    {
      "action": "say",
      "text": "남길 내용을 정하고 add한 뒤 커밋한다는 보기를 골라요.",
      "target": "answer:choose-content"
    }
  ]
}
