{
  "by": "hand",
  "source_sha256": "c4f9ccdb4b1d25a6b9cf6cbd7b4dafe7e8555b7eada3b40ef81a4e5e7d41fe00",
  "entry": [
    {
      "action": "say",
      "text": "부모가 이미 내보낸 값을 한 번의 실행에서만 바꾸는 문제예요.",
      "target": "text:명령 앞의 할당은 그 명령에서만 부모의 값을 덮어써요."
    },
    {
      "action": "bash_command",
      "command": "export APP_MODE=prod",
      "say": "부모에 prod를 내보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이제 자식들은 기본으로 prod를 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "APP_MODE=dev bash show.sh",
      "say": "이번 한 번만 dev를 붙여 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이 자식은 [dev]를 받았어요. 앞에 붙인 값이 이겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "아무것도 붙이지 않고 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다시 [prod]예요. dev는 앞 명령에서 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"[$APP_MODE]\"",
      "say": "부모의 값을 직접 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "[prod] 그대로예요. 명령 앞의 할당은 부모를 바꾸지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
