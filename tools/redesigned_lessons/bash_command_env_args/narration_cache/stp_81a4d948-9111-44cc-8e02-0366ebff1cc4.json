{
  "by": "hand",
  "source_sha256": "27f1e55cb90d2f86403e83768d2a6199e9689b6ceb06d1e98547910eddd1ffca",
  "entry": [
    {
      "action": "say",
      "text": "같은 dev를 자바 프로그램에 두 통로로 넘겨 비교하는 문제예요.",
      "target": "text:자바도 두 통로를 따로 읽어요."
    },
    {
      "action": "say",
      "text": "System.getenv는 이 프로세스의 환경에서 APP_MODE를 찾아요.",
      "target": "code:System.getenv(\"APP_MODE\")"
    },
    {
      "action": "say",
      "text": "args.length는 실행 인자가 몇 개인지 보여 줘요.",
      "target": "code:args.length"
    },
    {
      "action": "bash_command",
      "command": "java Main.java dev",
      "say": "dev를 실행 인자로 넘겨 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "APP_MODE=[null], 인자 수=1이에요. dev는 args로만 들어갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "APP_MODE=dev java Main.java",
      "say": "이번엔 명령 앞에 APP_MODE=dev를 붙여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "APP_MODE=[dev], 인자 수=0이에요. 이번엔 환경으로만 들어갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 환경 변수가 없으면 자바는 빈 글자가 아니라 null을 돌려줘요. 그 값에 바로 length()를 부르면 NullPointerException이 나요.",
      "target": "text:환경 변수가 없으면 null이 나와요."
    }
  ]
}
