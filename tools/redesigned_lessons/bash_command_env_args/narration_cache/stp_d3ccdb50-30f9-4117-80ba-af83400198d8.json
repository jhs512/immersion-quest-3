{
  "by": "hand",
  "source_sha256": "3a1d2a556ae4154615aad3170c493f41171418ef99252da62d658dae0bb452b3",
  "entry": [
    {
      "action": "say",
      "text": "인사말은 환경으로, 이름은 실행 인자로 넘겨 기록 세 줄을 만드는 마지막 도전이에요.",
      "target": "text:log.txt가 정확히 아래 세 줄이 되게 하세요."
    },
    {
      "action": "bash_command",
      "command": "cat greet.sh",
      "say": "스크립트부터 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "인사말은 GREETING에서, 이름은 $1에서 와요. GREETING이 비면 안녕을 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash greet.sh Minsu",
      "say": "아무 환경도 주지 않고 Minsu를 넘겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안녕 Minsu가 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "GREETING=Hello bash greet.sh Jisu",
      "say": "이번 한 번만 GREETING=Hello를 붙여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "Hello Jisu가 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash greet.sh Minsu",
      "say": "다시 아무것도 붙이지 않고 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "안녕 Minsu예요. Hello는 앞 명령에서 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat log.txt",
      "say": "기록 전체를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "요구한 세 줄과 순서가 같아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. export GREETING=Hello로 풀면 셋째 줄도 Hello가 돼요. 그 한 번에만 붙이세요.",
      "target": "text:가운데 줄의 Hello는 그 한 번에만 써야 해요."
    }
  ]
}
