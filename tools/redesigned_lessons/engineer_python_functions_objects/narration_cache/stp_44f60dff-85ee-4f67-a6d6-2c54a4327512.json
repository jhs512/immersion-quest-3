{
  "by": "hand",
  "source_sha256": "7855aa682320c93af058f27b88ebb2b2ea55f731bb9d5f88f81826712c20c20f",
  "entry": [
    {
      "action": "say",
      "text": "math.ceil을 약속대로 불러 상자 수를 구하는 문제예요.",
      "target": "text:boxes 안의 math.ceil 호출을 약속에 맞게 고쳐 상자 수가 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ],
      "expect_error": "TypeError"
    },
    {
      "action": "say",
      "text": "TypeError예요. math.ceil은 인수를 하나만 받는대요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "n과 size 두 개를 넘겨 인수 하나라는 약속을 어겼어요.",
      "target": "code:math.ceil(n, size)"
    },
    {
      "action": "patch_code",
      "before": "math.ceil(n, size)",
      "after": "math.ceil(n // size)",
      "say": "먼저 몫 하나로 넘겨 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "2가 나왔어요. 남은 상품 2개를 담을 상자가 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. //는 이미 버림한 몫이에요. 그 2를 올려도 그대로 2예요.",
      "target": "code:n // size"
    },
    {
      "action": "patch_code",
      "before": "math.ceil(n // size)",
      "after": "math.ceil(n / size)",
      "say": "/로 2.5를 넘겨 올림하게 해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "3이에요. 2.5 이상인 가장 작은 정수가 돌아왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "return math.ceil(n / size)",
      "after": "return -(-n // size)",
      "say": "boxes의 안쪽을 다른 계산으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "그대로 3이에요. 부르는 print 줄은 하나도 안 바꿨어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "boxes의 이름·인수·반환이 같아서예요. 그 약속이 API예요.",
      "target": "code:def boxes(n, size):"
    }
  ]
}
