  "entry": [
    {
      "action": "say",
      "text": "이번엔 내용을 바꾸지 않고 커서만 옮겨요. gg는 첫째 줄, j는 한 줄 아래예요.",
      "target": "text:파일 내용은 바꾸지 않고 커서만 움직일 거예요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "gg",
      "wait_prompt": false,
      "say": "gg를 눌러요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커서가 첫째 줄로 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "j",
      "wait_prompt": false,
      "say": "j를 눌러요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커서가 둘째 줄에 있어요. 글자는 하나도 바뀌지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "커서 위치가 둘째 줄로 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
}
