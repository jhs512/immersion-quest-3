{
  "by": "hand",
  "source_sha256": "7aa067f73c20d0f409a375d5763a10d68a1b78aae88d6868344e23b738ed5000",
  "entry": [
    {
      "action": "say",
      "text": "셋째 줄 끝에 느낌표를 붙였다가 u로 취소하고, Ctrl+R로 다시 했다가, 마지막엔 원래대로 돌아와요.",
      "target": "text:실행 취소한 편집은 Ctrl+R로 다시 실행할 수 있어요."
    },
    {
      "action": "say",
      "text": "G는 마지막 줄로 가고, A는 그 줄 끝에서 입력을 시작해요.",
      "target": "text:G는 파일의 마지막 줄로 가요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "G",
      "say": "G로 마지막 줄로 가요.",
      "wait_prompt": false,
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "셋째 줄에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "A",
      "wait_prompt": false,
      "say": "A를 눌러요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "줄 끝에서 입력 모드가 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "!",
      "wait_prompt": false,
      "say": "느낌표를 입력해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "줄 끝에 느낌표가 붙었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "일반 모드라 u와 Ctrl+R을 쓸 수 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "u",
      "wait_prompt": false,
      "say": "u로 느낌표를 취소해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "느낌표가 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u0012",
      "wait_prompt": false,
      "say": "Ctrl+R을 눌러요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "취소했던 느낌표가 다시 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "u",
      "wait_prompt": false,
      "say": "한 번 더 u를 눌러 원래 메모로 돌아와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "느낌표가 없는 저장된 내용과 같아졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "원래 메모로 돌아온 것이 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
}
