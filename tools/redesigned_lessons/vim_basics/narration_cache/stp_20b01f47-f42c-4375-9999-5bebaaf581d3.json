{
  "by": "hand",
  "source_sha256": "7333c3dfef796ea54bc164bd06caf94b9e29daaa2a471f5c10e1de4de57f9ada",
  "entry": [
    {
      "action": "say",
      "text": "마지막 줄 아래에 새 줄을 더해 :w로 저장해요. 저장 뒤에도 Vim이 열려 있는지 봐요.",
      "target": "text::w는 저장만 하므로 Vim은 계속 열려 있어요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "G",
      "wait_prompt": false,
      "say": "G로 마지막 줄로 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "셋째 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "o",
      "wait_prompt": false,
      "say": "o로 아래에 새 줄을 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "넷째 줄에서 입력 모드가 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "마지막 줄",
      "wait_prompt": false,
      "say": "마지막 줄을 입력해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "네 번째 줄이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "일반 모드예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": ":w\r",
      "wait_prompt": false,
      "say": ":w로 저장해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "저장 메시지가 보이고 Vim 화면은 그대로예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "저장했지만 편집기가 열려 있는 상태가 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
}
