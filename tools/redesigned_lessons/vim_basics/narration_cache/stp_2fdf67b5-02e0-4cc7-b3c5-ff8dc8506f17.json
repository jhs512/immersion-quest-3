  "entry": [
    {
      "action": "say",
      "text": "o로 첫 메모 아래에 새 줄을 만들고 둘째 메모를 쓴 뒤 저장해요.",
      "target": "text:o는 현재 줄 아래에 새 줄을 만들고 입력 모드로 들어가요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "o",
      "wait_prompt": false,
      "say": "o를 눌러요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커서가 아래 새 줄로 가고 INSERT가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "둘째 메모",
      "wait_prompt": false,
      "say": "둘째 메모를 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "메모가 두 줄이 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 일반 모드로 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "INSERT가 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": ":w\r",
      "wait_prompt": false,
      "say": ":w로 저장해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 줄이 파일에 저장됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "두 줄 저장이 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
