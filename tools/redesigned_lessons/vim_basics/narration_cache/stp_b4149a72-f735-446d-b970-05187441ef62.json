{
  "by": "hand",
  "source_sha256": "88a51fde66621669b767995f233da65229882c395d660e983e9da88a66610ae9",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 장보기 목록에서 틀린 줄은 고치고, 필요 없는 줄은 지우고, 빠진 줄은 더한 뒤 저장하고 끝내요.",
      "target": "text:장보기 목록을 고쳐 저장하고 Vim을 끝내요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "j",
      "wait_prompt": false,
      "say": "j로 둘째 줄 우유 2개로 내려가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커서가 우유 2개 줄에 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "cc",
      "wait_prompt": false,
      "say": "cc로 이 줄을 비우고 입력 모드가 돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "줄이 비고 INSERT가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "우유 1개",
      "wait_prompt": false,
      "say": "우유 1개를 입력해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "둘째 줄이 우유 1개가 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 일반 모드로 돌아와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "INSERT 표시가 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "/라면\r",
      "wait_prompt": false,
      "say": "지울 줄은 /라면으로 찾아가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "커서가 라면 5개 줄로 옮겨 갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "dd",
      "wait_prompt": false,
      "say": "dd로 그 줄을 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "라면 줄이 사라지고 계란 10개가 셋째 줄이 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "G",
      "wait_prompt": false,
      "say": "G로 계란 10개가 있는 마지막 줄로 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "계란 10개 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "o",
      "wait_prompt": false,
      "say": "o로 아래에 새 줄을 열어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "새 줄이 생기고 입력 모드예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "사과 3개",
      "wait_prompt": false,
      "say": "사과 3개를 입력해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "마지막 줄에 사과 3개가 들어갔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "일반 모드예요. 화면의 네 줄이 목표와 같아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 여기서 :q!로 나가면 고친 네 줄이 파일에 하나도 남지 않아요.",
      "target": "text:저장하지 않고 끝내면 실패예요."
    },
    {
      "action": "vim_keys",
      "keys": ":wq\r",
      "wait_prompt": true,
      "say": ":wq로 저장하고 끝내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일에 저장한 뒤 Vim이 끝났어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "목록 변경, 저장, 종료가 모두 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
}
