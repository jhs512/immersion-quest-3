{
  "by": "hand",
  "source_sha256": "d9567c7d3e7a5a4e9ac99d8cc0daa855dc2cb39eb3da6070d3835b292eab8415",
  "entry": [
    {
      "action": "say",
      "text": "다시 연 파일의 첫째 줄을 완료 메모로 바꾸고, :wq로 저장한 뒤 끝내요.",
      "target": "text::wq는 파일에 저장한 뒤 Vim을 종료해요."
    },
    {
      "action": "vim_wait",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "gg",
      "wait_prompt": false,
      "say": "gg로 첫째 줄로 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "13번에서 버린 글이 없는 첫 메모 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "cc",
      "wait_prompt": false,
      "say": "c를 두 번 눌러요. 줄을 지우고 입력 모드가 돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫째 줄이 비고 INSERT가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "완료 메모",
      "wait_prompt": false,
      "say": "완료 메모를 입력해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫째 줄이 완료 메모로 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": "\u001b",
      "wait_prompt": false,
      "say": "Esc로 나와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "일반 모드예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_keys",
      "keys": ":wq\r",
      "wait_prompt": true,
      "say": ":wq로 저장하고 끝내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일에 저장한 뒤 Vim이 끝나 프롬프트로 돌아왔어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "vim_wait",
      "passed": true,
      "say": "확인 항목을 봐요.",
      "target": ".vim-live-panel"
    },
    {
      "action": "say",
      "text": "저장과 종료가 함께 확인됐어요.",
      "target": ".vim-live-panel"
    }
  ]
}
