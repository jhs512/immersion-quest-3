  "entry": [
    {
      "action": "say",
      "text": "같은 표에서 지역별 배송 개수를 보려 해요. 평균을 그리는 barplot 줄을 고쳐야 해요.",
      "target": "text:ax 줄을 고쳐 평균 시간 대신 지역별 배송 개수를 막대로 그리세요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "[15.0, 40.0]이에요. north 10·20과 south 30·50의 평균 시간이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ax = sns.barplot(data=df, x=\"region\", y=\"minutes\", order=[\"north\", \"south\"], errorbar=None)",
      "after": "ax = sns.countplot(data=df, x=\"region\", order=[\"north\", \"south\"])",
      "say": "countplot으로 바꾸고 y와 errorbar를 지워요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "[2.0, 2.0]이에요. 지역마다 행 두 개를 센 높이예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 지금은 두 지역의 건수가 같아요. 막대가 세는 것인지 평균인지는 함수와 y로 판단해요.",
      "target": "code:sns.countplot"
    }
  ]
}
