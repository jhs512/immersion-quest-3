  "entry": [
    {
      "action": "say",
      "text": "stat=\"probability\"는 관측 비율을 그려요. common_norm을 바꾸면 비율의 분모가 전체인지 각 지역인지가 달라져요.",
      "target": "text:각 그룹을 따로 정규화하면 어떨까요?"
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "전체 네 개 중 각각 둘이라 0.5씩이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "common_norm=True",
      "after": "common_norm=False",
      "say": "그룹마다 자기 관측을 분모로 삼아요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "각 지역의 관측이 모두 한 구간에 있어 1.0씩이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 비율은 무엇을 분모로 했는지 확인해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "common_norm=False",
      "after": "common_norm=True",
      "say": "공통 분모로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "같은 표라도 비율의 질문이 달라져요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "group"
    }
  ]
}
