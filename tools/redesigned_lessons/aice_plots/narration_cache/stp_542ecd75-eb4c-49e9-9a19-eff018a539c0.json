      "action": "run",
      "lines": [
        11,
        13
      ]
    },
    {
      "action": "say",
      "text": "Orders와 [15.0, 40.0]이에요. 높이는 평균 시간인데 이름은 주문 수예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ax.set_ylabel(\"Orders\")",
      "after": "ax.set_ylabel(\"Mean minutes\")",
      "say": "이름을 \"Mean minutes\"로 바꿔요."
    },
