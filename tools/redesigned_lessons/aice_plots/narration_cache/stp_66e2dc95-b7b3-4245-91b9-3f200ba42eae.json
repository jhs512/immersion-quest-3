{
  "by": "hand",
  "source_sha256": "dc0200554a876da3313972869aaed80337c9419c33e2aa11c7993d928121db10",
  "entry": [
    {
      "action": "say",
      "text": "개수 대신 밀도를 그렸어요. 0부터 20분 구간의 비율은 첫 막대의 면적이라 share 줄을 고쳐야 해요.",
      "target": "text:share 줄을 고쳐 첫 막대의 높이가 아니라 면적(너비×높이)을 share에 담으세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        14
      ]
    },
    {
      "action": "say",
      "text": "높이는 0.0125와 0.01875이고 share도 0.0125예요. 높이만으로는 비율이 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "share = heights[0]\n",
      "after": "share = heights[0] * widths[0]\n",
      "say": "첫 막대 높이에 너비 widths[0]을 곱해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        14
      ]
    },
    {
      "action": "say",
      "text": "0.25예요. 네 배송 중 10분 한 건이 첫 구간이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 밀도 막대는 높이의 합이 아니라 면적의 합이 1이에요.",
      "target": "code:heights[0] * widths[0]"
    }
  ]
}
