    {
      "action": "say",
      "text": "이번에는 시간 열을 y에 연결해 평균을 보려 해요. countplot 줄을 고쳐야 해요.",
      "target": "text:ax 줄을 고쳐 개수 대신 지역별 평균 시간을 막대로 그리세요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "[2.0, 2.0]이에요. 지역별 배송 개수예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ax = sns.countplot(data=df, x=\"region\", order=[\"north\", \"south\"])",
      "after": "ax = sns.barplot(data=df, x=\"region\", y=\"minutes\", order=[\"north\", \"south\"], errorbar=None)",
      "say": "barplot으로 바꾸고 y=\"minutes\"와 errorbar=None을 넣어요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "[15.0, 40.0]이에요. north와 south의 평균 시간이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. barplot의 기본 통계는 합계가 아니라 평균이에요.",
      "target": "code:sns.barplot"
    }
  ]
}
