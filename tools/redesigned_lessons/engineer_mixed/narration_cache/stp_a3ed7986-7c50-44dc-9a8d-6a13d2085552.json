  "entry": [
    {
      "action": "say",
      "text": "조건 ? 값1 : 값2는 조건이 참이면 값1이에요. 0이 아니면 n과 sum(n - 1)을 더하게 고쳐야 해요.",
      "target": "text:함수를 고쳐 n이 0이 아니면 n과 sum(n - 1)을 더해 돌려주세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "3이에요. 작은 문제를 부르지 않고 n만 돌려줬어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "? 0 : n; }",
      "after": "? 0 : n + sum(n - 1); }",
      "say": "n 뒤에 + sum(n - 1)을 더해요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "6이에요. 3 + 2 + 1 + 0을 돌아오면서 더했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. n == 0인 멈춤 조건이 없으면 sum이 끝없이 자신을 불러요.",
      "target": "code:n == 0 ? 0"
    }
  ]
}
