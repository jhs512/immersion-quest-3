  "by": "hand",
  "source_sha256": "7c2cbb2eef8a464e72f3f6c208449fc0dc5bc9f63f9d9f4402f3a79f165691f1",
  "entry": [
    {
      "action": "say",
      "text": "음수를 나눌 때 Python의 몫과 나머지 규칙을 써야 해요. //와 %로 바꿔요.",
      "target": "text:두 줄을 고쳐 Python의 몫 연산자 //와 나머지 연산자 %로 계산하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "-2 -1이에요. int는 0 쪽으로 버려 -2.5를 -2로 만들었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "q = int(total / size)\n",
      "after": "q = total // size\n",
      "say": "q 줄을 total // size로 바꿔요."
    },
    {
      "action": "patch_code",
      "before": "r = total - q * size\n",
      "after": "r = total % size\n",
      "say": "r 줄을 total % size로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "-3 1이에요. //는 아래쪽인 -3으로 내렸고, -3 × 2 + 1이 -5예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 양수끼리는 두 방법이 같아요. 음수가 섞이면 C나 int와 결과가 달라요.",
      "target": "code:total // size"
    }
  ]
}
