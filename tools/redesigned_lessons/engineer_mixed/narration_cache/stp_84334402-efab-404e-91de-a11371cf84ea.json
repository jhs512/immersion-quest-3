  "entry": [
    {
      "action": "say",
      "text": "생성 횟수는 모든 보고 객체가 함께 써야 해요. count 필드를 static으로 바꿔요.",
      "target": "text:count 줄을 고쳐 생성 횟수를 모든 보고 객체가 함께 쓰게 하세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "1:3이에요. 객체마다 count가 따로 있어 first는 자기 생성만 셌어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int count = 0;\n",
      "after": "    static int count = 0;\n",
      "say": "int 앞에 static을 붙여요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "2:3이에요. 두 생성이 같은 count를 늘렸고, qty는 객체마다 따로라 first는 3이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. qty까지 static으로 바꾸면 second.qty = 8이 first.qty도 바꿔요.",
      "target": "code:static int count = 0;"
    }
  ]
}
