  "entry": [
    {
      "action": "say",
      "text": "수량은 2, NULL, 4예요. 값이 있는 수량만 세도록 COUNT 안을 고쳐야 해요.",
      "target": "text:질의를 고쳐 qty에 값이 있는 행만 세세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "3이에요. COUNT(*)는 NULL인 행까지 모든 행을 세었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(*)",
      "after": "COUNT(qty)",
      "say": "별표를 qty로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "2예요. NULL인 행을 빼고 세었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 수량 0은 NULL이 아니라 값이라 COUNT(qty)가 세요.",
      "target": "code:COUNT(qty)"
    }
  ]
}
