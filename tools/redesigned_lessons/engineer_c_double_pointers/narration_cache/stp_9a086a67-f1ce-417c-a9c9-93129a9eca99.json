  "by": "hand",
  "source_sha256": "cef19ff1b85c6e26f5d749220ac955864e9fffc34518952768329bea0baf3970",
  "entry": [
    {
      "action": "say",
      "text": "*pp는 p가 가진 배열 주소예요. 그 주소에서 한 원소 이동한 값을 읽어야 해요.",
      "target": "text:next 줄을 고쳐 *pp가 가진 배열 주소에서 한 원소 이동한 값을 읽으세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "2예요. **pp는 첫 원소예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int next = **pp;\n",
      "after": "    int next = *(*pp + 1);\n",
      "say": "*pp에 1을 더한 주소를 따라가요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "5예요. 배열 안에서 다음 원소로 이동했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. **(pp + 1)은 배열이 아니라 pp 옆 메모리로 가서 정해진 결과가 없어요.",
      "target": "code:int next = *(*pp + 1);"
    }
  ]
}
