{
  "by": "hand",
  "source_sha256": "d71cc388cf96021c2ccbcc1f5cf935f14d49807f7f8b4ee6c4ab737e64d45820",
  "entry": [
    {
      "action": "say",
      "text": "지금은 두 번 따라간 값을 복사한 변수만 늘려요. 원래 재고에 쓰도록 대입 한 곳을 고치는 문제예요.",
      "target": "text:두 번 따라간 대상에 쓰도록 대입을 고치세요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "복사본만 바꿔 원래 재고는 이예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "copy = copy + 1;",
      "after": "**target = **target + 1;",
      "say": "최종 재고에 하나 큰 값을 써요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "이제 원래 재고가 삼이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. **pp에 쓰는 대입은 재고 값을 바꾸고, *pp에 쓰는 대입은 p의 주소를 바꿔요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 2;",
      "after": "stock = 5;",
      "say": "다른 시작값 오도 확인해요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "같은 경로로 원래 재고가 육이 됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = 5;",
      "after": "stock = 2;"
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "두 단계의 관계를 따라 대상 값을 고쳤어요.",
      "target": "output"
    }
  ]
}
