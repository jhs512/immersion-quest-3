  "entry": [
    {
      "action": "say",
      "text": "pp는 포인터 배열의 첫 원소를 가리켜요. 한 칸 뒤의 포인터 원소를 따라가 읽어야 해요.",
      "target": "text:value 줄을 고쳐 pp에서 한 칸 뒤의 포인터 원소를 따라가 읽으세요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "2예요. 첫 원소 &stock을 따라가 stock을 읽었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int value = **pp;\n",
      "after": "    int value = **(pp + 1);\n",
      "say": "pp에 1을 더한 뒤 두 번 따라가요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "7이에요. 둘째 원소 &other를 따라가 other를 읽었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. **pp + 1은 stock에 1을 더한 3이에요. 괄호가 어느 층에서 움직일지 정해요.",
      "target": "code:int value = **(pp + 1);"
    }
  ]
}
