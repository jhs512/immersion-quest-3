    {
      "action": "say",
      "text": "*pp는 p 자신이라서 *pp = &other;는 p가 가리키는 곳을 바꿔요. stock의 값까지 바뀌는지가 질문이에요.",
      "target": "text:*pp에 other의 주소를 썼어요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "p는 다른 재고 7을 읽고 stock은 2로 남아요.",
      "target": "output",
      "diagram": {
        "title": "p에 저장한 주소 변경",
        "rows": [
          "pp → p → other → 7",
          "stock → 2"
        ]
      }
    },
    {
      "action": "patch_code",
      "before": "other = 7;",
      "after": "other = 9;",
      "say": "같은 other의 재고만 9로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "p는 9를 읽지만 stock은 2예요.",
      "target": "output",
      "diagram": {
        "title": "p에 저장한 주소 변경",
        "rows": [
          "pp → p → other → 9",
          "stock → 2"
        ]
      }
    },
    {
      "action": "say",
      "text": "조심하세요. *pp는 p에 들어 있는 주소를 다뤄요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "other = 9;",
      "after": "other = 7;"
    },
    {
      "action": "run",
      "lines": [
        12,
        12
      ]
    },
    {
      "action": "say",
      "text": "p의 대상과 처음 stock의 값은 따로예요.",
      "target": "output",
      "diagram": {
        "title": "p에 저장한 주소 변경",
        "rows": [
          "pp → p → other → 7",
          "stock → 2"
        ]
      }
