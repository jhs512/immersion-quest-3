  "entry": [
    {
      "action": "say",
      "text": "지금 줄은 stock에 other의 값을 써요. 한 번만 따라가 p의 주소를 바꾸게 고쳐야 해요.",
      "target": "text:**pp = other; 줄을 고쳐 stock은 그대로 두고 p가 other를 가리키게 하세요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "9와 9예요. **pp = other가 stock을 9로 덮어썼어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    **pp = other;\n",
      "after": "    *pp = &other;\n",
      "say": "별표 하나로 p에 other의 주소를 써요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "9와 2예요. p가 other를 가리키고 stock은 2로 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. *pp = &other와 **pp = other는 출력 첫 줄이 같아도 stock에 하는 일이 달라요.",
      "target": "code:*pp = &other;"
    }
  ]
}
