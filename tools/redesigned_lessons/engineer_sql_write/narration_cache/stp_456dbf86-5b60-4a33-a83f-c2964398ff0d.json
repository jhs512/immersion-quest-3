  "entry": [
    {
      "action": "say",
      "text": "학년의 종류 수를 한 행으로 보여야 해요.",
      "target": "text:서로 다른 학년의 수를 grades라는 열 이름으로 한 행에 출력하세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "1, 2, 3 세 행이 나왔어요. 값은 맞지만 개수가 아니라 목록이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "SELECT DISTINCT grade FROM students ORDER BY grade;",
      "after": "SELECT COUNT(grade) AS grades FROM students;",
      "say": "집계 함수로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "7이 한 행으로 나왔어요. 같은 학년도 학생마다 따로 셌어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(grade)",
      "after": "COUNT(DISTINCT grade)",
      "say": "COUNT 안에 DISTINCT를 넣어요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "3이 한 행으로 나왔어요. 겹친 학년을 하나로 본 뒤 셌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "DISTINCT는 표의 행을 지우지 않아요. 결과에서만 겹친 값을 하나로 봐요.",
      "target": "code:COUNT(DISTINCT grade)"
    }
  ]
}
