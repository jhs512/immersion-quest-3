{
  "by": "hand",
  "source_sha256": "0871ef9f7256f8d639a4886db9eb6efe25e60ff4ed6e33e4cbe005c3888b7bde",
  "entry": [
    {
      "action": "say",
      "text": "쌍의 수와 학생 수를 따로 세는 문제예요.",
      "target": "text:무늬에 맞는 (학생, 무늬) 쌍의 수와, 무늬에 하나라도 맞는 학생 수를 함께 세려 해요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "14가 나왔어요. 학생 7명과 무늬 2개의 곱이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "rules r;",
      "after": "rules r WHERE s.name LIKE r.pattern;",
      "say": "이름이 그 쌍의 무늬에 맞을 때만 남겨요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "4쌍이 남았어요. 김하늘은 김%와 %하%에 모두 맞아 두 번 들어갔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(*) AS pairs",
      "after": "COUNT(*) AS pairs, COUNT(DISTINCT s.id) AS students",
      "say": "겹치지 않는 학생 id도 세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "4 | 3이에요. 쌍은 넷, 학생은 김하늘·이하은·김도윤 셋이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. LIKE 양쪽을 바꿔 r.pattern LIKE s.name으로 쓰면 하나도 안 남아요. 무늬는 오른쪽에 와야 해요.",
      "target": "code:s.name LIKE r.pattern"
    }
  ]
}
