{
  "by": "hand",
  "source_sha256": "c68aa0631920ef0833dab6b27cadad99755f90c1bbbd56dcc808a2507c6a6e57",
  "entry": [
    {
      "action": "say",
      "text": "이씨만 남기고 높은 점수부터 보여야 해요.",
      "target": "text:WHERE 절을 넣어 이로 시작하는 이름만 남기고, 정렬을 점수 내림차순으로 바꾸세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "일곱 명이 다 나왔어요. 맨 위는 점수가 NULL인 최민수, 그다음 78부터 올라가요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "FROM students ORDER BY",
      "after": "FROM students WHERE 'name' LIKE '이%' ORDER BY",
      "say": "열 이름을 따옴표로 감싸 조건을 써 볼게요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "(행 없음)이에요. 작은따옴표 안의 'name'은 열이 아니라 글자 name이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 열 이름에 작은따옴표를 붙이면 오류 없이 빈 결과가 나와요.",
      "target": "code:'name'"
    },
    {
      "action": "patch_code",
      "before": "'name'",
      "after": "name",
      "say": "따옴표를 빼서 열 이름으로 써요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "이하은 88, 이준호 92가 나왔어요. 아직 낮은 점수부터예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ORDER BY score;",
      "after": "ORDER BY score DESC;",
      "say": "DESC를 붙여 내림차순으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "이준호 92가 먼저, 이하은 88이 다음이에요.",
      "target": "output"
    }
  ]
}
