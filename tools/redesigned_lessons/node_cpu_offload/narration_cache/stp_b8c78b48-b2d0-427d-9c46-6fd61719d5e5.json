  "entry": [
    {
      "action": "say",
      "text": "Promise를 만든 것과 기다린 것을 비교해요. 기다린 뒤의 계산 기록은 ping 다음에 남아야 해요.",
      "target": "text:Promise를 만든 것과 기다린 것을 비교해요. 기다린 뒤의 계산 기록은 ping 다음에 남아야 해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "지금 출력은 계산 6 -> ping예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "Promise.resolve(); 부분에서 요구한 관계를 계산하고 있는지 봐요.",
      "target": "code:Promise.resolve();"
    },
    {
      "action": "patch_code",
      "before": "Promise.resolve();",
      "after": "await Promise.resolve();",
      "say": "await Promise.resolve();로 바꿔 비교해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "await 뒤의 기록이 ping 다음으로 옮겨졌어요. 기다린 다음 계산도 같은 스레드예요. worker를 만든 것은 아니에요.",
      "target": "output"
    },
    {
      "action": "submit"
    }
  ]
}
