{
  "by": "hand",
  "source_sha256": "634dc746626849066b58447f2466b8f5c1cb6490e98ec9b8fbd2e546f1f0b279",
  "entry": [
    {
      "action": "say",
      "text": "drop_duplicates의 keep은 같은 주문 중 어느 기록을 남길지 정해요. 이 파일은 새 수정본이 뒤에 있으니 그에 맞는 값을 골라 고쳐요.",
      "target": "text:주문 번호별 마지막 기록을 남기도록 바꾸세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "처음 기록을 남겨 주문 103의 30분이 남았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "keep=\"first\"",
      "after": "keep=\"last\"",
      "say": "같은 주문의 마지막 기록을 보존해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "수정된 42분이 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. keep=\"last\"는 시간을 보고 고른 게 아니라 파일에서 더 뒤에 있는 기록을 남긴 거예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "이 파일은 새 수정본을 뒤에 붙였다는 조건이 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "keep=\"last\"",
      "after": "keep=False",
      "say": "아무 기록도 남기지 않는 옵션과도 비교해요."
    },
    {
      "action": "run",
      "say": "실행해서 어떤 주문이 빠지는지 확인해요.",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "주문 103의 두 기록이 모두 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. False는 중복 묶음을 모두 제외해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "keep=False",
      "after": "keep=\"last\"",
      "say": "마지막 수정본 하나를 남기는 조건으로 돌아와요."
    },
    {
      "action": "run",
      "say": "실행해서 마지막 기록을 확인해요.",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "주문 103의 42분이 다시 남았어요.",
      "target": "output"
    }
  ]
}
