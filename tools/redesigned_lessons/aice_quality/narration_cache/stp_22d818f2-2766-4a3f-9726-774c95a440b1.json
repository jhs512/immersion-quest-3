  "entry": [
    {
      "action": "say",
      "text": "결측 처리와 중복 처리를 한 줄에 이어 붙였어요. 검사할 열과 남길 기록 두 조건을 모두 문제에 맞게 고쳐요.",
      "target": "text:빈 메모는 허용해요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "빈 메모인 백일이 빠지고 예전 삼십 분만 남았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "dropna()",
      "after": "dropna(subset=[\"minutes\"])",
      "say": "먼저 시간이 있는 행만 남기도록 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "백일은 돌아왔지만 백삼은 예전 삼십 분이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "keep=\"first\"",
      "after": "keep=\"last\"",
      "say": "그다음 주문별 마지막 수정본을 남겨요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "백일과 백삼, 시간 십이와 사십이 분이 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 행수만 같아도 남긴 기록이 틀릴 수 있어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "주문 번호와 시간 값을 함께 확인해야 해요.",
      "target": "output"
    }
  ]
}
