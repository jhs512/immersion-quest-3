{
  "by": "hand",
  "source_sha256": "28a320c89fab4bf99c93fb816840fe82233785c0eae7364f7445deac85f3cf7e",
  "entry": [
    {
      "action": "say",
      "text": "export한 값이 어디까지 남는지 확인하는 문제예요.",
      "target": "text:export는 지금 셸과 그 뒤에 띄울 자식에만 영향을 줘요."
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "새 셸에서 바로 자식을 띄워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "빈 대괄호예요. 앞 스텝의 export는 끝난 셸과 함께 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "export COLOR=blue",
      "say": "이 셸에서 다시 내보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "지금부터 띄우는 자식은 blue를 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "자식을 띄워 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "[blue]를 받았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "unset COLOR",
      "say": "COLOR를 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "셸 변수와 내보내기 표시가 함께 사라졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "다시 자식을 띄워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "빈 대괄호로 돌아왔어요. 계속 쓰려면 셸을 열 때마다 다시 설정해야 해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
