{
  "by": "hand",
  "source_sha256": "9d05093a27b82823ac57352670d5c352dbbcd89e9010bdcb7bb9a278c465507b",
  "entry": [
    {
      "action": "say",
      "text": "셸 변수를 환경 변수로 바꾸면 자식이 받는 값이 달라지는지 보는 문제예요.",
      "target": "text:export COLOR는 셸 변수 COLOR를 환경 변수로 표시해요."
    },
    {
      "action": "bash_command",
      "command": "COLOR=blue",
      "say": "셸 변수 COLOR에 blue를 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직은 이 셸 안의 변수예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "printenv COLOR",
      "say": "환경 변수 목록에서 찾아볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "아무것도 나오지 않았어요. 셸 변수는 환경에 들어 있지 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "export COLOR",
      "say": "이제 COLOR를 내보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없지만 COLOR에 내보내기 표시가 붙었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "printenv COLOR",
      "say": "다시 환경에서 찾아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "blue가 나왔어요. 이제 환경 변수예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "자식을 띄워 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "자식이 [blue]를 받았어요. 자식은 시작할 때 부모의 환경 변수를 복사해 가요.",
      "target": "#git-demo-terminal"
    }
  ]
}
