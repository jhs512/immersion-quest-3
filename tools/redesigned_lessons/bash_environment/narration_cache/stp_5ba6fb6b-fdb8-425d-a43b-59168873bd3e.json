{
  "by": "hand",
  "source_sha256": "a8657ef80c4b29e04b20bbb503a4eb8356379e0e9b1d763846b0e82fa9accc3e",
  "entry": [
    {
      "action": "say",
      "text": "명령 순서를 직접 정해 기록 다섯 줄을 만드는 마지막 도전이에요.",
      "target": "text:log.txt가 정확히 아래 다섯 줄이 되게 하세요."
    },
    {
      "action": "say",
      "text": "첫 줄은 빈 값이에요. 그래서 내보내기 전에 show.sh를 먼저 실행해요.",
      "target": "text:show: []"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "아무것도 내보내지 않은 채 자식을 띄워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "show: []가 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "export COLOR=blue",
      "say": "이제 blue를 내보내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다음 자식부터 blue를 받아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "둘째 줄을 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "show: [blue]가 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash change.sh",
      "say": "change.sh로 자식 안에서 값을 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "받은 blue와 바꾼 green이 두 줄로 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "부모의 값을 다시 자식으로 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "show: [blue]예요. 자식이 바꾼 green은 부모에게 돌아오지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat log.txt",
      "say": "기록 전체를 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "요구한 다섯 줄과 순서가 같아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 처음부터 export하면 첫 줄이 [blue]가 돼요. 그때는 log.txt를 지우고 새로 남겨요.",
      "target": "text:잘못 남았으면 rm log.txt로 지우고 3번부터 다시 하세요."
    }
  ]
}
