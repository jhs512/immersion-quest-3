  "by": "hand",
  "source_sha256": "bbc9f9a6ce10361d4362e4825cb8c70ae64733a81f8294d8dc8ee66e7adb92b9",
  "entry": [
    {
      "action": "say",
      "text": "부모의 값을 바꾼 뒤 새로 띄운 자식이 어느 값을 받는지 비교하는 문제예요.",
      "target": "text:자식이 언제 값을 복사해 가는지 확인해요."
    },
    {
      "action": "bash_command",
      "command": "export COLOR=blue",
      "say": "담고 내보내기를 한 번에 해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "COLOR는 blue인 환경 변수예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "첫 번째 자식을 띄워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 자식은 [blue]를 받았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "COLOR=red",
      "say": "부모의 값을 red로 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "export를 다시 쓰지 않았지만 COLOR는 여전히 환경 변수예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "bash show.sh",
      "say": "두 번째 자식을 띄워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번 자식은 [red]를 받았어요. 자식은 시작하는 순간의 부모 값을 복사해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
