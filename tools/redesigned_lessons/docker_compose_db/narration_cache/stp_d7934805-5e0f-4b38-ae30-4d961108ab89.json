{
  "by": "hand",
  "source_sha256": "a105f194565b0413df1199e4bf066a6e150671c4ca4448ede1e0b06e1e3dad1e",
  "entry": [
    {
      "action": "say",
      "text": "볼륨을 붙였는데도 DB를 다시 만들면 표가 사라지는 문제예요.",
      "target": "text:볼륨 data가 있지만 /data에 붙어 있어요."
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "DB를 실행할게요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 900
    },
    {
      "action": "say",
      "text": "db가 Healthy예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec db psql -U postgres -d lab -c \"CREATE TABLE IF NOT EXISTS memo(title TEXT); INSERT INTO memo VALUES('milk')\"",
      "say": "memo 표를 만들고 milk를 저장해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "CREATE TABLE과 INSERT가 성공했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose down",
      "say": "이제 컨테이너를 지울게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "컨테이너가 지워졌어요. 볼륨 data는 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "DB를 다시 만들어요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "새 db 컨테이너가 Healthy가 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec db psql -U postgres -d lab -c \"SELECT title FROM memo\"",
      "say": "milk를 찾아볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "memo 표가 없다는 오류예요. 새 컨테이너는 빈 저장소에서 시작했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "data 볼륨이 /data에 붙어 있어요. PostgreSQL은 그 폴더에 저장하지 않아요.",
      "target": "code:data:/data"
    },
    {
      "action": "patch_code",
      "before": "data:/data",
      "after": "data:/var/lib/postgresql",
      "say": "볼륨을 PostgreSQL 18의 실제 저장 경로에 연결해요.",
      "file": "compose.yaml"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "고친 파일로 DB를 다시 만들어요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "db를 새로 만들고 Healthy가 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec db psql -U postgres -d lab -c \"CREATE TABLE IF NOT EXISTS memo(title TEXT); INSERT INTO memo VALUES('milk')\"",
      "say": "milk를 다시 저장해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이번에는 data 볼륨 안에 저장됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose down",
      "say": "컨테이너를 지워요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "컨테이너는 지워졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "DB를 다시 만들어요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 300
    },
    {
      "action": "say",
      "text": "새 db 컨테이너가 같은 data 볼륨을 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose exec db psql -U postgres -d lab -c \"SELECT title FROM memo\"",
      "say": "milk를 찾아볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "milk가 그대로 나와요. 컨테이너 수명과 데이터 수명이 분리됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 이미지 버전마다 데이터 경로가 같다고 가정하지 마세요. 이 과제는 명시한 PostgreSQL 18 이미지의 경로를 사용해요.",
      "target": "text:준비된 PostgreSQL 18 이미지는 /var/lib/postgresql 아래에 데이터를 저장해요."
    }
  ]
}
