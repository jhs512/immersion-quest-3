{
  "by": "hand",
  "source_sha256": "b05281f46c8bdeadc20da964ccf140e1b67c72ba9c08edd1f63a8ee67bd36daf",
  "entry": [
    {
      "action": "say",
      "text": "DB는 건강한데 app이 접속하지 못하는 문제예요.",
      "target": "text:db 컨테이너에 PostgreSQL이 있고 app 컨테이너에서 SQL 클라이언트를 실행해요."
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "DB를 실행하고 건강해질 때까지 기다릴게요.",
      "target": "#git-demo-terminal",
      "wait_seconds": 900
    },
    {
      "action": "say",
      "text": "db가 Healthy예요. PostgreSQL은 준비됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm app",
      "say": "app에서 접속해 볼게요.",
      "target": "#git-demo-terminal",
      "fails": true
    },
    {
      "action": "say",
      "text": "localhost에 접속하지 못했다는 오류예요. app이 자기 localhost로 접속했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "app 안의 localhost는 app 컨테이너 자신이에요. 거기에는 DB가 없어요.",
      "target": "code:\"-h\", \"localhost\""
    },
    {
      "action": "patch_code",
      "before": "\"-h\", \"localhost\"",
      "after": "\"-h\", \"db\"",
      "say": "접속 주소를 db 서비스 이름으로 바꿔요.",
      "file": "compose.yaml"
    },
    {
      "action": "bash_command",
      "command": "docker compose up -d --wait db",
      "say": "고친 파일로 다시 실행해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "db는 그대로 건강해요. 바뀐 것은 app의 설정이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "docker compose run --rm app",
      "say": "다시 접속해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "connected가 나왔어요. app이 db 서비스의 실제 PostgreSQL에 연결했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. PC에 이미 설치된 PostgreSQL을 찾는 과제가 아니에요. 준비된 실습 DB의 서비스 이름을 사용하세요.",
      "target": "text:사용자 PC의 DB는 사용하지 않아요."
    }
  ]
}
