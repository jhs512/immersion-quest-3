  "entry": [
    {
      "action": "say",
      "text": "메모는 이미 준비돼 있어요. 이제 기록해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "첫 기록"
      ],
      "say": "준비한 내용을 첫 커밋으로 남겨 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:memo.txt"
      ],
      "say": "지금 만든 기록에서 메모 내용을 꺼내 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 메모가 나왔죠. 준비한 내용을 기록했어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 커밋은 이 저장소에 남기는 기록이에요.",
      "target": "#git-demo-terminal"
    }
  ]
}
