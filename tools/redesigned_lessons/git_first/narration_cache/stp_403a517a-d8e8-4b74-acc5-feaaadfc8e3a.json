{
  "by": "hand",
  "source_sha256": "8fc6113bd0cbcdd48170bca45ad11a7be992a43224d9033a4d4cc2194138b655",
  "entry": [
    {
      "action": "say",
      "text": "지금 메모 파일과 기존 기록을 비교해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "say": "작업 파일과 준비 영역 사이의 차이를 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 메모 대신 둘째 메모가 추가된 모습이죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:memo.txt"
      ],
      "say": "기존 커밋에 담긴 메모도 직접 꺼내 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "여기는 첫 메모예요. 기존 기록은 그대로죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일 수정이 기존 커밋을 바꾸진 않아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "choose_answer",
      "id": "working-only"
    },
    {
      "action": "say",
      "text": "작업 파일만 바뀌었다는 설명을 선택해요.",
      "target": "answer:working-only"
    }
  ]
}
