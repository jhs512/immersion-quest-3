{
  "by": "hand",
  "source_sha256": "5ab948ee3c2312072b57baa3973ae0f5f6b92fb2744b26525d38d1e87176ef52",
  "entry": [
    {
      "action": "say",
      "text": "이번에는 셋째 메모를 새 기록에 담아 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "--",
        "memo.txt"
      ],
      "say": "작업 파일의 현재 내용을 다시 준비해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff",
        "--cached"
      ],
      "say": "기록할 차이에 셋째 메모가 있는지 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "기존 첫 메모에서 셋째 메모로 바뀌는 차이죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "메모 갱신"
      ],
      "say": "다시 준비한 내용을 새 커밋으로 기록해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:memo.txt"
      ],
      "say": "새 기록의 메모 내용을 직접 꺼내 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "셋째 메모가 나와요. 원했던 내용이 기록됐죠.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD^:memo.txt"
      ],
      "say": "바로 전 기록도 함께 확인해 볼게요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "첫 메모가 남아 있어요. 이전 기록도 보존돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status",
        "--porcelain"
      ],
      "say": "마지막으로 기록하지 않은 차이가 있는지 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아무 줄도 없죠. 남은 차이가 없는 상태예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 커밋 전에 원하는 내용을 다시 준비해요.",
      "target": "#git-demo-terminal"
    }
  ]
}
