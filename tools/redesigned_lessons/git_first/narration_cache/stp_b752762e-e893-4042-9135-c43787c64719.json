{
  "by": "hand",
  "source_sha256": "3ff46a601484389b745b130dbddf4228db61eff717a587cb8af5c6438cba85a4",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 빈 폴더에서 할 일 목록을 두 번 기록하고, 셋째 줄은 파일에만 남겨요.",
      "target": "text:셋째 줄 청소는 파일에만 있고 기록에도 준비 영역에도 없어야 해요."
    },
    {
      "action": "git_command",
      "args": [
        "init"
      ],
      "say": "git init으로 저장소를 만들어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": ".git 폴더가 생겼어요. 아직 커밋은 없어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"장보기\" > todo.txt",
      "say": "첫 줄을 todo.txt에 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 파일이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "todo.txt"
      ],
      "say": "지금 내용을 준비 영역에 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없어요. 장보기 한 줄이 준비됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "첫 할 일"
      ],
      "say": "첫 커밋으로 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "root-commit이라는 표시와 함께 첫 기록이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"빨래\" >> todo.txt",
      "say": "둘째 줄을 덧붙여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일은 두 줄이 됐어요. 기록은 아직 한 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "todo.txt"
      ],
      "say": "두 줄을 다시 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "준비 영역도 두 줄이 됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "둘째 할 일"
      ],
      "say": "둘째 커밋으로 남겨요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "두 번째 기록이 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"청소\" >> todo.txt",
      "say": "셋째 줄은 파일에만 덧붙여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일은 세 줄이에요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "git status로 확인해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "modified: todo.txt가 Changes not staged for commit 아래에 있어요. 셋째 줄은 아직 준비하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 습관처럼 여기서 다시 git add를 하면 청소 줄까지 준비 영역에 올라가요.",
      "target": "#git-demo-terminal"
    }
  ]
}
