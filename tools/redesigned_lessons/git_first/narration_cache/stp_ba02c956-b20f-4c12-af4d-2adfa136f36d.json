{
  "by": "hand",
  "source_sha256": "9f35b694ceff6791fb0465263bd9dd6531080ae776b447abdf75c97a461c6be7",
  "entry": [
    {
      "action": "say",
      "text": "지금 커밋과 준비 영역에는 첫 메모가 있어요. 파일만 둘째 메모로 바꾸고 add나 commit은 하지 않아요.",
      "target": "text:현재 커밋과 준비 영역에는 첫 메모가 있어요."
    },
    {
      "action": "bash_command",
      "command": "echo \"둘째 메모\" > memo.txt",
      "say": "파일에 둘째 메모를 써요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 파일만 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "say": "지금 파일의 내용을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "둘째 메모예요. 작업 파일은 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal",
      "say": "준비 영역과 작업 파일을 비교해요."
    },
    {
      "action": "say",
      "text": "첫 메모가 빠지고 둘째 메모가 더해진 차이가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "show",
        "HEAD:memo.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "현재 커밋의 메모를 읽어요."
    },
    {
      "action": "say",
      "text": "커밋에는 첫 메모가 남아 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일을 고쳤다고 이미 남긴 커밋의 내용까지 바뀌지는 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
