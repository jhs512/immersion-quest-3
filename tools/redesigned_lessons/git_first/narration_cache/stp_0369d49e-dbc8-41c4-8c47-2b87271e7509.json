{
  "by": "hand",
  "source_sha256": "97c6a5fbdb19cfa4df01d29df943f6592359f9189a7bc6e30a85c7513f0c0633",
  "entry": [
    {
      "action": "say",
      "text": "준비 영역은 add한 순간의 내용을 보관해요.",
      "target": "text:둘째 메모를 준비한 뒤 파일만 셋째 메모로 바꾸세요"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "say": "준비하기 전 파일을 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "둘째 메모예요. 이것을 준비할 거예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "memo.txt"
      ],
      "target": "#git-demo-terminal",
      "say": "현재 파일을 준비 영역에 담아요."
    },
    {
      "action": "say",
      "text": "이 순간의 둘째 메모가 준비됐어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"셋째 메모\" > memo.txt",
      "say": "이번에는 파일만 셋째 메모로 바꿔요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "아직 add를 다시 하지 않았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cat memo.txt",
      "say": "작업 파일을 다시 읽어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "파일은 셋째 메모예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff",
        "--cached"
      ],
      "target": "#git-demo-terminal",
      "say": "커밋과 준비 영역을 비교해요."
    },
    {
      "action": "say",
      "text": "준비 영역에는 둘째 메모가 있어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "diff"
      ],
      "target": "#git-demo-terminal",
      "say": "준비 영역과 작업 파일도 비교해요."
    },
    {
      "action": "say",
      "text": "작업 파일의 셋째 메모와 차이가 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "조심하세요. 파일을 다시 고쳐도 준비 영역은 자동으로 갱신되지 않아요.",
      "target": "#git-demo-terminal"
    }
  ]
}
