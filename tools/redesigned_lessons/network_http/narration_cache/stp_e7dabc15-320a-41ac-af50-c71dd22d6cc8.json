  "by": "hand",
  "source_sha256": "29c7128d07e596c3943fd54ce466839f3adfbf1dae5e3b77a28399f8ff68eb89",
  "entry": [
    {
      "action": "say",
      "text": "Content-Length는 본문의 바이트 수예요. 한글 응답 본문에 넣을 길이를 계산하세요.",
      "target": "text:Content-Length는 본문의 바이트 수예요. 한글 응답 본문에 넣을 길이를 계산하세요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "본문 크기는 UTF-8 바이트로 구하세요의 준비 코드 출력은 2예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "body.length()에서 읽는 대상을 확인해요.",
      "target": "code:body.length()"
    },
    {
      "action": "patch_code",
      "before": "body.length()",
      "after": "body.getBytes(java.nio.charset.StandardCharsets.UTF_8).length",
      "say": "body.getBytes(java.nio.charset.StandardCharsets.UTF_8).length 식이 읽는 대상을 비교해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "한글 본문은 글자 수와 바이트 수가 달라요. HTTP/1.1의 Content-Length에는 바이트 수를 써요.",
      "target": "output"
    },
    {
      "action": "submit"
    }
  ]
}
