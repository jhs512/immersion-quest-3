{
  "by": "hand",
  "source_sha256": "e45d4eb16f576a6f133d8f218db27a0454180d9e9d31de931f391fb75c1a1dda",
  "entry": [
    {
      "action": "say",
      "text": "문자 배열의 한 칸에는 작은따옴표로 쓴 문자 하나가 들어가요. 첫 칸 하나만 바꿔 FOX를 만드는 문제예요.",
      "target": "text:문자 하나를 바꿔 FOX가 나오게 하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "처음은 같은 문자 B를 넣어서 BOX가 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "label[0] = 'B';",
      "after": "label[0] = 'F';",
      "say": "첫 위치에 넣을 문자만 F로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "뒤의 OX는 두고 첫 글자만 바뀌어 FOX예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 작은따옴표의 F는 문자 하나예요.",
      "target": "lines:7"
    },
    {
      "action": "say",
      "text": "큰따옴표의 BOX는 끝 표시도 있는 문자열이에요.",
      "target": "lines:5"
    },
    {
      "action": "patch_code",
      "before": "\"BOX\"",
      "after": "\"BAG\"",
      "say": "다른 라벨도 같은 위치만 바뀌는지 봐요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "이번에도 첫 글자만 바뀌어 FAG가 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\"BAG\"",
      "after": "\"BOX\"",
      "say": "문제의 원래 라벨로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "출력을 고정하지 않고 배열 원소를 바꿨어요.",
      "target": "output"
    }
  ]
}
