  "entry": [
    {
      "action": "say",
      "text": "sizeof로 칸 수를 구해 count에 담아야 해요. 숫자를 직접 적지 않아요.",
      "target": "text:count 줄을 고쳐 전체 저장 크기를 한 원소 크기로 나눠 칸 수를 구하세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "0과 -1이에요. 아직 칸 수를 구하지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int count = 0;\n",
      "after": "    int count = sizeof bins / sizeof bins[0];\n",
      "say": "배열 전체 크기를 한 칸 크기로 나눠요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "3과 2예요. 칸은 세 개이고 마지막 위치는 2예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 칸 수 3은 위치로 쓸 수 없어요. bins[3]은 배열 밖이에요.",
      "target": "code:count - 1"
    }
  ]
}
