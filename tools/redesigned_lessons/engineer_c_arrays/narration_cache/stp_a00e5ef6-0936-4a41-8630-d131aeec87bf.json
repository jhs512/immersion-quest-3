    {
      "action": "say",
      "text": "조심하세요. 반복은 개수보다 작은 위치까지만 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 3;",
      "after": "count = 0;",
      "say": "저장공간은 두고 사용할 개수만 0으로 해요."
