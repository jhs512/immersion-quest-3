{
  "by": "hand",
  "source_sha256": "ccef7ecd87759ba8e8799e6009c6e6e1bc6df7b1eebe4911fabd4bd5b0318cdd",
  "entry": [
    {
      "action": "say",
      "text": "반복 조건이 마지막 위치를 빼고 있어요. 칸 수가 바뀌어도 모든 칸을 읽도록 조건 한 곳을 고치는 문제예요.",
      "target": "text:자료는 두고 반복 조건 한 곳만 고치세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "마지막 육이 빠져 이와 사의 합 육만 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "index < count - 1;",
      "after": "index < count;",
      "say": "마지막 유효 위치까지 포함하게 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "모든 칸의 재고를 더해 십이가 됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 반복은 개수보다 작은 위치까지만 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 3;",
      "after": "count = 0;",
      "say": "저장공간은 두고 사용할 개수만 영으로 해요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "사용할 칸이 없으면 합계 영을 유지해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "count = 0;",
      "after": "count = 3;",
      "say": "처음의 사용 개수로 복원해요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "칸 수가 달라도 같은 반복 원리로 계산해요.",
      "target": "output"
    }
  ]
}
