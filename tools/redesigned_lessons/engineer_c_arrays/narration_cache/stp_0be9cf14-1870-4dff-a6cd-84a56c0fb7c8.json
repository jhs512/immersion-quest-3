{
  "by": "hand",
  "source_sha256": "d40f1ac0cc7a56fc1ec2714844a2ca52547dd6b5dac7bde2b4615c25c2989ce0",
  "entry": [
    {
      "action": "say",
      "text": "배열은 같은 종류 값을 칸에 나란히 담고, 칸은 0부터 센 위치로 골라요. 첫 칸이 위치 0이라는 점으로 재고를 읽는 문제예요.",
      "target": "text:칸별 재고를 한 배열에 담았어요."
    },
    {
      "action": "say",
      "text": "칸의 위치와 그 안의 재고를 나란히 볼게요.",
      "target": "lines:5",
      "diagram": {
        "title": "배열의 위치와 재고",
        "rows": [
          "bins[0] → 2",
          "bins[1] → 4",
          "bins[2] → 6"
        ]
      }
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "위치 0의 첫 재고 2가 화면에 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "bins[0]",
      "after": "bins[1]",
      "say": "다음 위치의 재고를 읽어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "위치 1의 재고 4가 나왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 위치와 그 칸에 든 재고는 다른 값이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "bins[1]",
      "after": "bins[0]",
      "say": "첫 위치로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "0부터 세는 첫 칸의 재고는 2예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "two"
    }
  ]
}
