{
  "by": "hand",
  "source_sha256": "e37b3b595c35d132006bb4d6fd716d3be28e8838a4782fc7f1f10ae0278bd9cb",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 배열 순회·누적·동점 조건을 하나의 반복에 적용해요.",
      "target": "text:배열 순회·누적·동점 조건을 하나의 반복에 적용해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "합을 덮어쓰고 마지막 칸도 빠져 9 2가 나와요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "i < count - 1;",
      "after": "i < count;",
      "say": "마지막 칸까지 순회하세요."
    },
    {
      "action": "patch_code",
      "before": "total = bins[i];",
      "after": "total += bins[i];",
      "say": "읽은 재고를 total에 누적하세요."
    },
    {
      "action": "patch_code",
      "before": "bins[i] >= bins[best]",
      "after": "bins[i] > bins[best]",
      "say": "동점이면 앞 위치를 유지하세요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "모든 재고의 합은 24이고 최대 9의 첫 위치는 1이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 동점에서도 위치를 바꾸면 첫 번째 최대 위치가 사라져요.",
      "target": "code:bins[i] > bins[best]"
    }
  ]
}
