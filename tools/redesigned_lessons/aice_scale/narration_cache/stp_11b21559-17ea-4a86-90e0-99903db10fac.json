  "entry": [
    {
      "action": "say",
      "text": "MinMaxScaler는 (값 − 훈련 최솟값) ÷ (훈련 최댓값 − 최솟값)이에요. 범위 밖 값이 잘리지 않게 옵션을 고쳐야 해요.",
      "target": "text:scaler 줄의 옵션을 고쳐 훈련 범위 밖의 값도 잘라 내지 않고 같은 식으로 바꾸세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "[[1.0]]이에요. clip=True가 10을 훈련 범위 끝 1로 잘랐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "MinMaxScaler(clip=True)",
      "after": "MinMaxScaler(clip=False)",
      "say": "clip을 False로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "[[5.0]]이에요. (10 − 0) ÷ (2 − 0)이라 훈련 범위보다 훨씬 큰 값임이 남아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 훈련이 0~1이 됐다고 평가도 0~1 안이라는 보장은 없어요.",
      "target": "code:clip=False"
    }
  ]
}
