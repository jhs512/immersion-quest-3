  "entry": [
    {
      "action": "say",
      "text": "표준화는 (값 − 평균) ÷ 스케일이에요. 기준을 배우는 줄이 비어 있어 훈련 자료로 fit해야 해요.",
      "target": "text:pass 줄을 고쳐 transform 전에 훈련 자료로 기준을 배우세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        12
      ],
      "expect_error": "AttributeError"
    },
    {
      "action": "say",
      "text": "AttributeError예요. 아직 배운 평균 mean_이 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "pass\n",
      "after": "scaler.fit(train_values)\n",
      "say": "pass를 scaler.fit(train_values)로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        10,
        12
      ]
    },
    {
      "action": "say",
      "text": "평균 1과 스케일 1을 배웠어요. 훈련은 -1과 1, 평가 10은 (10 − 1) ÷ 1인 9예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 평가 10이 훈련 범위 밖이어도 같은 기준으로 바꿔요. 평가의 평균은 쓰지 않아요.",
      "target": "code:scaler.fit(train_values)"
    }
  ]
}
