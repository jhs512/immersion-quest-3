{
  "by": "hand",
  "source_sha256": "2aa86c3744648f909d2a9070e4d8006c6f06bd55e64610bf3d0846c04c0d2d59",
  "entry": [
    {
      "action": "say",
      "text": "OneHotEncoder는 훈련에서 본 범주마다 열을 만들어요. 훈련에 없던 west가 들어오면 기본 설정이 어떻게 하는지가 질문이에요.",
      "target": "text:처음 보는 west를 변환하려 해요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "훈련 범주는 두 지역이고 새 west에서 오류가 났어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "OneHotEncoder(sparse_output=False)",
      "after": "OneHotEncoder(sparse_output=False, handle_unknown=\"ignore\")",
      "say": "미지 범주를 모두 0인 벡터로 두는 정책을 명시해요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "두 열은 그대로이고 west는 0.0과 0.0이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. handle_unknown=\"ignore\"로 west가 0과 0이 된 것은 새 지역을 배웠다는 뜻이 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "OneHotEncoder(sparse_output=False, handle_unknown=\"ignore\")",
      "after": "OneHotEncoder(sparse_output=False)",
      "say": "기본 오류 정책으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "원래 정책에서는 여전히 새 범주 오류예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "error"
    }
  ]
}
