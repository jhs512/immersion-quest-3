{
  "by": "hand",
  "source_sha256": "ecb7e1899831fac8e87a839c2556af29ed6c1997e580daee95dfa6fdbc4e4e1c",
  "entry": [
    {
      "action": "say",
      "text": "처음 보는 west를 변환하려 해요. 기본 인코더는 멈추므로 처리 옵션을 고쳐야 해요.",
      "target": "text:encoder 줄의 옵션을 고쳐 처음 보는 지역은 오류 대신 모두 0으로 표시하세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        10
      ],
      "expect_error": "ValueError"
    },
    {
      "action": "say",
      "text": "['north', 'south']를 배운 뒤 west에서 ValueError예요. 기본은 알 수 없는 범주에서 오류를 내요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "OneHotEncoder(sparse_output=False)",
      "after": "OneHotEncoder(sparse_output=False, handle_unknown=\"ignore\")",
      "say": "handle_unknown=\"ignore\"를 더해요."
    },
    {
      "action": "run",
      "lines": [
        9,
        10
      ]
    },
    {
      "action": "say",
      "text": "[[0.0, 0.0]]이에요. 새 열은 생기지 않고 west는 모든 표시가 0이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. ignore는 west라는 정보를 버려요. 처음 보는 범주가 얼마나 오는지 따로 확인해요.",
      "target": "code:handle_unknown=\"ignore\""
    }
  ]
}
