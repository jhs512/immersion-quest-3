  "entry": [
    {
      "action": "say",
      "text": "대괄호에 열 이름 하나를 넣으면 그 열의 값들만 나와요. 배송시간 네 개를 보려면 어떤 이름을 넣어야 하는지 골라요.",
      "target": "text:필요한 열을 고르는 코드를 선택하세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "시간 십이, 십팔, 삼십, 사십이가 나와요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "df[\"minutes\"]",
      "after": "df[\"region\"]",
      "say": "열 이름만 region으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "이제 같은 네 건의 지역이 나와요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 열 하나에도 여러 배송의 값이 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "df[\"region\"]",
      "after": "df[\"minutes\"]",
      "say": "원하는 배송시간 열로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "다시 네 배송시간이 보여요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "minutes"
    }
  ]
}
