  "entry": [
    {
      "action": "say",
      "text": "주문번호와 배송시간 두 열만 전달하려 해요. 열 이름 목록으로 골라야 해요.",
      "target": "text:small 줄을 고쳐 주문번호와 배송시간 두 열이 남은 표를 만드세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "배송시간 한 열만 나와요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "small = df[\"minutes\"]",
      "after": "small = df[[\"order_id\", \"minutes\"]]",
      "say": "대괄호 안에 [\"order_id\", \"minutes\"] 목록을 넣어요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "order_id와 minutes 두 열이 남은 표예요. region은 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 대괄호가 두 겹이에요. 바깥은 고르기, 안쪽은 열 이름 목록이에요.",
      "target": "code:df[[\"order_id\", \"minutes\"]]"
    }
  ]
}
