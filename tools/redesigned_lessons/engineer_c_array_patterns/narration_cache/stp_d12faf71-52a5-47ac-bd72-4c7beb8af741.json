{
  "by": "hand",
  "source_sha256": "6ecb41f68b5185fea5804730e9b57a4f26e3ecc0a0191da7625dc3d87708773e",
  "entry": [
    {
      "action": "say",
      "text": "이웃 칸을 셀 때 지도 밖만 거르고 안쪽은 다 세야 해요.",
      "target": "text:지도 밖 칸을 거르는 if의 범위 검사 한 곳을 고쳐"
    },
    {
      "action": "run",
      "lines": [
        20,
        20
      ]
    },
    {
      "action": "say",
      "text": "0이 나왔어요. (1, 2) 오른쪽의 3열에 웅덩이가 둘 있는데 빠졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "열은 0부터 3까지 넷이에요. 그런데 nc < 3이라 3열을 지도 밖으로 봤어요.",
      "target": "code:nc < 3"
    },
    {
      "action": "patch_code",
      "before": "nc < 3",
      "after": "nc < 4",
      "say": "열 상한을 열 개수 4로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        20,
        20
      ]
    },
    {
      "action": "say",
      "text": "2가 나왔어요. (0, 3)과 (2, 3)의 웅덩이가 세어졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 범위 검사를 통째로 빼면 모서리 칸에서 map[-1]처럼 배열 밖을 읽어요. 행은 3, 열은 4로 따로 막아요.",
      "target": "code:nr < 3"
    }
  ]
}
