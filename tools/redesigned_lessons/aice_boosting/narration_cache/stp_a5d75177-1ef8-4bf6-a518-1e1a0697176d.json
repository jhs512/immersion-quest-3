  "source_sha256": "5d834c944678f1392f29f1f61a478f9a1e0600da37dfacf4562f291e76c71d51",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 학습률과 반복 수를 실제 학습된 부스팅 모델에서 확인해요.",
      "target": "text:학습률과 반복 수를 실제 학습된 부스팅 모델에서 확인해요."
    },
    {
      "action": "run",
      "lines": [
        13,
        15
      ]
    },
    {
      "action": "say",
      "text": "학습은 한 번, 반영 비율은 1로 고정돼 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "n_estimators=1",
      "after": "n_estimators=rounds",
      "say": "학습 반복 횟수를 rounds에 연결하세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        15
      ]
    },
    {
      "action": "say",
      "text": "반복 횟수는 맞췄어요. 비율이 1이면 한 번에 각 묶음의 정답까지 반영해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "learning_rate=1.0",
      "after": "learning_rate=rate",
      "say": "학습 반영 비율을 rate에 연결하세요."
    },
    {
      "action": "run",
      "lines": [
        13,
        15
      ]
    },
    {
      "action": "say",
      "text": "두 번에 나눠 정해 둔 비율만큼 반영한 예측이 나왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 변수 rate만 바꾸고 모델 설정에 연결하지 않으면 학습 결과는 그대로예요.",
      "target": "code:learning_rate=rate"
    }
  ]
}
