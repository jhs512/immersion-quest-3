  "entry": [
    {
      "action": "say",
      "text": "학습률 0.5로 학습했어요. expected 줄을 고쳐 한 단계의 차이를 학습률만큼만 더해야 해요.",
      "target": "text:expected 줄을 고쳐 기준값 0.5에 (묶음 평균 - 0.5)를 학습률만큼만 더하세요."
    },
    {
      "action": "run",
      "lines": [
        22,
        23
      ]
    },
    {
      "action": "say",
      "text": "[2.0, 8.0]과 [1.25, 4.25]예요. 손 계산은 차이를 다 더해 모델과 달라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "0.5 + (m - 0.5)",
      "after": "0.5 + rate * (m - 0.5)",
      "say": "(m - 0.5) 앞에 rate *를 붙여요."
    },
    {
      "action": "run",
      "lines": [
        22,
        23
      ]
    },
    {
      "action": "say",
      "text": "[1.25, 4.25]와 [1.25, 4.25]예요. 차이의 절반만 반영했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 학습률은 나무 수가 아니라 한 단계에서 반영하는 크기를 바꿔요.",
      "target": "code:rate * (m - 0.5)"
    }
  ]
}
