      "action": "run",
      "lines": [
        9,
        9
      ],
      "expect_error": "IndexError"
    },
    {
      "action": "say",
      "text": "IndexError예요. iloc의 101은 이름이 아니라 위치라서 네 행의 범위를 벗어나요.",
      "target": "output"
