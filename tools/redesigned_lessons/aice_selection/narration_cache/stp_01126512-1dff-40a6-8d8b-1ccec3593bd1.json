{
  "by": "hand",
  "source_sha256": "6889d00a8d2a4f4c23a92815650a7d6f91e8c277ca2c59cd6e42e113026c2362",
  "entry": [
    {
      "action": "say",
      "text": "30분인 배송이 빠지는 이유를 찾아 비교 한 곳을 고치는 문제예요. 먼저 비교가 무엇을 만드는지 봐요.",
      "target": "text:기준 30분인 배송도 포함해야 해요."
    },
    {
      "action": "say",
      "text": "mask 줄은 네 배송의 시간을 하나씩 limit과 비교해요.",
      "target": "code:df[\"minutes\"] > limit"
    },
    {
      "action": "run",
      "lines": [
        12,
        13
      ]
    },
    {
      "action": "say",
      "text": "마스크는 False, False, False, True예요. 30분 행이 False라서 loc가 사십이 한 건만 골랐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "] > limit",
      "after": "] >= limit",
      "say": "같은 시간도 참이 되도록 이상으로 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        12,
        13
      ]
    },
    {
      "action": "say",
      "text": "이제 세 번째 값도 True예요. 그래서 삼십과 사십이 두 배송이 골라졌어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "limit = 30",
      "after": "limit = 31",
      "say": "기준을 삼십일로 올려 마스크가 어떻게 바뀌는지 봐요."
    },
    {
      "action": "run",
      "lines": [
        12,
        13
      ]
    },
    {
      "action": "say",
      "text": "30은 31 이상이 아니라 다시 False예요. 마스크가 기준에 따라 매번 새로 계산돼요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "limit = 31",
      "after": "limit = 30",
      "say": "주어진 기준 삼십으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        12,
        13
      ]
    },
    {
      "action": "say",
      "text": "조심하세요. 결과 목록 [30, 42]를 직접 적으면 자료가 바뀔 때 틀려요. 비교식이 마스크를 만들게 두세요.",
      "target": "code:mask ="
    }
  ]
}
