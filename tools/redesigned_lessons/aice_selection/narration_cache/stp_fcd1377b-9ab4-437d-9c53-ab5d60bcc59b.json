    },
    {
      "action": "patch_code",
      "before": "[12, 18, 30, 42]",
      "after": "[12, 18, 30, 102]",
      "say": "부산 배송 하나만 늦춰 봐요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "서울은 이십일 그대로고 부산은 육십이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 전체 평균 한 개를 두 번 표시한 게 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
