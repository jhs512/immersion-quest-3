{
  "by": "hand",
  "source_sha256": "fab0fbecac47c428add8f25062a02ced851f019e433d99da2ada9923d879c97c",
  "entry": [
    {
      "action": "say",
      "text": "조건 두 개를 &로 연결했어요. 30분 이상이면서 서울인지, 둘 중 하나만 맞아도 되는지가 질문이에요.",
      "target": "text:준비 코드의 두 조건은 어떻게 연결됐나요?"
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "시간도 맞고 서울인 배송 삼십만 나왔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "(df[\"minutes\"] >= 30) & (df[\"region\"] == \"서울\")",
      "after": "df[\"minutes\"] >= 30",
      "say": "지역 조건을 잠시 빼고 시간만 비교해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "지역을 빼니 부산의 사십이도 함께 나왔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 표의 행별 조건은 괄호와 &로 묶어요.",
      "target": "lines:8"
    },
    {
      "action": "patch_code",
      "before": "df.loc[df[\"minutes\"] >= 30,",
      "after": "df.loc[(df[\"minutes\"] >= 30) & (df[\"region\"] == \"서울\"),",
      "say": "서울 조건을 다시 연결해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "두 조건을 모두 만족한 배송만 남았어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "both"
    }
  ]
}
