  "entry": [
    {
      "action": "say",
      "text": "오래 걸린 배송부터 보려 해요. 정렬 방향 옵션을 고쳐야 해요.",
      "target": "text:첫 print 줄의 옵션을 고쳐 오래 걸린 배송부터 정렬하세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        11
      ]
    },
    {
      "action": "say",
      "text": "두 줄 모두 [12, 18, 30, 42]예요. ascending=True는 작은 값부터예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ascending=True",
      "after": "ascending=False",
      "say": "ascending을 False로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        9,
        11
      ]
    },
    {
      "action": "say",
      "text": "첫 줄은 [42, 30, 18, 12], 둘째 줄은 원래 순서 [12, 18, 30, 42]예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. sort_values는 원래 표를 바꾸지 않아요. 정렬 결과를 쓰려면 그 결과를 받아 써요.",
      "target": "code:ascending=False"
    }
  ]
}
