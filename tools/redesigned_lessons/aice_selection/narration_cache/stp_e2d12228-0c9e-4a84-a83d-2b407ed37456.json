  "entry": [
    {
      "action": "say",
      "text": "필터로 30분 이상만 남긴 표를 정렬해요. 필터는 두고 정렬 방향만 바꿔야 오래 걸린 순서가 돼요.",
      "target": "text:기준과 조건은 두고 정렬 옵션만 고치세요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "조건은 맞지만 삼십부터여서 요청한 순서와 달라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "ascending=True",
      "after": "ascending=False",
      "say": "정렬 방향만 내림차순으로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "오래 걸린 사십이, 그다음 삼십 순서예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 필터를 지우면 짧은 배송까지 섞여요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "limit = 30",
      "after": "limit = 18",
      "say": "기준만 낮춰 같은 조합을 확인해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "사십이, 삼십, 십팔을 큰 순서로 골랐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "limit = 18",
      "after": "limit = 30",
      "say": "주어진 기준으로 다시 확인해요."
    },
    {
      "action": "run",
      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "행 선택과 정렬 방향을 따로 판단하면 돼요.",
      "target": "output"
    }
  ]
}
