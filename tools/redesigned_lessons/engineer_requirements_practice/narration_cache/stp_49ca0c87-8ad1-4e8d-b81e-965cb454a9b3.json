    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "True예요. 통과 비율을 자료와 무관하게 1로 두었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
