      "lines": [
        8,
        10
      ]
    },
    {
      "action": "say",
      "text": "경계 확률이 빠지고 관심 대상도 정상 ok로 잡혀 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "p > threshold",
      "after": "p >= threshold",
      "say": "기준과 같은 확률을 포함해 late 경보를 만드세요."
