    {
      "action": "say",
      "text": "정밀도 0.5·재현율 1이에요. f1 줄을 고쳐 산술평균이 아니라 조화평균을 구해야 해요.",
      "target": "text:f1 줄을 고쳐 산술평균이 아니라 정밀도와 재현율의 조화평균(F1)을 구하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        12
      ]
    },
    {
      "action": "say",
      "text": "0.75와 0.666667이에요. 산술평균은 f1_score와 달라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "f1 = (precision + recall) / 2\n",
      "after": "f1 = 2 * precision * recall / (precision + recall)\n",
      "say": "2 × 정밀도 × 재현율 ÷ (정밀도 + 재현율)로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        12
      ]
    },
    {
      "action": "say",
      "text": "0.666667과 0.666667이에요. 낮은 정밀도 쪽으로 끌렸어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. F1을 두 수의 단순 평균으로 보고하지 않아요. 한쪽이 낮으면 F1도 낮아요.",
      "target": "code:2 * precision * recall"
    }
  ]
}
