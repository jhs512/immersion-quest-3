  "entry": [
    {
      "action": "say",
      "text": "확률을 경보로 바꾸는 기준을 낮추면 더 많은 배송이 경보가 돼요. 0.4였던 실제 지연이 어떻게 되는지 예상해요.",
      "target": "text:기준0.5에서0.3으로 낮추면 이 표의 경보는 어떻게 될까요?"
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "영 점 오에서는 경보 두 건이고 정밀도·재현율 모두 영 점 오예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "threshold = 0.5",
      "after": "threshold = 0.3",
      "say": "같은 확률에서 경보 기준만 낮춰요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "경보 세 건, 정밀도 약 영 점 육육, 재현율 일이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 이 표의 정밀도 증가를 모든 자료의 법칙으로 외우지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "threshold = 0.3",
      "after": "threshold = 0.5",
      "say": "처음 기준으로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "원래 기준과 다른 경보 결과를 구별해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "more"
    }
  ]
}
