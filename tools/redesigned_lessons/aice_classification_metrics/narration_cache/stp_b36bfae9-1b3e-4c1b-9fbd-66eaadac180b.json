      "before": "y_true = [0, 0, 0, 0]",
      "after": "y_true = [0, 0, 1, 1]",
      "say": "처음 두 범주 평가로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        7,
        10
      ]
