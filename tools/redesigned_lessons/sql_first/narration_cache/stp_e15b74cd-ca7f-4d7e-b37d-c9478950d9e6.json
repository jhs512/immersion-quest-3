{
  "by": "hand",
  "source_sha256": "a5370dce2eaa4ffb8552de123b74cd8b18bdda3df025ffa422308a13e31aa43b",
  "entry": [
    {
      "action": "say",
      "text": "준비 코드는 상품 행을 세요. 원하는 것은 재고 개수의 합이에요.",
      "target": "text:상품은 세 종류예요. milk 재고는 7개, bread는 0개이고 tea는 미정이에요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "3은 상품 종류 수예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "COUNT(*)는 행을 세요. 수량을 더하려면 SUM에 열 이름을 넣어요.",
      "target": "code:SELECT COUNT(*) FROM item;"
    },
    {
      "action": "patch_code",
      "before": "SELECT COUNT(*) FROM item;\n",
      "after": "SELECT SUM(qty) FROM item;\n",
      "say": "COUNT(*)를 qty 열의 합인 SUM(qty)로 바꿔요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "7은 확인된 재고 수량의 합이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. COUNT(qty)로 바꿔도 수량을 더하는 것은 아니에요.",
      "target": "text:COUNT(*)는 상품 행 수를 세어요."
    },
    {
      "action": "submit"
    }
  ]
}
