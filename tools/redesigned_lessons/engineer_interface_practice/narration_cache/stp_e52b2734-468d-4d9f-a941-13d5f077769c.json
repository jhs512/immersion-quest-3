{
  "by": "hand",
  "source_sha256": "66a282b247a2a09fe7d90e90618afb140b9e74b1f4cc81d2a63ee98a54a6a6ba",
  "entry": [
    {
      "action": "say",
      "text": "재시도 대기를 base부터 두 배씩 늘리는 문제예요.",
      "target": "text:첫 대기는 base, 그다음부터 앞 대기의 두 배가 되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "[100, 100, 100, 100]이 나왔어요. 매번 같은 간격으로 다시 보내요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    wait = base\n",
      "after": "    wait = base * 2 * n\n",
      "say": "2와 n을 곱해 볼게요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "[0, 200, 400, 600]이에요. 첫 대기가 0이고 200씩 일정하게 늘었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 2 * n은 n에 비례해 늘 뿐이에요. 두 배씩 늘리려면 n을 지수로 써야 해요.",
      "target": "code:base * 2 * n"
    },
    {
      "action": "patch_code",
      "before": "base * 2 * n",
      "after": "base * 2 ** n",
      "say": "2 ** n으로 2의 n제곱을 곱해요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "say",
      "text": "[100, 200, 400, 800]이 나왔어요. n이 하나 늘 때마다 대기가 두 배가 됐어요.",
      "target": "output"
    }
  ]
}
