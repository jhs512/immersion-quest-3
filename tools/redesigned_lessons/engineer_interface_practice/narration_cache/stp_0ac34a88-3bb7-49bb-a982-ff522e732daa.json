{
  "by": "hand",
  "source_sha256": "ef291ac6053d183de6f08bbd0942acb555c269c07153225c6d58a7a9628dd79f",
  "entry": [
    {
      "action": "say",
      "text": "XML로 온 같은 주문에서 금액을 내는 문제예요.",
      "target": "text:qty와 price를 꺼내는 두 줄을 고쳐 수량과 단가의 곱이 출력되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ],
      "expect_error": "TypeError"
    },
    {
      "action": "say",
      "text": "TypeError가 났어요. 글자끼리는 곱할 수 없다는 뜻이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "JSON의 3은 숫자였죠? XML 태그 안의 3은 그냥 글자예요.",
      "target": "code:root.find('qty').text"
    },
    {
      "action": "patch_code",
      "before": "qty = root.find('qty').text",
      "after": "qty = int(root.find('qty').text)",
      "say": "qty만 int로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "500500500이 나왔어요. 수 3과 글자 500을 곱해 글자가 세 번 이어졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 한쪽만 int로 바꾸면 오류 없이 글자 반복이 돼요. 금액처럼 보여 놓치기 쉬워요.",
      "target": "code:int(root.find('qty').text)"
    },
    {
      "action": "patch_code",
      "before": "price = root.find('price').text",
      "after": "price = int(root.find('price').text)",
      "say": "price도 int로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "1500이에요. 두 값을 모두 수로 바꿔서야 JSON과 같은 금액이 됐어요.",
      "target": "output"
    }
  ]
}
