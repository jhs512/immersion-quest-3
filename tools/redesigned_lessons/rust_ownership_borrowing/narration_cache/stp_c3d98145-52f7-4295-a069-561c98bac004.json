{
  "by": "hand",
  "source_sha256": "3019ba4e95fd5d129d3d3c96bdf9889c72cca69896ae7334edf8cc2f97d41c1c",
  "entry": [
    {
      "action": "say",
      "text": "원본 제목과 사본 제목을 둘 다 출력해야 해요. 그런데 copy에 title을 넣으면 소유권이 옮겨 가죠.",
      "target": "text:copy에 title 대신 title.clone()을 넣어 원본과 복사본을 모두 출력하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ],
      "expect_error": "E0382"
    },
    {
      "action": "say",
      "text": "E0382예요. title이 copy로 이동해서 원본 출력 줄에서 막혔어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    println!(\"{title}\");\n",
      "after": "",
      "say": "막힌 원본 출력 줄을 지워 볼게요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "조심하세요. 막힌 줄을 지우면 컴파일은 돼요. 하지만 원본 제목이 출력에서 빠져 버려요.",
      "target": "code:println!(\"{copy}\");"
    },
    {
      "action": "patch_code",
      "before": "    println!(\"{copy}\");\n",
      "after": "    println!(\"{title}\");\n    println!(\"{copy}\");\n",
      "say": "원본 출력 줄을 되살려요."
    },
    {
      "action": "patch_code",
      "before": "let mut copy = title;",
      "after": "let mut copy = title.clone();",
      "say": "title.clone()으로 새 String을 만들어 넣어요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "원본은 러스트 입문 그대로예요. 사본에만 (사본)이 붙었어요.",
      "target": "output"
    }
  ]
}
