      ],
      "expect_error": "E0368"
    },
    {
      "action": "say",
      "text": "여전히 E0368이에요. 이번엔 &mut 참조 자체에서 1을 빼려 했거든요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    stock -= 1;\n",
      "after": "    *stock -= 1;\n",
      "say": "*stock으로 가리키는 재고에서 1을 빼요."
    },
    {
      "action": "run",
      "lines": [
