  "entry": [
    {
      "action": "say",
      "text": "stock을 copied에 넣은 뒤에도 두 이름을 다 쓸 수 있는지 볼 거예요.",
      "target": "text:출력 줄을 고쳐 stock과 copied를 한 줄에 함께 출력하세요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "stock: 5만 나왔어요. 아직 copied는 출력하지 않았거든요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "println!(\"stock: {stock}\");",
      "after": "println!(\"stock: {stock}, copied: {copied}\");",
      "say": "출력 줄에 copied 자리를 붙여요."
    },
    {
      "action": "run",
      "lines": [
        6,
        6
      ]
    },
    {
      "action": "say",
      "text": "stock: 5, copied: 5예요. 넣은 뒤에도 stock을 그대로 썼어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "정수는 복사돼서 원래 이름이 남아요. 다음 스텝의 String은 다르게 움직여요.",
      "target": "code:let copied = stock;"
    }
  ]
}
