  "entry": [
    {
      "action": "say",
      "text": "입력은 a.b예요. 점 앞뒤의 a와 b를 남겨야 해요.",
      "target": "problem"
    },
    {
      "action": "run",
      "say": "먼저 준비 코드의 결과를 확인해요."
    },
    {
      "action": "say",
      "text": "현재는 []가 나와요. 점이 임의의 문자라는 규칙으로 해석됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "text.split(\".\")",
      "after": "text.split(Pattern.quote(\".\"))",
      "say": "Pattern.quote로 점을 문자 그대로 해석해요."
    },
    {
      "action": "run",
      "say": "수정한 코드로 다시 실행해요."
    },
    {
      "action": "say",
      "text": "출력은 [a, b]예요. 입력과 결과를 연결해 보세요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 정규식의 점과 파일 이름에 적힌 점을 혼동하지 않아요.",
      "target": "output"
    },
    {
      "action": "submit"
    }
  ]
}
