{
  "by": "hand",
  "source_sha256": "35ba31bde6ca6ce3e02a54f4b4b26761e22ded1b9e1e5ecd6816738e540f49bd",
  "entry": [
    {
      "action": "say",
      "text": "입력 id=12로 두 줄을 출력해요. 첫 줄은 전체가 숫자인지, 둘째 줄은 숫자 부분이 있는지예요.",
      "target": "text:첫 줄에는 입력 전체가 숫자인지, 둘째 줄에는 숫자 부분이 있는지 출력해요."
    },
    {
      "action": "say",
      "text": "지금 두 줄 모두 전체가 숫자인지 검사해요.",
      "target": "code:boolean part = text.matches(\"[0-9]+\");"
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "false가 두 번 나와요. id=12 전체는 숫자가 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "boolean part = text.matches(\"[0-9]+\");",
      "after": "boolean part = Pattern.compile(\"[0-9]+\").matcher(text).find();",
      "say": "둘째 검사를 문자열 안에서 숫자 부분을 찾도록 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "false와 true예요. 전체는 숫자가 아니어도 숫자 부분은 있어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. find가 true여도 입력 전체의 형식이 맞다는 뜻은 아니에요.",
      "target": "code:boolean part = Pattern.compile(\"[0-9]+\").matcher(text).find();"
    }
  ]
}
