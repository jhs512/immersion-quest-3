{
  "by": "hand",
  "source_sha256": "a4cd8a9b073818e4eff29c47e0a85c275ea657786cbb2e8a5a1149ffd692b658",
  "entry": [
    {
      "action": "say",
      "text": "id 값이 숫자로만 이뤄졌는지 검사하려고 해요.",
      "target": "text:id에 숫자만 왔는지 검사해요."
    },
    {
      "action": "say",
      "text": "패턴은 숫자 한 글자가 한 번 이상 이어진다는 뜻이에요.",
      "target": "code:\"[0-9]+\""
    },
    {
      "action": "say",
      "text": "matches는 12 전체가 이 패턴에 맞는지 봐요.",
      "target": "code:\"12\".matches"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "true예요. 두 글자가 모두 숫자예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\"12\".matches",
      "after": "\"\".matches",
      "say": "빈 문자열로 바꿔 볼게요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "false예요. 한 번 이상이라는 조건 때문에 숫자가 하나도 없으면 맞지 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 별표 대신 더하기를 써야 빈 id를 숫자로 잘못 받아들이지 않아요.",
      "target": "text:뒤의 +는 그 글자가 한 번 이상 이어진다는 뜻이에요."
    },
    {
      "action": "choose_answer",
      "id": "answer"
    }
  ]
}
