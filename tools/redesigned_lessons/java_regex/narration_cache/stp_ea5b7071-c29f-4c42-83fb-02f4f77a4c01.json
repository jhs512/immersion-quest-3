{
  "by": "hand",
  "source_sha256": "a20a7b0855b9a8dc137820bb7cf4a86d948651688f66a6c3b241b170c89615ab",
  "entry": [
    {
      "action": "say",
      "text": "입력 id=2&text=hello에는 조건 두 개가 &로 이어져 있어요. split으로 나눠 조건 수를 돌려줘야 해요.",
      "target": "text:입력은 id=2&text=hello 같은 조건 묶음이에요."
    },
    {
      "action": "say",
      "text": "지금 배열에는 받은 문자열 전체가 한 칸에 들어가요.",
      "target": "code:String[] parts = {query};"
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "1이에요. 두 조건이 아직 하나로 묶여 있어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "String[] parts = {query};",
      "after": "String[] parts = query.split(\"&\");",
      "say": "&를 기준으로 나눈 배열을 만들어요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "2가 나와요. 두 조건이 서로 다른 칸에 들어갔어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 조건 수를 2로 고정하면 조건이 늘거나 줄 때 틀려요.",
      "target": "code:String[] parts = query.split(\"&\");"
    }
  ]
}
