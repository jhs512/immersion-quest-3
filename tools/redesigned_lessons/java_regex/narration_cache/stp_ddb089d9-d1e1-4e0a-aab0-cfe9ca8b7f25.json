  "by": "hand",
  "source_sha256": "c40498911bc3c1391d55a5966c784526974c42f7e2c0ac6a0e39f7491053d9d6",
  "entry": [
    {
      "action": "say",
      "text": "입력 update?id=2의 작업 이름은 물음표 앞의 update예요. 물음표에서 최대 두 조각으로 나눠야 해요.",
      "target": "text:입력 update?id=2의 작업 이름은 물음표 앞에 있어요."
    },
    {
      "action": "say",
      "text": "지금은 &를 찾아서 나누고 있어요.",
      "target": "code:query.split(\"&\", 2)"
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "update?id=2가 그대로 나와요. 물음표를 구분자로 쓰지 않았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "query.split(\"&\", 2)",
      "after": "query.split(\"\\\\?\", 2)",
      "say": "문자 물음표를 뜻하는 정규식으로 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        14,
        14
      ]
    },
    {
      "action": "say",
      "text": "update예요. 작업 이름과 조건이 갈라졌어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 물음표만 쓰면 정규식 반복 기호가 돼요. 문자 물음표는 이스케이프하세요.",
      "target": "code:query.split(\"\\\\?\", 2)"
    }
  ]
}
