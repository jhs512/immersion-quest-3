{
  "by": "hand",
  "source_sha256": "fb3f3e40eb77477294acd7f008249f43aa4b61fec58d2f0bbe6f0c34e089618d",
  "entry": [
    {
      "action": "say",
      "text": "입력 12처럼 전체가 숫자로만 이뤄지면 true예요. 빈 문자열, 부호, 다른 글자가 섞이면 false예요.",
      "target": "text:입력 전체가 0부터 9까지의 숫자로만 이뤄지면 true를 돌려주세요."
    },
    {
      "action": "say",
      "text": "지금 규칙은 숫자 한 글자만 허용해요.",
      "target": "code:text.matches(\"[0-9]\")"
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "false예요. 12는 숫자 두 글자라 지금 규칙과 맞지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "text.matches(\"[0-9]\")",
      "after": "text.matches(\"[0-9]+\")",
      "say": "+로 숫자가 한 번 이상 이어지게 해요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "true예요. 입력 전체가 숫자 반복에 맞아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. *는 0번 반복도 허용해요. 빈 문자열을 거절하려면 한 번 이상이어야 해요.",
      "target": "code:text.matches(\"[0-9]+\")"
    }
  ]
}
