{
  "by": "hand",
  "source_sha256": "8eb4b00c4c656493c958d74d699525e729495fa1071ccbeb4ecdb169bd3d6a4d",
  "entry": [
    {
      "action": "say",
      "text": "숫자 한 글자와 숫자로 이뤄진 문자열을 구분해요.",
      "target": "text:문자열 전체가 한 자리 이상 숫자인지 검사하세요"
    },
    {
      "action": "say",
      "text": "지금 규칙은 숫자 한 글자만 허용해요.",
      "target": "code:text.matches(\"[0-9]\")"
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "false예요. 12는 숫자 두 글자라 지금 규칙과 맞지 않아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "text.matches(\"[0-9]\")",
      "after": "text.matches(\"[0-9]+\")",
      "say": "+로 숫자가 한 번 이상 이어지게 해요."
    },
    {
      "action": "run",
      "lines": [
        13,
        13
      ]
    },
    {
      "action": "say",
      "text": "true예요. 입력 전체가 숫자 반복에 맞아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. *는 0번 반복도 허용해요. 빈 문자열을 거절하려면 한 번 이상이어야 해요.",
      "target": "code:text.matches(\"[0-9]+\")"
    }
  ]
}
