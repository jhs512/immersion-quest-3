  "entry": [
    {
      "action": "say",
      "text": "text= 처럼 키는 있고 값만 빈 경우예요.",
      "target": "text:이번에는 text 키가 있고 값만 비어 있어요."
    },
    {
      "action": "say",
      "text": "질문은 두 조각으로 나눴을 때 값 부분의 길이예요.",
      "target": "text:text=를 두 조각으로 나누면 값의 길이는 얼마일까요?"
    },
    {
      "action": "say",
      "text": "limit 2로 나누면 등호 뒤의 빈 문자열도 두 번째 칸에 남아요.",
      "target": "code:\"text=\".split(\"=\", 2)"
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "0이에요. 두 번째 칸이 있고 그 안이 빈 문자열이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\"text=\".split(\"=\", 2)",
      "after": "\"text=\".split(\"=\")",
      "say": "limit 없이 나누면 어떻게 될까요?"
    },
    {
      "action": "run",
      "expect_error": "ArrayIndexOutOfBoundsException"
    },
    {
      "action": "say",
      "text": "ArrayIndexOutOfBoundsException이에요. 기본 split은 끝의 빈 조각을 버려서 두 번째 칸이 없어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "answer"
    }
  ]
}
