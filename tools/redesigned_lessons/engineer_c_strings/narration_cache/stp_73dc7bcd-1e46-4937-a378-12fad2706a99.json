{
  "by": "hand",
  "source_sha256": "f7c8a68b2e297b3ab3ad4e11d6c38720a09946c57c7eef70769a99ab7de601f2",
  "entry": [
    {
      "action": "say",
      "text": "번호 길이가 달라도 WH- 뒤를 끝까지 출력해야 해요.",
      "target": "text:printf 한 줄을 고쳐 WH- 뒤의 번호 전체를 출력하세요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "2만 나왔어요. %c는 *(p + 3), 곧 3번 칸 글자 하나만 찍어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "printf(\"%c\", *(p + 3));",
      "after": "printf(\"%s\", p + 3);",
      "say": "%s에는 * 없이 주소 p + 3을 넘겨요."
    },
    {
      "action": "run",
      "lines": [
        7,
        7
      ]
    },
    {
      "action": "say",
      "text": "2048이 나왔어요. %s는 3번 칸부터 끝 표시 앞까지 이어서 찍어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. %s에 *(p + 3)을 넘기면 주소가 아니라 글자를 넘긴 거예요. %s에는 * 없는 주소를 줘요.",
      "target": "code:p + 3"
    }
  ]
}
