  "entry": [
    {
      "action": "say",
      "text": "D가 A에서 몇 칸 떨어졌는지 숫자로 구하는 문제예요.",
      "target": "text:printf의 식을 고쳐 grade가 'A'에서 몇 칸 떨어졌는지 출력하세요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "68이 나왔어요. %d로 찍으면 글자 대신 그 글자의 코드가 보여요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "printf(\"%d\", grade);",
      "after": "printf(\"%d\", grade - 'a');",
      "say": "기준 글자를 빼 볼게요. 먼저 소문자 a로 해 봐요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "-29가 나왔어요. 소문자 a의 코드 97이 대문자 D보다 커요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "grade - 'a'",
      "after": "grade - 'A'",
      "say": "기준을 대문자 A로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        5,
        5
      ]
    },
    {
      "action": "say",
      "text": "3이 나왔어요. 68에서 A의 코드 65를 뺀 차이예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 대문자와 소문자는 코드가 달라요. 같은 종류의 기준 글자를 빼야 해요.",
      "target": "code:'A'"
    }
  ]
}
