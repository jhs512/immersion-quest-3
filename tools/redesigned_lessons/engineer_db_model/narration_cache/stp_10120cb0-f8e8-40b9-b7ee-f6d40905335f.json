{
  "by": "hand",
  "source_sha256": "86c3af5f9b098e78aa28b1a96edb513653648e74bd694ee3e54c9fad8ce5b7f0",
  "entry": [
    {
      "action": "say",
      "text": "이름과 ID 가운데 지금 자료에서 겹치지 않는 열을 찾는 문제예요.",
      "target": "text:지금 세 물건을 각각 구별하는 열은 무엇일까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "ID는 세 값이고 모든 물건을 구별해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "DISTINCT id",
      "after": "DISTINCT name",
      "say": "DISTINCT의 대상을 name으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "이름 pen이 겹쳐 서로 다른 이름은 두 개뿐이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 지금 표에서 유일해 보인다는 것만으로 모든 미래 데이터의 키가 보장되지는 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "키는 업무 규칙과 제약으로 정해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "DISTINCT name",
      "after": "DISTINCT id",
      "say": "DISTINCT id로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 SQL은 서로 다른 ID 세 개로 세 물건을 구별해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "id"
    }
  ]
}
