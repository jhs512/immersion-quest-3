{
  "by": "hand",
  "source_sha256": "e454cce9458555c54068edb1d7db482cdde83ed48faf3eaadeaff64b8716fc33",
  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 기본 키·NOT NULL·외래 키를 각각 실제 잘못된 삽입으로 검증해요.",
      "target": "text:기본 키·NOT NULL·외래 키를 각각 실제 잘못된 삽입으로 검증해요."
    },
    {
      "action": "run",
      "lines": [
        26,
        28
      ]
    },
    {
      "action": "say",
      "text": "아직 제약이 없어 세 잘못된 삽입을 모두 허용해 False가 세 번 나와요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\n    id INTEGER,",
      "after": "\n    id INTEGER PRIMARY KEY,",
      "say": "schema의 id에 PRIMARY KEY를 선언하세요."
    },
    {
      "action": "run",
      "lines": [
        26,
        28
      ]
    },
    {
      "action": "say",
      "text": "기본 키를 추가해 중복 ID만 거절해요. NULL 수량과 없는 물건 참조도 막아야 해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "item_id INTEGER,",
      "after": "item_id INTEGER REFERENCES items(id),",
      "say": "item_id가 items의 id를 참조하게 하세요."
    },
    {
      "action": "patch_code",
      "before": "qty INTEGER\n",
      "after": "qty INTEGER NOT NULL\n",
      "say": "qty에 NOT NULL을 선언하세요."
    },
    {
      "action": "run",
      "lines": [
        26,
        28
      ]
    },
    {
      "action": "say",
      "text": "중복 ID·NULL 수량·없는 물건 참조가 모두 실제 DB에서 거절됐어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NOT NULL은 값의 존재를 검사하고 외래 키는 참조 대상의 존재를 검사해요.",
      "target": "code:qty INTEGER NOT NULL"
    }
  ]
}
