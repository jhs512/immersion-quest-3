  "entry": [
    {
      "action": "say",
      "text": "값을 모르는 칸이 있어도 행이 사라지지 않는다는 점을 행 수로 확인하는 문제예요.",
      "target": "text:재고가 NULL인 물건의 행은 어떻게 될까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "전체 행은 세 개예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(*)",
      "after": "COUNT(stock)",
      "say": "COUNT(*)를 COUNT(stock)으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "재고 값이 있는 행만 세면 두 개예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NULL은 모르는 값의 표시이고 행이 없다는 뜻은 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "COUNT(stock)",
      "after": "COUNT(*)",
      "say": "COUNT(*)로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 SQL은 NULL인 행도 세서 3이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "rows"
    }
  ]
}
