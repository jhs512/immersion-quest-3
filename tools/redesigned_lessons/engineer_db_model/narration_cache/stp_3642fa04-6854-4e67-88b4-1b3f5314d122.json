{
  "by": "hand",
  "source_sha256": "f43ae82b782d9740ce60c9ae75242c05580cdf33113e3dffd7e1357bbd01ecce",
  "entry": [
    {
      "action": "say",
      "text": "book의 재고는 NULL이에요. 재고를 아는 수 옆에 전체 행 수도 세어야 해요.",
      "target": "text:질의에 열을 더해 재고를 아는 물건 수 옆에 전체 행 수도 보이세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "2예요. 재고 값이 있는 두 행만 세었어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "AS known FROM",
      "after": "AS known, COUNT(*) AS rows FROM",
      "say": "COUNT(*) AS rows 열을 더해요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "2와 3이에요. 재고를 모르는 book도 행으로는 있어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NULL은 「값을 모른다」는 표시예요. 행이 없다는 뜻이 아니에요.",
      "target": "code:COUNT(*) AS rows"
    }
  ]
}
