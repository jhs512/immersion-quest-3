{
  "by": "hand",
  "source_sha256": "92aa38deaa4f058d3343537a5141d6e6a2c7c4cd00fd16fe38681db4a3c9e12e",
  "entry": [
    {
      "action": "say",
      "text": "두 열을 묶은 키에서 무엇이 겹치면 거절되는지 판단하는 문제예요.",
      "target": "text:이 INSERT는 어떻게 될까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ],
      "expect_error": "UNIQUE constraint failed"
    },
    {
      "action": "say",
      "text": "같은 물건과 같은 로트 번호의 쌍이 이미 있어서 거절했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "VALUES(1,1)",
      "after": "VALUES(1,3)",
      "say": "로트 번호를 3으로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ]
    },
    {
      "action": "say",
      "text": "같은 물건이라도 새 로트 3이면 네 번째 행을 만들어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 복합 키는 묶음이 유일해야 해요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "각 열을 따로 모두 유일하게 만드는 뜻은 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "VALUES(1,3)",
      "after": "VALUES(1,1)",
      "say": "로트 1로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ],
      "expect_error": "UNIQUE constraint failed"
    },
    {
      "action": "say",
      "text": "처음 SQL은 물건 1·로트 1 쌍이 이미 있어 거절돼요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "pair"
    }
  ]
}
