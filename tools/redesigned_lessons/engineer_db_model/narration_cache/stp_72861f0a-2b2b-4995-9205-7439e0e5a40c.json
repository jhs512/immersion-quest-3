  "entry": [
    {
      "action": "say",
      "text": "name에 NOT NULL을 선언해야 해요. 그러면 이름 없는 물건을 DB가 거절해요.",
      "target": "text:schema 문자열의 name에 NOT NULL을 선언하세요."
    },
    {
      "action": "run",
      "lines": [
        28,
        29
      ]
    },
    {
      "action": "say",
      "text": "False와 False예요. 이름이 NULL이어도 받아들였어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "\n    name TEXT,",
      "after": "\n    name TEXT NOT NULL,",
      "say": "name TEXT 뒤에 NOT NULL을 써요."
    },
    {
      "action": "run",
      "lines": [
        28,
        29
      ]
    },
    {
      "action": "say",
      "text": "True와 False예요. 이름 없는 물건만 거절했어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NOT NULL은 빈 글자 ''를 막지 않아요. ''는 NULL이 아니라 길이 0인 값이에요.",
      "target": "code:name TEXT NOT NULL"
    }
  ]
}
