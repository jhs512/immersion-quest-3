{
  "by": "hand",
  "source_sha256": "c30e9075e8d9c52f613376c4c4f71cb842cc504be3286243601982888c75873a",
  "entry": [
    {
      "action": "say",
      "text": "반드시 있어야 하는 열에 NULL을 넣을 때를 판단하는 문제예요.",
      "target": "text:이 INSERT는 어떻게 될까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ],
      "expect_error": "NOT NULL constraint failed"
    },
    {
      "action": "say",
      "text": "이름이 빠져 실제 NOT NULL 제약에서 거절했어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "VALUES(4,NULL,1)",
      "after": "VALUES(4,'bag',1)",
      "say": "이름 bag을 넣어 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ]
    },
    {
      "action": "say",
      "text": "이름 bag을 주면 네 번째 물건이 들어가요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 빈 글자와 NULL은 달라요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "이름에 빈 글자도 금지할지는 추가 업무 규칙이에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "VALUES(4,'bag',1)",
      "after": "VALUES(4,'bag',-1)",
      "say": "이름은 두고 재고를 -1로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ],
      "expect_error": "CHECK constraint failed"
    },
    {
      "action": "say",
      "text": "CHECK(stock>=0) 제약이 음수 재고를 거절했어요. NOT NULL과 다른 줄의 규칙이에요.",
      "target": "code:INSERT INTO items"
    },
    {
      "action": "patch_code",
      "before": "VALUES(4,'bag',-1)",
      "after": "VALUES(4,NULL,1)",
      "say": "이름 없는 처음 SQL로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        2
      ],
      "expect_error": "NOT NULL constraint failed"
    },
    {
      "action": "say",
      "text": "처음 SQL은 이름이 NULL이라 NOT NULL 제약이 거절해요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "missing"
    }
  ]
}
