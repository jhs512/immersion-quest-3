  "entry": [
    {
      "action": "say",
      "text": "DISTINCT가 원본이 아니라 결과의 중복만 줄인다는 점을 보는 문제예요.",
      "target": "text:결과는 어떻게 될까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "선택한 분류 값의 중복만 결과에서 없앴어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "SELECT DISTINCT category",
      "after": "SELECT category",
      "say": "DISTINCT를 빼 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "DISTINCT를 빼면 네 행의 분류가 각각 나와요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 조회 결과의 중복 제거는 원본 행 삭제가 아니에요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "SELECT category",
      "after": "SELECT DISTINCT category",
      "say": "DISTINCT로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 조회는 분류 A와 B를 한 번씩만 보여 줘요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "distinct"
    }
  ]
}
