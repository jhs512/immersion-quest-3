{
  "by": "hand",
  "source_sha256": "097ed90a61d92764c766178879f1d1cc809b27f39ada9b176b6fa66bd7e4abdb",
  "entry": [
    {
      "action": "say",
      "text": "name = 'b'는 이름이 정확히 b인 행만 찾아요. LIKE 무늬로 b로 시작하는 이름을 골라야 해요.",
      "target": "text:조건을 고쳐 이름이 b로 시작하는 물건을 고르세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "행 없음이에요. 이름이 b 한 글자인 물건은 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "name = 'b'",
      "after": "name LIKE 'b%'",
      "say": "= 'b'를 LIKE 'b%'로 고쳐요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "2와 3이에요. b로 시작하는 book과 bag이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. '%b%'는 b가 어디에 있든 남겨서 시작 글자 조건이 아니에요.",
      "target": "code:LIKE 'b%'"
    }
  ]
}
