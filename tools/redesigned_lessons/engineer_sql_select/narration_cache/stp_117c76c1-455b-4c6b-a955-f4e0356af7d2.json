    {
      "action": "say",
      "text": "재고가 양수이면서 분류가 A 또는 B여야 해요. OR 쪽을 괄호로 묶어야 해요.",
      "target": "text:괄호를 더해 category = 'A' OR category = 'B'를 먼저 묶으세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "1, 2, 3, 4가 모두 나와요. 재고를 모르는 2와 재고 0인 4도 B라서 남았어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "AND category = 'A' OR category = 'B'",
      "after": "AND (category = 'A' OR category = 'B')",
      "say": "OR로 이은 두 분류 조건을 괄호로 묶어요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "1과 3이에요. 이제 모든 행에서 재고 양수 조건이 필요해요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 괄호가 없으면 AND가 OR보다 먼저 묶여요.",
      "target": "code:(category = 'A' OR category = 'B')"
    }
  ]
}
