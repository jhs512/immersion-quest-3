{
  "by": "hand",
  "source_sha256": "0cd302a3ee52ebc28dcfae3b636c46e4919946968619ca97b281b2e4bbe363cf",
  "entry": [
    {
      "action": "say",
      "text": "무늬 기호 %가 어디에 있는지로 남는 이름을 고르는 문제예요.",
      "target": "text:어떤 이름이 남을까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "b로 시작하는 두 이름이 남아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "LIKE 'b%'",
      "after": "LIKE '%o%'",
      "say": "무늬를 '%o%'로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "o가 들어 있는 이름을 고르면 book만 남아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 퍼센트는 길이가 다양한 글자들을 나타내요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "한 글자는 밑줄 기호와 구별해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "LIKE '%o%'",
      "after": "LIKE 'b%'",
      "say": "'b%'로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 조건은 b로 시작하는 book과 bag이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "start"
    }
  ]
}
