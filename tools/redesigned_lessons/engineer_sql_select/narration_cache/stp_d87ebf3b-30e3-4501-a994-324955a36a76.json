  "source_sha256": "06e89d88c5407f6b135b2084d6cf5f0a53589254edbb4078b72427d71ffa86e5",
  "entry": [
    {
      "action": "say",
      "text": "SELECT는 보여 줄 열, WHERE는 남길 행이에요. 재고가 0보다 큰 행만 남겨야 해요.",
      "target": "text:FROM items 뒤에 WHERE를 더해 재고가 0보다 큰 물건만 남기세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "1부터 4까지 모두 나와요. 아직 조건이 없어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "FROM items ORDER BY",
      "after": "FROM items WHERE stock > 0 ORDER BY",
      "say": "FROM items 뒤에 WHERE stock > 0을 써요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "1과 3이에요. 재고 2와 5인 행만 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. stock >= 0이면 재고 0인 ID 4도 남아요. NULL인 ID 2는 어느 쪽에서도 남지 않아요.",
      "target": "code:stock > 0"
    }
  ]
}
