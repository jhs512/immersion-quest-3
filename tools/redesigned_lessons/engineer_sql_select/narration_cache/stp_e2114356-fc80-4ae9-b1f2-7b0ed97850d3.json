  "entry": [
    {
      "action": "say",
      "text": "WHERE가 행을 고르고 SELECT가 열을 고른다는 점으로 결과를 고르는 문제예요.",
      "target": "text:어떤 물건이 나올까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "양수 재고 이와 오인 두 행을 골랐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock > 0",
      "after": "stock >= 0",
      "say": "0도 포함하도록 >=로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "영도 포함하도록 바꾸면 ID사도 남아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NULL은 영이 아니에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "비교 결과가 참인 행만 남아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock >= 0",
      "after": "stock > 0",
      "say": "> 0으로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 조건은 0보다 큰 2와 5만 남겨 ID 1과 3이에요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "positive"
    }
  ]
}
