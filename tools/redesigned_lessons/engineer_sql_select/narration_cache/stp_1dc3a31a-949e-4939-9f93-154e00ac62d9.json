{
  "by": "hand",
  "source_sha256": "fa37bf43dfa8b59a5195243438691b43d6c43071eacd88f40b56015b054dffcf",
  "entry": [
    {
      "action": "say",
      "text": "NULL을 찾는 비교와 0을 찾는 비교를 구별하는 문제예요.",
      "target": "text:이 조회는 어떤 물건을 찾을까요?"
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "IS NULL은 재고가 비어 있는 행을 찾아요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock IS NULL",
      "after": "stock = NULL",
      "say": "IS NULL을 등호 = NULL로 바꿔 볼게요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "등호와 NULL의 비교는 참이 되지 않아 아무 행도 남지 않아요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NULL 비교에는 IS NULL이나 IS NOT NULL을 사용해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "stock = NULL",
      "after": "stock IS NULL",
      "say": "IS NULL로 되돌려요."
    },
    {
      "action": "run",
      "lines": [
        1,
        1
      ]
    },
    {
      "action": "say",
      "text": "처음 조건은 NULL인 book, ID 2를 찾아요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "unknown"
    }
  ]
}
