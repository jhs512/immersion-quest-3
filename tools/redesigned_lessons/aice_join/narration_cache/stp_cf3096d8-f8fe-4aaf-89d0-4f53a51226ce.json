      "action": "run",
      "lines": [
        10,
        11
      ]
    },
    {
      "action": "say",
      "text": "[101, 102]와 [0, 1]이에요. merge는 첫 달 행에 맞는 키를 찾았을 뿐 103을 붙이지 않았어요.",
      "target": "output"
