    {
      "action": "patch_code",
      "before": "combined = first.merge(second, on=\"order_id\", how=\"left\")",
      "after": "combined = pd.concat([first, second], ignore_index=True)",
      "say": "pd.concat([first, second], ignore_index=True)로 바꿔요."
    },
