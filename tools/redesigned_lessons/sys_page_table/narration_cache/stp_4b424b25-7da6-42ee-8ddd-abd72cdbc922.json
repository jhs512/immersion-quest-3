  "entry": [
    {
      "action": "say",
      "text": "표의 1번 페이지만 연결돼 있어요. VALUE가 그 밖을 가리키면 폴트라고 출력하세요.",
      "target": "text:표의 1번 페이지만 연결돼 있어요. VALUE가 그 밖을 가리키면 폴트라고 출력하세요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "지금 출력은 프레임 -1예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "frame == 0 부분에서 요구한 관계를 계산하고 있는지 봐요.",
      "target": "code:frame == 0"
    },
    {
      "action": "patch_code",
      "before": "frame == 0",
      "after": "frame == -1",
      "say": "frame == -1로 바꿔 비교해요."
    },
    {
      "action": "run"
    },
    {
      "action": "say",
      "text": "미연결 표시는 프레임 번호와 구분해요. 다음 문제에서는 프로세스마다 다른 표도 함께 다뤄요.",
      "target": "output"
    },
    {
      "action": "submit"
    }
  ]
}
