{
  "by": "hand",
  "source_sha256": "f3eb4a836081e3ca6e434a12c0493d64dbe34816c58367d855502ec16999e745",
  "entry": [
    {
      "action": "say",
      "text": "한 문장으로 두 열을 고치는 문제예요. 3번 책만 바뀌어야 해요.",
      "target": "text:SET 부분을 고쳐 3번 책의 author는 Lim, copies는 4가 되게 하세요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "3번 행이 3 | 0 | 1이 됐어요. 오류는 없는데 author가 0이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "SQLite는 'Lim' AND copies = 4를 참·거짓 식 하나로 계산했어요. 그 값 0이 author에 들어갔죠.",
      "target": "code:'Lim' AND copies = 4"
    },
    {
      "action": "patch_code",
      "before": "'Lim' AND copies",
      "after": "'Lim', copies",
      "say": "AND를 쉼표로 바꿔 두 대입을 나눠요."
    },
    {
      "action": "run",
      "lines": [
        2,
        2
      ]
    },
    {
      "action": "say",
      "text": "3 | Lim | 4가 됐어요. 1번과 2번 책은 그대로예요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. WHERE id = 3을 빠뜨리면 세 책이 모두 Lim, 4로 바뀌어요.",
      "target": "code:WHERE id = 3"
    }
  ]
}
