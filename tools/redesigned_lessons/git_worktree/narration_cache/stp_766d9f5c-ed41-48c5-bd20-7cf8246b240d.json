{
  "by": "hand",
  "source_sha256": "4958211d5cd63f8d588ef2efa2bb6d8259f3a13ebc777ba305e1ca6c334677ea",
  "entry": [
    {
      "action": "say",
      "text": "쓰던 검색 안내를 지키면서 hotfix에 한 줄을 커밋하고, 폴더까지 정리해요.",
      "target": "text:일이 끝나면 꺼낸 폴더를 정리해서 work만 남겨요."
    },
    {
      "action": "git_command",
      "args": [
        "worktree",
        "add",
        "../hotfix",
        "hotfix"
      ],
      "say": "브랜치를 바꾸는 대신 hotfix를 옆 폴더에 꺼내요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "HEAD가 지수의 긴급 창구 안내 커밋에 있어요. hotfix 폴더가 생겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../hotfix",
      "say": "그 폴더로 가요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "이제 명령이 hotfix 폴더에서 실행돼요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "echo \"운영: 평일 9시부터\" >> guide.txt",
      "say": "안내 끝에 운영 시간을 더해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력은 없어요. hotfix 폴더의 안내만 바뀌었어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "add",
        "guide.txt"
      ],
      "say": "바꾼 안내를 담아요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 준비 영역에 담겼어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "commit",
        "-m",
        "운영 시간 안내"
      ],
      "say": "hotfix에 커밋해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "[hotfix로 시작하는 줄이 나와요. 커밋이 hotfix에 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "bash_command",
      "command": "cd ../work",
      "say": "work로 돌아와요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "다시 main이 있는 work 폴더예요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "log",
        "--oneline",
        "hotfix"
      ],
      "say": "hotfix의 기록을 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "운영 시간 안내가 맨 위에 있어요. 같은 저장소라 여기서도 보여요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "worktree",
        "remove",
        "../hotfix"
      ],
      "say": "다 쓴 폴더를 정리해요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "출력 없이 폴더와 그 기록이 함께 지워졌어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "worktree",
        "list"
      ],
      "say": "남은 폴더를 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "work 한 줄만 남았어요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "git_command",
      "args": [
        "status"
      ],
      "say": "마지막으로 main의 상태를 봐요.",
      "target": "#git-demo-terminal"
    },
    {
      "action": "say",
      "text": "guide.txt는 수정된 그대로예요. 검색 안내를 지키면서 hotfix를 마쳤어요.",
      "target": "text:쓰던 검색 안내는 그대로 두세요."
    }
  ]
}
