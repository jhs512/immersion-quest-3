      "lines": [
        11,
        11
      ]
    },
    {
      "action": "say",
      "text": "p는 칠을 읽지만 원래 stock은 이예요.",
      "target": "output",
      "diagram": {
        "title": "가리키는 곳만 변경",
        "rows": [
          "stock → 2",
          "p → other → 7"
