      "diagram": {
        "title": "처음 대상으로 복귀",
        "rows": [
          "p → stock → 2",
          "other → 7"
        ]
      }
    },
    {
      "action": "say",
      "text": "조심하세요. p를 바꾸는 것과 *p를 바꾸는 것은 달라요.",
