{
  "by": "hand",
  "source_sha256": "ec697dc6e82f19810ad1ba765000debaea4a161d9843954ad77f1f57a854d8df",
  "entry": [
    {
      "action": "say",
      "text": "포인터를 함수에 넘겨도 주소 값이 복사돼요. 함수 안에서 p를 다른 곳으로 옮겨도 main의 p가 옮겨지는지가 질문이에요.",
      "target": "text:함수에서 p = other를 했어요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "main의 포인터는 그대로라 이를 읽어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "redirect(p, &other);",
      "after": "p = &other;",
      "say": "main의 포인터에 직접 다른 주소를 넣어요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "이번에는 main의 대상도 바뀌어 칠이에요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 포인터 인수도 값이 복사돼요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "p = &other;\n    printf",
      "after": "redirect(p, &other);\n    printf",
      "say": "처음처럼 함수 안의 복사본만 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        15,
        15
      ]
    },
    {
      "action": "say",
      "text": "main이 가진 주소는 처음 그대로예요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "caller"
    }
  ]
}
