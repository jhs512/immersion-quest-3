  "entry": [
    {
      "action": "say",
      "text": "지금 줄은 stock에 other의 값을 써요. p가 가리키는 곳만 other로 옮기게 고쳐야 해요.",
      "target": "text:*p = other; 줄을 고쳐 stock은 그대로 두고 p가 other를 가리키게 하세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "7과 7이에요. *p = other가 stock을 7로 덮어썼어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    *p = other;\n",
      "after": "    p = &other;\n",
      "say": "별표를 빼고 p에 other의 주소를 담아요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "7과 2예요. p는 other를 가리키고 stock은 2로 남았어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. *p = ...는 가리키는 값을 바꾸고, p = ...는 가리키는 곳을 바꿔요.",
      "target": "code:p = &other;"
    }
  ]
}
