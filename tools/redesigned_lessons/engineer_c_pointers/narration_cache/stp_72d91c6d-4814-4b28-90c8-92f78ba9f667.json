  "entry": [
    {
      "action": "say",
      "text": "마지막 도전이에요. 주소 복사와 역참조 쓰기를 구별해 호출자의 두 값을 바꿔요.",
      "target": "text:주소 복사와 역참조 쓰기를 구별해 호출자의 두 값을 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "주소 복사만 한 뒤 right를 덮어써 두 값이 3 3이 됐어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "a = b;",
      "after": "*a = *b;",
      "say": "지역 포인터 a를 옮기지 말고 a가 가리킨 정수에 b의 값을 쓰세요."
    },
    {
      "action": "run",
      "lines": [
        10,
        10
      ]
    },
    {
      "action": "say",
      "text": "호출자의 left와 right에 각각 8과 3을 썼어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. 임시 저장 없이 첫 값을 덮어쓰면 두 번째에 돌려줄 값이 사라져요.",
      "target": "code:*a = *b;"
    }
  ]
}
