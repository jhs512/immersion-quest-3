  "entry": [
    {
      "action": "say",
      "text": "p는 배열의 첫 원소를 가리켜요. 한 칸 뒤의 값을 *(p + 1)로 읽어야 해요.",
      "target": "text:next 줄을 고쳐 p에서 한 칸 뒤의 값을 포인터 덧셈으로 읽으세요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "2예요. *p는 첫 원소예요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "    int next = *p;\n",
      "after": "    int next = *(p + 1);\n",
      "say": "p에 1을 더한 주소의 값을 읽어요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "5예요. p + 1은 바로 다음 원소를 가리켜요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. *p + 1은 첫 원소에 1을 더한 3이에요. 괄호가 위치를 정해요.",
      "target": "code:int next = *(p + 1);"
    }
  ]
}
