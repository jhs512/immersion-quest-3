  "entry": [
    {
      "action": "say",
      "text": "NULL은 가리키는 대상이 없다는 표시라서 *p로 읽으면 안 돼요. 읽기 전에 무엇을 확인하는 경로가 안전한지 고르는 문제예요.",
      "target": "text:지금은 p가 가리킬 대상이 없어요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "대상이 없어 앞의 조건에서 영을 돌려줬어요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int *p = NULL;",
      "after": "int *p = &stock;",
      "say": "실제 재고의 주소가 있는 경우도 봐요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "유효한 대상이 있어 재고 이를 읽었어요.",
      "target": "output"
    },
    {
      "action": "say",
      "text": "조심하세요. NULL은 값이 0인 변수의 주소와 달라요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "int *p = &stock;",
      "after": "int *p = NULL;",
      "say": "대상이 없는 처음 상태로 돌아와요."
    },
    {
      "action": "run",
      "lines": [
        16,
        16
      ]
    },
    {
      "action": "say",
      "text": "대상을 읽기 전에 조건을 확인했어요.",
      "target": "output"
    },
    {
      "action": "choose_answer",
      "id": "guard"
    }
  ]
}
