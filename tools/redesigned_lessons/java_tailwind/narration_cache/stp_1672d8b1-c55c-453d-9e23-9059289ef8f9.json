{
  "by": "hand",
  "source_sha256": "47a6b4f339f1b9c9209a1f2bb446ce3514a1722c8134dada1c248a160272f04a",
  "entry": [
    {
      "action": "say",
      "text": "좌우 여백만 16px로 늘리고, 위아래 8px은 그대로 둬야 해요.",
      "target": "text:버튼의 좌우 안쪽 여백만 16px로 늘리세요."
    },
    {
      "action": "say",
      "text": "px-2는 좌우 8px, py-2는 위아래 8px이에요.",
      "target": "code:px-2 py-2"
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "web_action",
      "do": "read",
      "selector": "#add",
      "style": "paddingLeft",
      "say": "왼쪽 안쪽 여백을 읽어요."
    },
    {
      "action": "say",
      "text": "8px이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "px-2",
      "after": "px-4",
      "say": "좌우만 맡는 px를 px-4로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "web_action",
      "do": "read",
      "selector": "#add",
      "style": "paddingLeft",
      "say": "왼쪽 여백을 다시 읽어요."
    },
    {
      "action": "say",
      "text": "16px이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "web_action",
      "do": "read",
      "selector": "#add",
      "style": "paddingTop",
      "say": "위쪽 여백도 읽어요."
    },
    {
      "action": "say",
      "text": "위쪽은 여전히 8px이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "say",
      "text": "조심하세요. p-4로 바꾸면 좌우뿐 아니라 위아래도 16px가 돼요. 채점은 네 방향을 모두 확인해요.",
      "target": "text:위아래 여백 8px은 그대로 둬야 해요."
    }
  ]
}
