{
  "by": "hand",
  "source_sha256": "511390334eeac97d8693e6b7ce631c34d45c6ce602d9edbc5489e5a63e82f43c",
  "entry": [
    {
      "action": "say",
      "text": "새 준비 코드의 목록은 기본 한 열이에요. 넓이 조건이 거꾸로 걸려 좁을 때 두 열이 돼요.",
      "target": "text:새 준비 코드의 목록은 기본 한 열이에요. 넓이 조건이 거꾸로 걸려 좁을 때 두 열이 돼요."
    },
    {
      "action": "say",
      "text": "미디어 조건이 max-width: 768px로 걸려 있어요.",
      "target": "code:max-width: 768px"
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "현재 조건은 화면이 768px 이하일 때 두 열을 적용해요.",
      "target": "output"
    },
    {
      "action": "patch_code",
      "before": "max-width: 768px",
      "after": "min-width: 768px",
      "say": "기본 한 열을 두고 넓을 때만 두 열을 덮어써요."
    },
    {
      "action": "run",
      "lines": [
        9,
        9
      ]
    },
    {
      "action": "say",
      "text": "360px에서는 한 열, 900px에서는 두 열이에요.",
      "target": "output"
    },
    {
      "action": "web_action",
      "do": "width",
      "selector": ".cards",
      "value": "360",
      "style": "gridTemplateColumns",
      "say": "먼저 화면 폭을 360px로 줄여 열 너비를 읽어요."
    },
    {
      "action": "say",
      "text": "한 열의 너비 320px이 보여요. 아직 넓은 화면 조건 전이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "web_action",
      "do": "width",
      "selector": ".cards",
      "value": "900",
      "style": "gridTemplateColumns",
      "say": "이번에는 폭을 900px로 넓혀요."
    },
    {
      "action": "say",
      "text": "152px 두 칸이 보여요. 넓은 화면 조건이 두 열을 만들었어요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    }
  ]
}
