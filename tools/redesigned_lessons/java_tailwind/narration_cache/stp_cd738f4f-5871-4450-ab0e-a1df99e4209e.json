{
  "by": "hand",
  "source_sha256": "1a628c16686dca0b621949b47f67288be930575983d9a0ab2e5f1cb977a1a97d",
  "entry": [
    {
      "action": "say",
      "text": "class에 적은 이름이 그 요소의 모양을 정해요. 제목을 굵게 만드는 게 목표예요.",
      "target": "text:제목이 굵게 보이도록 고치세요."
    },
    {
      "action": "say",
      "text": "지금 제목의 굵기 클래스는 보통 굵기예요.",
      "target": "code:font-normal"
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "web_action",
      "do": "read",
      "selector": "h1",
      "style": "fontWeight",
      "say": "해설 화면에서 제목의 실제 굵기 값을 읽어 볼게요."
    },
    {
      "action": "say",
      "text": "굵기 값은 400, 보통이에요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "patch_code",
      "before": "font-normal",
      "after": "font-bold",
      "say": "굵게 보이는 font-bold로 바꿔요."
    },
    {
      "action": "run",
      "lines": [
        8,
        8
      ]
    },
    {
      "action": "web_action",
      "do": "read",
      "selector": "h1",
      "style": "fontWeight",
      "say": "다시 굵기 값을 읽어요."
    },
    {
      "action": "say",
      "text": "700이에요. 같은 글이 굵게 보여요. 채점도 이 굵기 값을 확인해요.",
      "target": "iframe[title=\"해설 웹 미리보기\"]"
    },
    {
      "action": "say",
      "text": "조심하세요. 굵게 하려고 제목 글자를 바꾸거나 태그를 바꾸면 내용이 달라져요. 바꿀 것은 class 하나예요.",
      "target": "code:<h1 class=\"font-bold\">글 목록</h1>"
    }
  ]
}
