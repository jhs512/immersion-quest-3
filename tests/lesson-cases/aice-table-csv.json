    {
      "step": 9,
      "replacements": [
        [
          "print(df.shape)",
          "print((5, 3))"
        ]
      ],
      "reason": "A fixed size fails other files"
    },
    {
      "step": 9,
      "replacements": [
        [
          "small = df[[\"order_id\", \"minutes\"]]",
          "small = df[[\"minutes\"]]"
