{
  "course": "tests/fixtures/player-pilot/q/course.json",
  "lesson": "courses/redesigned/aice-table-csv.json",
  "only_last": true,
  "expected_outputs": [
    [
      "(2, 3)\n   order_id  minutes region\n0       101       12     서울\n1       102       18     부산",
      "(5, 3)\n   order_id  minutes\n0       101       12\n1       102       18"
